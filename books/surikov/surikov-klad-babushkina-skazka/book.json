{"id":"surikov-klad-babushkina-skazka","slug":"surikov-klad-babushkina-skazka","title":"Клад (Бабушкина сказка)","altTitles":[],"author":"Иван Захарович Суриков","authorShort":"И. З. Суриков","authorSlug":"surikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1877","editionYear":"1877","description":"КЛАД","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9A%D0%BB%D0%B0%D0%B4_%28%D0%A1%D1%83%D1%80%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1877)","downloadAllowed":true,"fb2Url":"/archive/books/surikov/surikov-klad-babushkina-skazka/original.fb2","coverUrl":"/archive/books/surikov/surikov-klad-babushkina-skazka/cover.webp","stats":{"chaptersCount":6,"wordsCount":1035,"charsCount":5903,"readingMinutes":6},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"КЛАД"},{"type":"paragraph","text":"(Бабушкина сказка)"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"На краю селенья"},{"type":"paragraph","text":"Хатка пошатнулась;"},{"type":"paragraph","text":"К хатке дружелюбно"},{"type":"paragraph","text":"Ивушка нагнулась."},{"type":"paragraph","text":"Темными ветвями"},{"type":"paragraph","text":"Хатку приукрыла,"},{"type":"paragraph","text":"Чтобы жарким летом"},{"type":"paragraph","text":"Ей прохладно было."},{"type":"paragraph","text":"В хатке одиноко"},{"type":"paragraph","text":"Век свой доживает"},{"type":"paragraph","text":"Бабушка Маланья, —"},{"type":"paragraph","text":"Кто ее не знает!"},{"type":"paragraph","text":"Здесь по всей сторонке,"},{"type":"paragraph","text":"В каждой деревушке,"},{"type":"paragraph","text":"С деда до ребенка"},{"type":"paragraph","text":"Знают о старушке."},{"type":"paragraph","text":"Хворь кого прихватит, —"},{"type":"paragraph","text":"А пора-то — страда, —"},{"type":"paragraph","text":"В поле люд рабочий"},{"type":"paragraph","text":"В это время надо."},{"type":"paragraph","text":"Ну, а как больного"},{"type":"paragraph","text":"Без призора бросить?"},{"type":"paragraph","text":"И бегут к старушке,"},{"type":"paragraph","text":"Домовничать просят."},{"type":"paragraph","text":"Нет у ней отказа, —"},{"type":"paragraph","text":"Добрая такая!"},{"type":"paragraph","text":"За больным старушка"},{"type":"paragraph","text":"Ходит, как родная."},{"type":"paragraph","text":"Любят ее дети"},{"type":"paragraph","text":"За привет да ласки, —"},{"type":"paragraph","text":"Бабушка Маланья"},{"type":"paragraph","text":"Говорит им сказки."},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"Ясный летний вечер,"},{"type":"paragraph","text":"В воздухе прохлада;"},{"type":"paragraph","text":"С поля воротилось"},{"type":"paragraph","text":"На селенье стадо."},{"type":"paragraph","text":"Смолкли шум и говор:"},{"type":"paragraph","text":"С мучен люд трудами."},{"type":"paragraph","text":"Ивушка над хаткой"},{"type":"paragraph","text":"Не качнет ветвями."},{"type":"paragraph","text":"Тишь кругом такая —"},{"type":"paragraph","text":"Хоть бы где словечко…"},{"type":"paragraph","text":"Бабушка Маланья"},{"type":"paragraph","text":"Вышла на крылечко."},{"type":"paragraph","text":"К бабушке Маланье"},{"type":"paragraph","text":"Дети собралися."},{"type":"paragraph","text":"Глянь, у ней гостинцы"},{"type":"paragraph","text":"Для детей нашлися."},{"type":"paragraph","text":"То-то детям любо,"},{"type":"paragraph","text":"То-то им утеха!"},{"type":"paragraph","text":"Сколько у малюток"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Радости и смеха!"},{"type":"paragraph","text":"Пристают к ней дети,"},{"type":"paragraph","text":"Зная старой ласку:"},{"type":"paragraph","text":"«Бабушка Маланья,"},{"type":"paragraph","text":"Расскажи нам сказку!»"},{"type":"paragraph","text":"— «Что мне с вами делать?"},{"type":"paragraph","text":"Баловни вы, право!"},{"type":"paragraph","text":"Все скажи вам сказку —"},{"type":"paragraph","text":"Только и забавы."},{"type":"paragraph","text":"Прежде я вот много"},{"type":"paragraph","text":"Сказок этих знала,"},{"type":"paragraph","text":"Да перезабыла —"},{"type":"paragraph","text":"Старость доконала."},{"type":"paragraph","text":"Памяти-то нету —"},{"type":"paragraph","text":"Вот беда-досада;"},{"type":"paragraph","text":"А сказать вам, детки,"},{"type":"paragraph","text":"Сказку, видно, надо."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"Далеко отсюда"},{"type":"paragraph","text":"Есть село большое;"},{"type":"paragraph","text":"В том селе когда-то"},{"type":"paragraph","text":"Жили муж с женою."},{"type":"paragraph","text":"Жили по крестьянству"},{"type":"paragraph","text":"Люди те богато:"},{"type":"paragraph","text":"Двор скотом был полон,"},{"type":"paragraph","text":"А достатком хата."},{"type":"paragraph","text":"Жили эти люди"},{"type":"paragraph","text":"И нужды не знали;"},{"type":"paragraph","text":"Был у них сыночек,"},{"type":"paragraph","text":"Титушкою звали."},{"type":"paragraph","text":"Был у них один он —"},{"type":"paragraph","text":"Ну и рос он в холе:"},{"type":"paragraph","text":"Белый и румяный,"},{"type":"paragraph","text":"Что цветочек в поле."},{"type":"paragraph","text":"Титушку мать любит,"},{"type":"paragraph","text":"В нем души не слышит,"},{"type":"paragraph","text":"Только ей и дела —"},{"type":"paragraph","text":"На сыночка дышит."},{"type":"paragraph","text":"То его умоет,"},{"type":"paragraph","text":"То его причешет,"},{"type":"paragraph","text":"Даст ему гостинца,"},{"type":"paragraph","text":"Сказкою потешит."},{"type":"paragraph","text":"Летом соберутся"},{"type":"paragraph","text":"Дети на лужайку"},{"type":"paragraph","text":"И игру затеют"},{"type":"paragraph","text":"В городки иль в свайку."},{"type":"paragraph","text":"Титушке с детями"},{"type":"paragraph","text":"Поиграть охота —"},{"type":"paragraph","text":"Мать его не пустит:"},{"type":"paragraph","text":"„Что ты, милый, что ты!"},{"type":"paragraph","text":"Не ходи — головку"},{"type":"paragraph","text":"Напечет там солнце;"},{"type":"paragraph","text":"Сядь вот здесь, на лавке,"},{"type":"paragraph","text":"И гляди в оконце“."},{"type":"paragraph","text":"А зимой катаньем"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Тешатся ребята —"},{"type":"paragraph","text":"Титушке же выйти"},{"type":"paragraph","text":"Мать не даст из хаты."},{"type":"paragraph","text":"„Не ходи — морозно,"},{"type":"paragraph","text":"Дитятко родное!"},{"type":"paragraph","text":"Ну как захвораешь, —"},{"type":"paragraph","text":"Горюшко мне злое!"},{"type":"paragraph","text":"Что мне, бедной, делать?"},{"type":"paragraph","text":"Я умру с печали…“"},{"type":"paragraph","text":"Годы проходили,"},{"type":"paragraph","text":"Годы миновали…"},{"type":"paragraph","text":"Титушка уж парнем"},{"type":"paragraph","text":"Стал из паренечка;"},{"type":"paragraph","text":"Мать же, как и прежде,"},{"type":"paragraph","text":"Холит все сыночка."},{"type":"paragraph","text":"Что он ни попросит —"},{"type":"paragraph","text":"Все ему готово:"},{"type":"paragraph","text":"Сапожки со скрипом"},{"type":"paragraph","text":"Иль кафтанчик новый."},{"type":"paragraph","text":"Никакой работы"},{"type":"paragraph","text":"Титушка не знает:"},{"type":"paragraph","text":"То лежит на лавке,"},{"type":"paragraph","text":"То в селе гуляет."},{"type":"paragraph","text":"И жене с досадой"},{"type":"paragraph","text":"Молвит муж, бывало:"},{"type":"paragraph","text":"„Что ты его холишь?"},{"type":"paragraph","text":"Дурень выйдет малый!"},{"type":"paragraph","text":"Ты б его по дому"},{"type":"paragraph","text":"К делу приучала,"},{"type":"paragraph","text":"Чем к гульбе, к безделью."},{"type":"paragraph","text":"Толку в этом мало!"},{"type":"paragraph","text":"Ну, как нас не будет,"},{"type":"paragraph","text":"Что он станет делать?"},{"type":"paragraph","text":"По миру скитаться,"},{"type":"paragraph","text":"У чужих обедать?“"},{"type":"paragraph","text":"Ну да где ж, бывало,"},{"type":"paragraph","text":"Столковать с женою:"},{"type":"paragraph","text":"Та горой за сына…"},{"type":"paragraph","text":"Муж махнет рукою…"},{"type":"paragraph","text":"Как-то раз с сыночком"},{"type":"paragraph","text":"Что-то приключилось:"},{"type":"paragraph","text":"Слег он, просит меду —"},{"type":"paragraph","text":"Меду не случилось."},{"type":"paragraph","text":"Бросилася баба"},{"type":"paragraph","text":"Ночью, в непогоду,"},{"type":"paragraph","text":"С бураком к соседям"},{"type":"paragraph","text":"Раздобыться меду."},{"type":"paragraph","text":"Где-то для сыночка"},{"type":"paragraph","text":"Меду отыскала;"},{"type":"paragraph","text":"Крепко застудилась"},{"type":"paragraph","text":"Да и захворала."},{"type":"paragraph","text":"Только два дня баба"},{"type":"paragraph","text":"Мучилась на свете"},{"type":"paragraph","text":"Да и богу душу"},{"type":"paragraph","text":"Отдала на третий;"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"А за нею вскоре"},{"type":"paragraph","text":"И мужик убрался."},{"type":"paragraph","text":"И один на свете"},{"type":"paragraph","text":"Титушка остался."},{"type":"paragraph","text":"И в добре, достатке"},{"type":"paragraph","text":"Он недолго пожил, —"},{"type":"paragraph","text":"Что по дому было,"},{"type":"paragraph","text":"Все проел да прожил."},{"type":"paragraph","text":"И лежит день целый"},{"type":"paragraph","text":"Парень — голодает,"},{"type":"paragraph","text":"Как добыть трудами"},{"type":"paragraph","text":"Хлеб себе — не знает."},{"type":"paragraph","text":"Сжалился над малым"},{"type":"paragraph","text":"Дедушка Порфирий;"},{"type":"paragraph","text":"Человек был умный"},{"type":"paragraph","text":"Он в крестьянском мире."},{"type":"paragraph","text":"К дедушке Порфирью"},{"type":"paragraph","text":"Собирались часто"},{"type":"paragraph","text":"На совет крестьяне, —"},{"type":"paragraph","text":"Скажет что, и баста!"},{"type":"paragraph","text":"Как-то дед Порфирий"},{"type":"paragraph","text":"К Титушке заходит;"},{"type":"paragraph","text":"Помолившись богу,"},{"type":"paragraph","text":"Речь он с ним заводит:"},{"type":"paragraph","text":"„Ну, скажи, дружище,"},{"type":"paragraph","text":"Как тебе живется?"},{"type":"paragraph","text":"Как тобой хозяйство"},{"type":"paragraph","text":"По дому ведется?“"},{"type":"paragraph","text":"Титушка промолвил"},{"type":"paragraph","text":"Дедушке со вздохом:"},{"type":"paragraph","text":"„Ох, живется горько!"},{"type":"paragraph","text":"Ох, живется плохо!“"},{"type":"paragraph","text":"— „Слушай, Тит, — есть слово"},{"type":"paragraph","text":"До тебя такое,"},{"type":"paragraph","text":"Что свое хозяйство"},{"type":"paragraph","text":"Справишь ты плохое."},{"type":"paragraph","text":"Я чужим достатком"},{"type":"paragraph","text":"Не хочу разжиться:"},{"type":"paragraph","text":"Своего довольно"},{"type":"paragraph","text":"Будет прокормиться."},{"type":"paragraph","text":"Твой отец по дружбе"},{"type":"paragraph","text":"Рассказал мне это:"},{"type":"paragraph","text":"Клад — и клад немалый —"},{"type":"paragraph","text":"Схоронил он где-то."},{"type":"paragraph","text":"Tы возьми-ка заступ, —"},{"type":"paragraph","text":"Дело на свободе, —"},{"type":"paragraph","text":"Да вскопай поглубже"},{"type":"paragraph","text":"Землю в огороде."},{"type":"paragraph","text":"Может, клад отцовский"},{"type":"paragraph","text":"Где и попадется;"},{"type":"paragraph","text":"А тогда, ты знаешь,"},{"type":"paragraph","text":"Славно заживется“."},{"type":"paragraph","text":"Тит взялся за заступ, —"},{"type":"paragraph","text":"Малому в забаву:"},{"type":"paragraph","text":"В огороде землю"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Он вскопал на славу."},{"type":"paragraph","text":"Да на клад отцовский"},{"type":"paragraph","text":"Парень не наткнулся."},{"type":"paragraph","text":"Посмотрел дед старый,"},{"type":"paragraph","text":"Только усмехнулся."},{"type":"paragraph","text":"„Что, нашел?“ — он молвил."},{"type":"paragraph","text":"— „Нет, не отыскался“."},{"type":"paragraph","text":"— „Экая досада!"},{"type":"paragraph","text":"Где ж он затерялся?"},{"type":"paragraph","text":"Клад сыскать — не репу"},{"type":"paragraph","text":"Выдернуть, примерно;"},{"type":"paragraph","text":"Все-таки отыщем"},{"type":"paragraph","text":"Клад мы этот — верно."},{"type":"paragraph","text":"Огород-то вскопан —"},{"type":"paragraph","text":"Сделай-ка, брат, грядки,"},{"type":"paragraph","text":"Да на них с молитвой"},{"type":"paragraph","text":"Посади рассадки."},{"type":"paragraph","text":"Посмотри — капуста"},{"type":"paragraph","text":"Важная родится,"},{"type":"paragraph","text":"А она для дому,"},{"type":"paragraph","text":"Знаешь, пригодится“."},{"type":"paragraph","text":"Титушка охотно"},{"type":"paragraph","text":"Делает и гряды,"},{"type":"paragraph","text":"И на них с молитвой"},{"type":"paragraph","text":"Садит он рассады."},{"type":"paragraph","text":"„Огород исправен,"},{"type":"paragraph","text":"Пусть растет рассада,"},{"type":"paragraph","text":"А теперь ты в поле"},{"type":"paragraph","text":"Поищи-ка клада."},{"type":"paragraph","text":"Заступом-то трудно, —"},{"type":"paragraph","text":"Взрой его сохою."},{"type":"paragraph","text":"Приходи, я лошадь"},{"type":"paragraph","text":"Отпущу с тобою."},{"type":"paragraph","text":"Ведь земля сохою"},{"type":"paragraph","text":"Глубоко берется;"},{"type":"paragraph","text":"Под соху, наверно,"},{"type":"paragraph","text":"Клад и попадется…“"},{"type":"paragraph","text":"Титушка и поле"},{"type":"paragraph","text":"Все вспахал сохою…"},{"type":"paragraph","text":"Нет как нет все клада,"},{"type":"paragraph","text":"Дуй его горою!"},{"type":"paragraph","text":"Дед выходит в поле, —"},{"type":"paragraph","text":"Титушка трудится"},{"type":"paragraph","text":"Так, что даже градом"},{"type":"paragraph","text":"Пот с лица катится."},{"type":"paragraph","text":"„Что, нашел?“ — дед молвил."},{"type":"paragraph","text":"— „Нету, не попался“."},{"type":"paragraph","text":"— „Экая досада!"},{"type":"paragraph","text":"Где ж он подевался?"},{"type":"paragraph","text":"Ну, да это горе —"},{"type":"paragraph","text":"Горе не большое!"},{"type":"paragraph","text":"Ведь вспахать и поле —"},{"type":"paragraph","text":"Дело не худое."},{"type":"paragraph","text":"Ты его пройди-ка,"},{"type":"paragraph","text":"Парень, бороною,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Да зерном засеем"},{"type":"paragraph","text":"Мы его с тобою."},{"type":"paragraph","text":"Посмотри, какая"},{"type":"paragraph","text":"Рожь у нас родится!"},{"type":"paragraph","text":"Будут все соседи"},{"type":"paragraph","text":"На нее дивиться“."},{"type":"paragraph","text":"Взборонил Тит поле"},{"type":"paragraph","text":"И засеял рожью."},{"type":"paragraph","text":"Вырастай, родная,"},{"type":"paragraph","text":"Благодать ты божья!.."},{"type":"paragraph","text":"И с тех пор к работе"},{"type":"paragraph","text":"Малый приучился;"},{"type":"paragraph","text":"Он с утра до ночи"},{"type":"paragraph","text":"По дому трудился."},{"type":"paragraph","text":"Стал такой работник —"},{"type":"paragraph","text":"Не сыскать другого:"},{"type":"paragraph","text":"За пояс в работе"},{"type":"paragraph","text":"Он заткнет любого…"},{"type":"paragraph","text":"От трудов-работы"},{"type":"paragraph","text":"Зажил Тит богато:"},{"type":"paragraph","text":"Двор скотом стал полон,"},{"type":"paragraph","text":"А достатком хата…»"},{"type":"paragraph","text":"Бабушка умолкла;"},{"type":"paragraph","text":"Головой седою"},{"type":"paragraph","text":"Наклонилась к детям,"},{"type":"paragraph","text":"Гладит их рукою."},{"type":"paragraph","text":"«Ну, ступайте, детки!"},{"type":"paragraph","text":"Время уж до хаты…"},{"type":"paragraph","text":"Станете трудиться —"},{"type":"paragraph","text":"Будете богаты»."},{"type":"paragraph","text":"— «Бабушка, а клад-то"},{"type":"paragraph","text":"Где же подевался?"},{"type":"paragraph","text":"Али не отыскан"},{"type":"paragraph","text":"Так он и остался?» —"},{"type":"paragraph","text":"Дети с любопытством"},{"type":"paragraph","text":"Бабушку спросили."},{"type":"paragraph","text":"«Нет, сыскался, детки…"},{"type":"paragraph","text":"Он в труде да в силе»."},{"type":"paragraph","text":"1877"}]}]}