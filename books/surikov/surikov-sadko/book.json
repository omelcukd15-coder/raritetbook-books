{"id":"surikov-sadko","slug":"surikov-sadko","title":"Садко","altTitles":[],"author":"Иван Захарович Суриков","authorShort":"И. З. Суриков","authorSlug":"surikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1872","editionYear":"1872","description":"САДКО","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A1%D0%B0%D0%B4%D0%BA%D0%BE_%28%D0%A1%D1%83%D1%80%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1872)","downloadAllowed":true,"fb2Url":"/archive/books/surikov/surikov-sadko/original.fb2","coverUrl":"/archive/books/surikov/surikov-sadko/cover.webp","stats":{"chaptersCount":6,"wordsCount":1779,"charsCount":10626,"readingMinutes":10},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"САДКО"},{"type":"paragraph","text":"1. САДКО В НОВЕГОРОДЕ"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"На святой Руси, в Новегороде,"},{"type":"paragraph","text":"Жил богатый гость, звали Садкою:"},{"type":"paragraph","text":"Прежде Садко был бедняком-бедняк,"},{"type":"paragraph","text":"А потом казну мерил кадкою."},{"type":"paragraph","text":"Где же Садко так разжился казной,"},{"type":"paragraph","text":"Отчего же так Садко стал богат?.."},{"type":"paragraph","text":"Садко был гусляр, на пирах играл;"},{"type":"paragraph","text":"Садке грош дадут — Садко грошу рад."},{"type":"paragraph","text":"Раз он ходит день — не зовут играть,"},{"type":"paragraph","text":"Ходит он другой — хоть бы кто позвал,"},{"type":"paragraph","text":"И на третий день Садке зову нет,"},{"type":"paragraph","text":"На четвертый день Садко грустен стал."},{"type":"paragraph","text":"Он пошел тогда к Ильмень-озеру,"},{"type":"paragraph","text":"И над озером Садко стал играть;"},{"type":"paragraph","text":"Звуки чудные полились, дрожат —"},{"type":"paragraph","text":"Встрепенулася озерная гладь."},{"type":"paragraph","text":"Всколыхнулося Ильмень-озеро —"},{"type":"paragraph","text":"И подводный царь перед Садкой встал,"},{"type":"paragraph","text":"Говорит ему: «За игру твою"},{"type":"paragraph","text":"Наградить хочу, — хорошо играл!"},{"type":"paragraph","text":"Награжу тебя, будешь в почести,"},{"type":"paragraph","text":"Золотой казной будешь ты богат."},{"type":"paragraph","text":"Ступай в Новгород, бейся, Садко, ты"},{"type":"paragraph","text":"С новгородцами на велик заклад."},{"type":"paragraph","text":"Заложи ты им свою голову —"},{"type":"paragraph","text":"А они в заклад пусть кладут товар, —"},{"type":"paragraph","text":"Что поймаешь ты в Ильмень-озере"},{"type":"paragraph","text":"Золотых трех рыб, золотых, как жар."},{"type":"paragraph","text":"Как побьешься ты с новгородцами"},{"type":"paragraph","text":"На велик заклад — приходи сюда,"},{"type":"paragraph","text":"Закинь в озеро невод шелковый, —"},{"type":"paragraph","text":"Золотых трех рыб тебе дам тогда»."},{"type":"paragraph","text":"Всколыхнулося Ильмень-озеро,"},{"type":"paragraph","text":"Всколыхнулося во всю ширь и мочь —"},{"type":"paragraph","text":"И подводный царь под водой исчез,"},{"type":"paragraph","text":"И от озера пошел Садко прочь."},{"type":"paragraph","text":"Входит в Новгород — Садко ждут давно"},{"type":"paragraph","text":"На почестный пир поиграть, попеть,"},{"type":"paragraph","text":"Зеленым вином Садко потчуют,"},{"type":"paragraph","text":"С зелена вина Садко стал хмелеть."},{"type":"paragraph","text":"Захмелевши, он стал похвастывать,"},{"type":"paragraph","text":"На честном пиру похваляться стал,"},{"type":"paragraph","text":"Будто знает он чудо чудное,"},{"type":"paragraph","text":"Будто чудо то он не раз видал:"},{"type":"paragraph","text":"«В Ильмень-озере есть три рыбины,"},{"type":"paragraph","text":"Чиста золота чешуя на них»."},{"type":"paragraph","text":"Купцы Садке в том не поверили,"},{"type":"paragraph","text":"Говорят ему: «Нету рыб таких»."},{"type":"paragraph","text":"— «Я кладу в заклад свою голову, —"},{"type":"paragraph","text":"Говорит Садко богачам-купцам, —"},{"type":"paragraph","text":"Вы кладите же свой товар в заклад, —"},{"type":"paragraph","text":"Золотых трех рыб я поймаю вам»."}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"На такой заклад трое вызвались,"},{"type":"paragraph","text":"Бились с Садкою на весь свой товар."},{"type":"paragraph","text":"И связал Садко невод шелковый —"},{"type":"paragraph","text":"И поймал трех рыб, золотых, как жар."},{"type":"paragraph","text":"И забрал Садко у купцов товар,"},{"type":"paragraph","text":"Стал в Новгороде Садко торг вести,"},{"type":"paragraph","text":"Нажил он казны, что и сметы нет, —"},{"type":"paragraph","text":"И в Новгороде Садко стал в чести."},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"Распахнув шубу меха куньего,"},{"type":"paragraph","text":"Раз идет Садко по Новгороду;"},{"type":"paragraph","text":"Входит на площадь он торговую,"},{"type":"paragraph","text":"Стал на площади, гладит бороду."},{"type":"paragraph","text":"Заломив шапку соболиную,"},{"type":"paragraph","text":"Пред купцами он похваляется:"},{"type":"paragraph","text":"«Богачи, купцы новгородские!"},{"type":"paragraph","text":"Кто со мной казной потягается?"},{"type":"paragraph","text":"На казну свою я в Новгороде"},{"type":"paragraph","text":"Захочу — скуплю весь, что есть, товар,"},{"type":"paragraph","text":"До последнего горшка битого, —"},{"type":"paragraph","text":"Будет Новгород что пустой базар."},{"type":"paragraph","text":"На другой-то день в Новегороде"},{"type":"paragraph","text":"По пустым рядам буду я ходить,"},{"type":"paragraph","text":"И у вас, купцы новгородские,"},{"type":"paragraph","text":"Будет нечего мне тогда купить»."},{"type":"paragraph","text":"Богачи, купцы новгородские,"},{"type":"paragraph","text":"На слова Садки подивилися,"},{"type":"paragraph","text":"В похвальбе ему поперечили,"},{"type":"paragraph","text":"На большой заклад с ним побилися,"},{"type":"paragraph","text":"Что не скупит он весь, что есть, товар, —"},{"type":"paragraph","text":"Без товару им не бывать, купцам,"},{"type":"paragraph","text":"И не быть тому в Новегороде,"},{"type":"paragraph","text":"Чтоб ходил Садко по пустым рядам."},{"type":"paragraph","text":"Садко утром встал, призывает слуг,"},{"type":"paragraph","text":"Оделяет их золотой казной,"},{"type":"paragraph","text":"Посылает их по Новгороду,"},{"type":"paragraph","text":"Чтоб скупить товар весь, где есть какой."},{"type":"paragraph","text":"Разославши всех, Садко сам пошел:"},{"type":"paragraph","text":"Сыплет золотом, по рядам идет,"},{"type":"paragraph","text":"Закупает все чисто-начисто,"},{"type":"paragraph","text":"Закупает все, что метлой метет."},{"type":"paragraph","text":"Время к вечеру, и в Новгороде"},{"type":"paragraph","text":"Ничего купить не осталося,"},{"type":"paragraph","text":"И по улицам Новогорода"},{"type":"paragraph","text":"Кой-какая дрянь лишь валялася."},{"type":"paragraph","text":"На другой же день Садко утром встал,"},{"type":"paragraph","text":"По Новгороду посмотреть пошел —"},{"type":"paragraph","text":"И товару в нем вдвое прежнего;"},{"type":"paragraph","text":"Все опять скупил, что метлой подмел."},{"type":"paragraph","text":"Вот на третий день Садко утром встал,"},{"type":"paragraph","text":"По Новгороду посмотреть идет —"},{"type":"paragraph","text":"А товару в нем понакладено"},{"type":"paragraph","text":"Втрое прежнего, — Садку зло берет."},{"type":"paragraph","text":"Призадумался Садко, видит он,"},{"type":"paragraph","text":"Что приходится свой заклад пробить,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Что Новгороду не бывать пустым,"},{"type":"paragraph","text":"Что товары в нем не повыкупить."},{"type":"paragraph","text":"И пошел Садко прямо на площадь,"},{"type":"paragraph","text":"Пред купцами он свою шапку снял,"},{"type":"paragraph","text":"Поклонился им низко-нанизко,"},{"type":"paragraph","text":"Поклонившися, Садко так сказал:"},{"type":"paragraph","text":"«Богачи, купцы новгородские!"},{"type":"paragraph","text":"Похвалился я, что казной богат;"},{"type":"paragraph","text":"Нет, не я богат, богат Новгород, —"},{"type":"paragraph","text":"Получайте вы от меня заклад!»"},{"type":"paragraph","text":"За слова свои похвастливые"},{"type":"paragraph","text":"Выдавал Садко им заклад большой,"},{"type":"paragraph","text":"Отсыпал Садко богачам-купцам"},{"type":"paragraph","text":"Ровно тридцать мер золотой казной."},{"type":"paragraph","text":"1871"},{"type":"paragraph","text":"2. САДКО У МОРСКОГО ЦАРЯ"},{"type":"paragraph","text":"1"},{"type":"paragraph","text":"Едет Садко-купец на своих кораблях"},{"type":"paragraph","text":"По широкому синему морю;"},{"type":"paragraph","text":"Расходилась вдруг буря на синих волнах"},{"type":"paragraph","text":"Ко великому Садкину горю."},{"type":"paragraph","text":"Ходит буря, ревет, корабли набок гнет,"},{"type":"paragraph","text":"Паруса рвет на мелкие части,"},{"type":"paragraph","text":"За волною волна в синем море встает,"},{"type":"paragraph","text":"И трещат корабельные снасти."},{"type":"paragraph","text":"Струсил Садко-купец пред бедою такой"},{"type":"paragraph","text":"Я поник головою в кручине:"},{"type":"paragraph","text":"Не придется, знать, Новгород видеть родной,"},{"type":"paragraph","text":"А придется погибнуть в пучине."},{"type":"paragraph","text":"Говорит он дружине своей удалой:"},{"type":"paragraph","text":"«Много лет мы по морю ходили,"},{"type":"paragraph","text":"А морскому царю дани мы никакой"},{"type":"paragraph","text":"За проход кораблей не платили."},{"type":"paragraph","text":"Знать, за это на нас рассердясь, царь морской"},{"type":"paragraph","text":"Причинить хочет злое нам горе."},{"type":"paragraph","text":"Вы берите бочонок с казной золотой"},{"type":"paragraph","text":"И бросайте его в сине море»."},{"type":"paragraph","text":"И дружина бочонок с казной золотой"},{"type":"paragraph","text":"В волны синего моря кидает…"},{"type":"paragraph","text":"Волны, пенясь, кипят над морской глубиной,"},{"type":"paragraph","text":"Корабли, точно щепки, швыряет…"},{"type":"paragraph","text":"Видит Садко, что море все больше бурлит,"},{"type":"paragraph","text":"Все сильней и сильнее клокочет,"},{"type":"paragraph","text":"И дружине своей удалой говорит:"},{"type":"paragraph","text":"«Видно, царь головы данью хочет!"},{"type":"paragraph","text":"Так даваюе же, братцы, кидать жеребья —"},{"type":"paragraph","text":"Кому жертвою быть синю морю;"},{"type":"paragraph","text":"Если ваш, то быть вам, если мой — буду я,"},{"type":"paragraph","text":"И кидайте меня — не поспорю»."},{"type":"paragraph","text":"Все берут жеребья, Садке в шапку кладут,"},{"type":"paragraph","text":"Садко в море с своим их кидает."},{"type":"paragraph","text":"Жеребья всей дружины не тонут — плывут,"},{"type":"paragraph","text":"Только Садкин ко дну упадает."},{"type":"paragraph","text":"«Выпал жеребий мой морю жертвою быть,"},{"type":"paragraph","text":"Заплатить дань своей головою;"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Без меня к Новугороду, братцы, вам плыть,"},{"type":"paragraph","text":"Увидаться с сторонкой родною."},{"type":"paragraph","text":"Посадите меня на дубовой доске,"},{"type":"paragraph","text":"Дайте гусли мои золотые,"},{"type":"paragraph","text":"На дубовой доске и с гуслями в руке"},{"type":"paragraph","text":"Опустите на волны морские»."},{"type":"paragraph","text":"На дубовой доске посадили его"},{"type":"paragraph","text":"И на синее море спустили:"},{"type":"paragraph","text":"Не взял Садко с собою добра ничего,"},{"type":"paragraph","text":"С ним одни его гусельки были."},{"type":"paragraph","text":"И затихла вдруг буря на синих волнах,"},{"type":"paragraph","text":"Улеглася морская пучина."},{"type":"paragraph","text":"И без Садки-купца на его кораблях"},{"type":"paragraph","text":"Понеслася по морю дружина."},{"type":"paragraph","text":"2"},{"type":"paragraph","text":"На морской глубине, в светлом царском дворце"},{"type":"paragraph","text":"Ходят рыбы-киты и дельфины"},{"type":"paragraph","text":"И седые усы у царя на лице"},{"type":"paragraph","text":"Очищают от грязи и типы."},{"type":"paragraph","text":"С неба солнца лучи светят в царский дворец,"},{"type":"paragraph","text":"Зажигают огни-изумруды."},{"type":"paragraph","text":"Вот в палаты царя входит Садко-купец,"},{"type":"paragraph","text":"За плечом у него звонкогуды."},{"type":"paragraph","text":"«А! здорово, дружище! давно тебя ждем, —"},{"type":"paragraph","text":"Молвил Садке морской царь, зевая,"},{"type":"paragraph","text":"Рот широко раскрыв и зубчатым жезлом"},{"type":"paragraph","text":"Прочь придворных своих отгоняя. —"},{"type":"paragraph","text":"Много лет ты возил на своих кораблях"},{"type":"paragraph","text":"Нашим морем без дани богатство, —"},{"type":"paragraph","text":"Так за это потешь ты игрой на гуслях"},{"type":"paragraph","text":"Нашу царскую милость в приятство»."},{"type":"paragraph","text":"Садко кудри с лица прочь рукою отвел,"},{"type":"paragraph","text":"Взял он гусли свои звонкогуды,"},{"type":"paragraph","text":"И придворных царя смелым взглядом обвел"},{"type":"paragraph","text":"И подумал себе: «Да, не худы!»"},{"type":"paragraph","text":"«Ладно! — молвил царю, — я потешить непрочь"},{"type":"paragraph","text":"Вашу царскую милость игрою»."},{"type":"paragraph","text":"И хватил по струнам во всю русскую мочь —"},{"type":"paragraph","text":"Моря гладь заходила волною."},{"type":"paragraph","text":"Царь ладонями уши закрыл и кричит!"},{"type":"paragraph","text":"«Что за черт, за игра за такая?"},{"type":"paragraph","text":"Она царский наш слух нам совсем оглушит,"},{"type":"paragraph","text":"Это шутка для нас, брат, плохая!»"},{"type":"paragraph","text":"Садко руку отвел, замирает струна,"},{"type":"paragraph","text":"Звуки тихие чуть издавая, —"},{"type":"paragraph","text":"Над морской глубиной улеглася волна,"},{"type":"paragraph","text":"Перед солнцем горя и сверкая."},{"type":"paragraph","text":"Точно муха, кружась, зацепляет струну,"},{"type":"paragraph","text":"Точно мошки, жужжа, где-то вьются,"},{"type":"paragraph","text":"Точно капли дождя тихо бьют о волну, —"},{"type":"paragraph","text":"Звуки стройные, чудные льются."},{"type":"paragraph","text":"Точно кто-то, рыдая, глубоко скорбит"},{"type":"paragraph","text":"О потерянном счастье когда-то,"},{"type":"paragraph","text":"Точно тихая речь чья-то грустно звучит"},{"type":"paragraph","text":"О погибшей любви без возврата."}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"И под звуки игры у морского царя"},{"type":"paragraph","text":"Голова наклонилась седая;"},{"type":"paragraph","text":"Хороша, как поутру на небе заря,"},{"type":"paragraph","text":"Загрустилась царица морская."},{"type":"paragraph","text":"Ей припомнился Новгород вольный, родной,"},{"type":"paragraph","text":"Ее девичья вышка-светлица,"},{"type":"paragraph","text":"Что стояла над Волховом, быстрой рекой."},{"type":"paragraph","text":"И рыдает морская царица."},{"type":"paragraph","text":"Загубил ее век — золотые деньки —"},{"type":"paragraph","text":"Сын боярский, свенчавшись с другою;"},{"type":"paragraph","text":"Она бросилась в Волхов-реку от тоски,"},{"type":"paragraph","text":"Да и стала царицей морскою."},{"type":"paragraph","text":"И придворные все, рот разинув, ревут,"},{"type":"paragraph","text":"Точно горе какое стряслося,"},{"type":"paragraph","text":"И из рыбьих их глаз слезы льются, текут:"},{"type":"paragraph","text":"Всласть впервой им поплакать пришлося."},{"type":"paragraph","text":"Садко дернул плечом и кудрями тряхнул —"},{"type":"paragraph","text":"И забегали пальцы быстрее,"},{"type":"paragraph","text":"И от струн побежал одуряющий гул,"},{"type":"paragraph","text":"Звуки льются живей и живее."},{"type":"paragraph","text":"Точно дождик шумит, точно скачет волна,"},{"type":"paragraph","text":"Ударяясь о берег скалистый,"},{"type":"paragraph","text":"Зазвенела морская кругом глубина,"},{"type":"paragraph","text":"Понеслись гоготанье и свисты."},{"type":"paragraph","text":"Ошалел царь морской, головою трясет,"},{"type":"paragraph","text":"Плечи сами собой так и ходят,"},{"type":"paragraph","text":"И руками вертит, и ногами толчет,"},{"type":"paragraph","text":"И, моргая, глазами поводит."},{"type":"paragraph","text":"Скачет царь водяной, ходит фертом кругом,"},{"type":"paragraph","text":"И полой своей шубы он машет,"},{"type":"paragraph","text":"По хрустальным палатам вертится вьюном,"},{"type":"paragraph","text":"Приседает и с присвистом пляшет."},{"type":"paragraph","text":"Садко день проиграл, проиграл и другой —"},{"type":"paragraph","text":"Звуки прыгают, скачут, дробятся;"},{"type":"paragraph","text":"Все сильней и сильней пляшет царь водяной,"},{"type":"paragraph","text":"Так что начал дворец весь шататься."},{"type":"paragraph","text":"Над морской глубиной волны, пенясь, кипят"},{"type":"paragraph","text":"И, свистя, друг на друга несутся,"},{"type":"paragraph","text":"И трещат корабли, мачты в воду летят,"},{"type":"paragraph","text":"Крики, стоны кругом раздаются."},{"type":"paragraph","text":"Корабельщики все пред бедою такой"},{"type":"paragraph","text":"Затужились о ждущей их доле,"},{"type":"paragraph","text":"Что придется погибнуть им в глуби морской,"},{"type":"paragraph","text":"И взмолились святому Николе."},{"type":"paragraph","text":"3"},{"type":"paragraph","text":"Два дня Садко играл и играет еще,"},{"type":"paragraph","text":"На щеках разгорелся румянец…"},{"type":"paragraph","text":"Кто-то Садку рукой тихо дерг за плечо…"},{"type":"paragraph","text":"Глядь — стоит перед ним седой старец."},{"type":"paragraph","text":"Старец стал невидим. Садко струны рванул —"},{"type":"paragraph","text":"На гуслях точно струн не бывало,"},{"type":"paragraph","text":"И замолк под водою рокочущий гул,"},{"type":"paragraph","text":"И в палатах царя тихо стало,"},{"type":"paragraph","text":"Перестал царь морской и скакать и плясать,"},{"type":"paragraph","text":"Говорит так он Садке с грозою:"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"«Что ж ты, Садко, умолк, или нас потешать"},{"type":"paragraph","text":"Не желаешь ты больше игрою?»"},{"type":"paragraph","text":"— «Я бы тешить непрочь, да ведь как же мне"},{"type":"paragraph","text":"быть, —"},{"type":"paragraph","text":"На губах наиграешь не много…"},{"type":"paragraph","text":"Царь, порвались все струны, других захватить"},{"type":"paragraph","text":"Не пришло мне в умишко убогой»."},{"type":"paragraph","text":"— «Делать нечего, вижу, вина не твоя,"},{"type":"paragraph","text":"А хотелось еще поплясать бы, —"},{"type":"paragraph","text":"Уж утешил бы всех своей пляскою я,"},{"type":"paragraph","text":"А особенно в день твоей свадьбы."},{"type":"paragraph","text":"За игру твою, Садко, хочу наградить,"},{"type":"paragraph","text":"За большую услугу такую:"},{"type":"paragraph","text":"Я хочу тебя, Садко, на дочке женить,"},{"type":"paragraph","text":"Из царевен облюбишь какую»."},{"type":"paragraph","text":"— «Нет уж, батюшка царь, не изволь"},{"type":"paragraph","text":"награждать, —"},{"type":"paragraph","text":"Награжденье твое — мне кручина,"},{"type":"paragraph","text":"Мне царевна морская женой не под стать, —"},{"type":"paragraph","text":"Я простой новгородский людина."},{"type":"paragraph","text":"Для простого людина мне честь велика —"},{"type":"paragraph","text":"Взять женою царевну морскую."},{"type":"paragraph","text":"Подопью иногда, раззудится рука —"},{"type":"paragraph","text":"Ни за что твою дочку отдую."},{"type":"paragraph","text":"За царевною нужен великий уход,"},{"type":"paragraph","text":"Обувать, одевать — нужны слуги,"},{"type":"paragraph","text":"А для этого скуден мой будет доход, —"},{"type":"paragraph","text":"Не возьму твою дочку в супруги."},{"type":"paragraph","text":"Царь, мне надо жену вот такую бы взять,"},{"type":"paragraph","text":"Чтобы с ног сапоги мне снимала;"},{"type":"paragraph","text":"Как побью иногда, чтобы стала молчать,"},{"type":"paragraph","text":"Говорить предо мной не дерзала."},{"type":"paragraph","text":"Чтобы делала то, что ей делать велю,"},{"type":"paragraph","text":"Моему не перечила б нраву;"},{"type":"paragraph","text":"Дай ты в жены мне лучше прислугу твою,"},{"type":"paragraph","text":"Некрасивую девку Чернаву»."},{"type":"paragraph","text":"И женил его царь на Чернаве рябой,"},{"type":"paragraph","text":"На нечесаной девке косматой;"},{"type":"paragraph","text":"Сорок бочек казны за Чернавой-женой"},{"type":"paragraph","text":"Дал в приданое царь тороватый."},{"type":"paragraph","text":"После свадьбы лег Садко в палатах царя,"},{"type":"paragraph","text":"От жены молодой отвернулся,"},{"type":"paragraph","text":"И как только поутру зажглася заря,"},{"type":"paragraph","text":"В Новегороде вольном проснулся,"},{"type":"paragraph","text":"И над Волховом, быстрой рекою, стоит,"},{"type":"paragraph","text":"Недалеко от дома родного,"},{"type":"paragraph","text":"И пред ним сорок бочек с казною лежит,"},{"type":"paragraph","text":"Награжденье царя водяного."},{"type":"paragraph","text":"Вот и Садки суда принеслись по волнам,"},{"type":"paragraph","text":"Удивленье дружине — загадка,"},{"type":"paragraph","text":"Что за чудо такое? — не верят глазам —"},{"type":"paragraph","text":"Как ни в чем не бывал, стоит Садко."},{"type":"paragraph","text":"1872"}]}]}