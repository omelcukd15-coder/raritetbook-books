{"id":"sadovnikov-usolka","slug":"sadovnikov-usolka","title":"Усолка","altTitles":[],"author":"Дмитрий Николаевич Садовников","authorShort":"Д. Н. Садовников","authorSlug":"sadovnikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1873","editionYear":"1873","description":"(Народное предание)","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A3%D1%81%D0%BE%D0%BB%D0%BA%D0%B0_%28%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%BD%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1873)","downloadAllowed":true,"fb2Url":"/archive/books/sadovnikov/sadovnikov-usolka/original.fb2","coverUrl":"/archive/books/sadovnikov/sadovnikov-usolka/cover.webp","stats":{"chaptersCount":4,"wordsCount":870,"charsCount":5371,"readingMinutes":5},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"(Народное предание)."},{"type":"paragraph","text":"При Грозном на Волгу, к подошве холмов,"},{"type":"paragraph","text":"Точивших солёную воду,"},{"type":"paragraph","text":"Сошлись поселенцы на выгодный зов,"},{"type":"paragraph","text":"Почин положили заводу."},{"type":"paragraph","text":"Срубили жильё, окружили стеной,"},{"type":"paragraph","text":"И скоро возник городок соляной"},{"type":"paragraph","text":"На дальней границе востока,"},{"type":"paragraph","text":"Где спеть расстилалась широко."},{"type":"paragraph","text":"Усолье росло: заезжали купцы,"},{"type":"paragraph","text":"Рабочие шли на варницы;"},{"type":"paragraph","text":"Приставлены царские были стрельцы,"},{"type":"paragraph","text":"И пушки глядели в бойницы."},{"type":"paragraph","text":"Нередко в долину с солёной водой"},{"type":"paragraph","text":"Сбегались кочевники дикой ордой,"},{"type":"paragraph","text":"Скакали по Русскому полю."},{"type":"paragraph","text":"Людей уводили в неволю."},{"type":"paragraph","text":"Кругом ещё лес был да темени гор;"},{"type":"paragraph","text":"Пониже — селенье и пашня,"},{"type":"paragraph","text":"А самый высокий венчала бугор"},{"type":"paragraph","text":"В лесу караульная башня."},{"type":"paragraph","text":"Чуть ночью по степи затопает конь,"},{"type":"paragraph","text":"На ней зажигали сигнальный огонь,"},{"type":"paragraph","text":"И местные жители знали,"},{"type":"paragraph","text":"Что надо готовить пищали…"},{"type":"paragraph","text":"По старым рассказам, в Усолье жила"},{"type":"paragraph","text":"Одна богатырка в то время;"},{"type":"paragraph","text":"Она от Усолья на степь угнала"},{"type":"paragraph","text":"Ногайское хищное племя."},{"type":"paragraph","text":"Шло время… Седела, теряла глаза"},{"type":"paragraph","text":"Посёлка защита, ногайцев гроза,"},{"type":"paragraph","text":"Могучая сила сбывала…"},{"type":"paragraph","text":"Усолье её забывало."},{"type":"paragraph","text":"Смеялась недавно над ней молодёжь:"},{"type":"paragraph","text":"« Куда тебе, бабушка, драться?"},{"type":"paragraph","text":"На старости лет ты с коня упадёшь,"},{"type":"paragraph","text":"Пора на покой убираться»!"},{"type":"paragraph","text":"Кто знает, сердилась старуха, иль нет,"},{"type":"paragraph","text":"Но только ни слова усольцам в ответ"},{"type":"paragraph","text":"На это она не сказала,"},{"type":"paragraph","text":"Чему подивились немало."},{"type":"paragraph","text":"Покойно и мирно тянулись годы"},{"type":"paragraph","text":"По милости страшной Усолки,"},{"type":"paragraph","text":"Татарских коней не видать и следа,"},{"type":"paragraph","text":"Замолкли тревожные толки."},{"type":"paragraph","text":"Но горе застало Усолье врасплох,"},{"type":"paragraph","text":"В осеннюю ночь загорелся сполох,"},{"type":"paragraph","text":"Недаром такая тревога:"},{"type":"paragraph","text":"Ногайцев нахлынуло много…"},{"type":"paragraph","text":"Покинули полчища диких татар"},{"type":"paragraph","text":"Степей кочевое раздолье,"},{"type":"paragraph","text":"Потоптаны нивы, и скоро пожар"},{"type":"paragraph","text":"Осветит родное Усолье!"},{"type":"paragraph","text":"Из города выслана малая рать"},{"type":"paragraph","text":"Ногайскую силу в леса отогнать;"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"А с ней заодно отряжёны"},{"type":"paragraph","text":"И девки, и мужние жёны."},{"type":"paragraph","text":"Дрались поселенцы… Оружия стук"},{"type":"paragraph","text":"Взлетал до лесистых верхушек,"},{"type":"paragraph","text":"Стрелу отпускал туго стянутый лук,"},{"type":"paragraph","text":"Рубились, палили из пушек."},{"type":"paragraph","text":"Кровавая битва была горяча,"},{"type":"paragraph","text":"А сила росла, как в степи саранча,"},{"type":"paragraph","text":"И дрогнули наши средь поля:"},{"type":"paragraph","text":"Ждала их недобрая доля."},{"type":"paragraph","text":"Здесь стало понятно толпе удальцов,"},{"type":"paragraph","text":"Кого на бою не хватало…"},{"type":"paragraph","text":"Усолка в обиде: за несколько слов,"},{"type":"paragraph","text":"Быть может, всё дело пропало!"},{"type":"paragraph","text":"В былые года у ней сила была,"},{"type":"paragraph","text":"Недаром она богатыркой слыла,"},{"type":"paragraph","text":"И сильной и грозной недаром"},{"type":"paragraph","text":"Казалась несносным татарам."},{"type":"paragraph","text":"И вот старшины отрядили гонцов,"},{"type":"paragraph","text":"Должны они были в посёлке,"},{"type":"paragraph","text":"С казав в извинение несколько слов,"},{"type":"paragraph","text":"Подмоги просить у Усолки."},{"type":"paragraph","text":"Быть может, её неожиданный вид"},{"type":"paragraph","text":"Усталые силы людей оживит,"},{"type":"paragraph","text":"Давно уж её не видали"},{"type":"paragraph","text":"С клинком из сверкающей стали."},{"type":"paragraph","text":"Приходят гонцы и старухе поклон"},{"type":"paragraph","text":"С почтеньем отвесили низко:"},{"type":"paragraph","text":"« Спаси от ногайца — отступится он"},{"type":"paragraph","text":"И после не сунется близко!"},{"type":"paragraph","text":"Прости нам обиду, тряхни стариной,"},{"type":"paragraph","text":"Всё дело теперь за тобою одной…"},{"type":"paragraph","text":"Родная, забудь своё сердце, —"},{"type":"paragraph","text":"От нас отгони иноверца»!"},{"type":"paragraph","text":"Ответ им держала Усолка такой:"},{"type":"paragraph","text":"« Забыть не могу я обиду,"},{"type":"paragraph","text":"Ищите себе вы подмоги другой,"},{"type":"paragraph","text":"На выручку к вам я не выйду!"},{"type":"paragraph","text":"Пришли над старухой смеяться больной?"},{"type":"paragraph","text":"Что? Мало вам места за это стеной?"},{"type":"paragraph","text":"Где сабли у вас и пищали?"},{"type":"paragraph","text":"Иль порохом вы обнищали»?"},{"type":"paragraph","text":"Тем временем длился отчаянный бой"},{"type":"paragraph","text":"И стоном стонала дубрава…"},{"type":"paragraph","text":"Усольцы к стенам отступали гурьбой,"},{"type":"paragraph","text":"Налево рубясь и направо."},{"type":"paragraph","text":"Сверкал меж дерев их пищальный огонь,"},{"type":"paragraph","text":"Валился татарин и пятился конь…"},{"type":"paragraph","text":"Ногайская тёмная сила"},{"type":"paragraph","text":"Усольцев кругом обступила…"},{"type":"paragraph","text":"Недолго продержится русская рать,"},{"type":"paragraph","text":"Зато уж отдастся не даром,"},{"type":"paragraph","text":"Хоть будут тела её лес устилать,"},{"type":"paragraph","text":"И всё истребится пожаром."},{"type":"paragraph","text":"Но каждый усолец заране решил"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Сражаться, пока хватит духа и сил,"},{"type":"paragraph","text":"От Бога одна лишь подмога:"},{"type":"paragraph","text":"Их мало, а нехристей много."},{"type":"paragraph","text":"Гонцы богатырку просили опять…"},{"type":"paragraph","text":"В тревоге сидела старуха:"},{"type":"paragraph","text":"Стал топот татарских коней достигать"},{"type":"paragraph","text":"Её, прежде чуткого, уха…"},{"type":"paragraph","text":"« Прости неразумных, не наша вина…"},{"type":"paragraph","text":"Нам горькая доля теперь суждена,"},{"type":"paragraph","text":"Забудь ты обидное слово —"},{"type":"paragraph","text":"Спаси от татарина злого»!"},{"type":"paragraph","text":"« Стара я для боя, — куда воевать"},{"type":"paragraph","text":"И лезть мне в кровавую драку!"},{"type":"paragraph","text":"Пора обо мне позабыть вспоминать,"},{"type":"paragraph","text":"Как дохлую бросить собаку…"},{"type":"paragraph","text":"Вся в ржавчине сабля, ступилось копьё —"},{"type":"paragraph","text":"В груди улеглось ретивое моё…"},{"type":"paragraph","text":"У вас молодая есть сила,"},{"type":"paragraph","text":"А мне она уж изменила»…"},{"type":"paragraph","text":"Сердилась Усолка, но слёзы людей"},{"type":"paragraph","text":"Её победили, — смягчилась;"},{"type":"paragraph","text":"Взыграла вся кровь богатырская в ней,"},{"type":"paragraph","text":"Вся старая удаль забилась…"},{"type":"paragraph","text":"« Давайте коня! Где он, конь боевой?"},{"type":"paragraph","text":"Давно не видала его под собой!"},{"type":"paragraph","text":"Проклятым татарам навстречу"},{"type":"paragraph","text":"Я кинусь в кровавую сечу»!"},{"type":"paragraph","text":"И выведен был застоявшийся конь"},{"type":"paragraph","text":"С густой серебристою гривой,"},{"type":"paragraph","text":"Из камня ногой высекал он огонь,"},{"type":"paragraph","text":"Мотал головою красивой."},{"type":"paragraph","text":"Высоко ходила могучая грудь, —"},{"type":"paragraph","text":"И фыркал скакун при собрании в путь"},{"type":"paragraph","text":"На хищные орды Ногая,"},{"type":"paragraph","text":"Себе седока поджидая."},{"type":"paragraph","text":"Выходит Усолка, завидев коня,"},{"type":"paragraph","text":"Ремень-опояска у стана,"},{"type":"paragraph","text":"И в древко копья ударяют, звеня,"},{"type":"paragraph","text":"Ножны вдоль её сарафана!"},{"type":"paragraph","text":"На стремя ступила привычной ногой;"},{"type":"paragraph","text":"В одной руке сабля и пика — в другой;"},{"type":"paragraph","text":"И с гиком пустилася лётом"},{"type":"paragraph","text":"К широко раскрытым воротам."},{"type":"paragraph","text":"И по полю конь богатырку понёс…"},{"type":"paragraph","text":"При виде могучего взмаха,"},{"type":"paragraph","text":"При виде седых и растрёпанных кос"},{"type":"paragraph","text":"Враги ошалели от страха."},{"type":"paragraph","text":"« Скачи без разбора, ногами топчи"},{"type":"paragraph","text":"Проклятую силу степной саранчи»!"},{"type":"paragraph","text":"В крови накупались досыта"},{"type":"paragraph","text":"Коня боевого копыта."},{"type":"paragraph","text":"К усольцам вернулась вся прежняя мочь,"},{"type":"paragraph","text":"Отвага в глазах засверкала,"},{"type":"paragraph","text":"Рубились, пока не подкралась вдруг ночь;"},{"type":"paragraph","text":"Татар положили немало."}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Везде впереди богатырка была;"},{"type":"paragraph","text":"От страшных ударов валились тела"},{"type":"paragraph","text":"Кровавою грудой на груду…"},{"type":"paragraph","text":"Ногайцы бежали от всюду."},{"type":"paragraph","text":"Бежали к горам, и никто их потом"},{"type":"paragraph","text":"Не видел на этой равнине;"},{"type":"paragraph","text":"То место же, где был татарский погром,"},{"type":"paragraph","text":"Всё « Сечей» зовётся и ныне."},{"type":"paragraph","text":"И память о той богатырке жива!"},{"type":"paragraph","text":"Её сохранила людская молва…"},{"type":"paragraph","text":"Так бились все в старые годы"},{"type":"paragraph","text":"За право труда и свободы."},{"type":"paragraph","text":"1873 г."},{"type":"paragraph","text":"Источник текста: Садовников Д. Н. «Избранные произведения», Саратов, « Приволжское книжное издательство», 1989 г."}]}]}