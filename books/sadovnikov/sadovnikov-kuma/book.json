{"id":"sadovnikov-kuma","slug":"sadovnikov-kuma","title":"Кума","altTitles":[],"author":"Дмитрий Николаевич Садовников","authorShort":"Д. Н. Садовников","authorSlug":"sadovnikov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1882","editionYear":"1882","description":"=== Кума. === I","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%9A%D1%83%D0%BC%D0%B0_%28%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%BD%D0%B8%D0%BA%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1882)","downloadAllowed":true,"fb2Url":"/archive/books/sadovnikov/sadovnikov-kuma/original.fb2","coverUrl":"/archive/books/sadovnikov/sadovnikov-kuma/cover.webp","stats":{"chaptersCount":9,"wordsCount":2095,"charsCount":12518,"readingMinutes":12},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Кума. I."},{"type":"paragraph","text":"Всплывает месяц и горит"},{"type":"paragraph","text":"На высоте кремлёвских башен…"},{"type":"paragraph","text":"Весь Нижний спит глубоким сном,"},{"type":"paragraph","text":"Везде огонь давно погашен;"},{"type":"paragraph","text":"Лишь воеводе одному"},{"type":"paragraph","text":"В тот час не спится на постели, —"},{"type":"paragraph","text":"Мечты греховные его"},{"type":"paragraph","text":"В опочивальне одолели…"},{"type":"paragraph","text":"Он рад бы спать, не сон не идёт:"},{"type":"paragraph","text":"Нет, не даёт ему покою"},{"type":"paragraph","text":"Кума-красавица, вдова,"},{"type":"paragraph","text":"На перевозе за Окою…"},{"type":"paragraph","text":"И всё мерещится ему"},{"type":"paragraph","text":"То грудь налитая, то плечи,"},{"type":"paragraph","text":"То руки белые, что снег,"},{"type":"paragraph","text":"То глаз приманчивые речи…"},{"type":"paragraph","text":"И не глядел бы на жену!.."},{"type":"paragraph","text":"Княгини любящая ласка"},{"type":"paragraph","text":"Ему противна, сын забыт,"},{"type":"paragraph","text":"И не страшит его огласка…"},{"type":"paragraph","text":"Он встал, велит седлать коней;"},{"type":"paragraph","text":"Седлать коней вмиг дворня сбита,"},{"type":"paragraph","text":"Через минуту у крыльца"},{"type":"paragraph","text":"Бьют лошадиные копыта…"},{"type":"paragraph","text":"Князь сел, холоп спешит за ним"},{"type":"paragraph","text":"К раскрытым челядью воротам;"},{"type":"paragraph","text":"Несутся улицей и вот —"},{"type":"paragraph","text":"Пропали вдруг за поворотом…"},{"type":"paragraph","text":"II."},{"type":"paragraph","text":"Проходит день, а князя нет;"},{"type":"paragraph","text":"Другой прошёл, — его не видно;"},{"type":"paragraph","text":"Никто не ведает, где он;"},{"type":"paragraph","text":"Княгине больно и обидно…"},{"type":"paragraph","text":"На третий день вернулся князь;"},{"type":"paragraph","text":"С женой — ни слова… Рвёт и мечет…"},{"type":"paragraph","text":"Ничто не радует его —"},{"type":"paragraph","text":"Ни травля, ни любимый кречет…"},{"type":"paragraph","text":"Томит его и тяготит"},{"type":"paragraph","text":"Необъяснимая кручина…"},{"type":"paragraph","text":"Бывало, прежде по часам"},{"type":"paragraph","text":"Не налюбуется на сына, —"},{"type":"paragraph","text":"Теперь семьи как будто нет;"},{"type":"paragraph","text":"Всё опротивело, постыло,"},{"type":"paragraph","text":"Куда-то ездит по ночам,"},{"type":"paragraph","text":"И прежде милое — не мило…"},{"type":"paragraph","text":"На грех заехал, видно, он"},{"type":"paragraph","text":"С охоты гостем запоздалым"},{"type":"paragraph","text":"На перевоз и до утра"},{"type":"paragraph","text":"Спал у кумы на постоялом."},{"type":"paragraph","text":"Его, седого старика,"},{"type":"paragraph","text":"Попутал, видно, бес лукавый…"},{"type":"paragraph","text":"Кума — колдунья, у неё"},{"type":"paragraph","text":"Все приворотные есть травы;"},{"type":"paragraph","text":"В её сверкающих глазах"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Недаром, говорят, есть сила,"},{"type":"paragraph","text":"Не мало в городе мужей"},{"type":"paragraph","text":"Она к себе приворожила…"},{"type":"paragraph","text":"Глазами вскинет — дрожь берёт;"},{"type":"paragraph","text":"В речах — какая-то отвага…"},{"type":"paragraph","text":"И что пьяней, — вино ль её"},{"type":"paragraph","text":"Иль речи, крепкие, как брага, —"},{"type":"paragraph","text":"Кто знает?.. Только силы нет"},{"type":"paragraph","text":"От этой груди оторваться,"},{"type":"paragraph","text":"С семьёй по-старому зажить,"},{"type":"paragraph","text":"С кумой подолгу не видаться,"},{"type":"paragraph","text":"Так, вот и тянет за Оку…"},{"type":"paragraph","text":"И скоро слух прошёл в народе,"},{"type":"paragraph","text":"Что приворотного дала"},{"type":"paragraph","text":"Колдунья зелья воеводе…"},{"type":"paragraph","text":"III."},{"type":"paragraph","text":"Кромешный ад кипит в дому;"},{"type":"paragraph","text":"Не может сын добиться толку,"},{"type":"paragraph","text":"О чём его родная мать"},{"type":"paragraph","text":"Так часто плачет втихомолку…"},{"type":"paragraph","text":"Она молчит, не говорит"},{"type":"paragraph","text":"Любимцу-сыну ни полслова,"},{"type":"paragraph","text":"С терпеньем муки до конца"},{"type":"paragraph","text":"Она выдерживать готова…"},{"type":"paragraph","text":"Раз, как-то утром гневный муж"},{"type":"paragraph","text":"В сердцах занёс над нею руку, —"},{"type":"paragraph","text":"Лишь здесь решилась всё ж она"},{"type":"paragraph","text":"Свою тоску, всю сердца муку"},{"type":"paragraph","text":"Поверить сыну; в поздний час"},{"type":"paragraph","text":"Она, позвав его, сначала"},{"type":"paragraph","text":"Поколебалась, а затем"},{"type":"paragraph","text":"Заплакала и всё сказала:"},{"type":"paragraph","text":"« Вот кто разлучница моя,"},{"type":"paragraph","text":"Она его околдовала,"},{"type":"paragraph","text":"Она крушит меня тоской,"},{"type":"paragraph","text":"Моей любви ему, вишь, мало»!.."},{"type":"paragraph","text":"Сын всё узнал. Проснулись в нём"},{"type":"paragraph","text":"И к матери любовь, и злоба;"},{"type":"paragraph","text":"Всю ночь покоя не дала"},{"type":"paragraph","text":"Ему отцовская зазноба…"},{"type":"paragraph","text":"В его горячей голове"},{"type":"paragraph","text":"Кровавый замысел о мести —"},{"type":"paragraph","text":"Врасплох нагрянуть на куму"},{"type":"paragraph","text":"И положить её на месте…"},{"type":"paragraph","text":"Берёт он верных слуг своих,"},{"type":"paragraph","text":"Кинжал в серебряной оправе"},{"type":"paragraph","text":"И ночью, тайно ото всех,"},{"type":"paragraph","text":"Несётся к быстрой переправе…"},{"type":"paragraph","text":"IV."},{"type":"paragraph","text":"На постоялом нет огня;"},{"type":"paragraph","text":"Кума не спит… Она готова"},{"type":"paragraph","text":"К приезду княжьего сынка,"},{"type":"paragraph","text":"К приёму гостя дорогого…"},{"type":"paragraph","text":"Чу! Слышен говор голосов…"},{"type":"paragraph","text":"Вот по земле стучат копыта…"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Они… Через минуту дверь"},{"type":"paragraph","text":"Трещит, сдаётся и отбита…"},{"type":"paragraph","text":"Кума встаёт, зажгла свечу,"},{"type":"paragraph","text":"На шум идёт, полунагая,"},{"type":"paragraph","text":"Своих непрошенных гостей"},{"type":"paragraph","text":"С оплывшей свечкою встречая…"},{"type":"paragraph","text":"Но, видно, очи у кумы"},{"type":"paragraph","text":"Сильнее острого кинжала:"},{"type":"paragraph","text":"Взглянул сын княжий на неё"},{"type":"paragraph","text":"И словно к месту приковало…"},{"type":"paragraph","text":"Забыл, зачем сюда пришёл,"},{"type":"paragraph","text":"И вместо гневного проклятья"},{"type":"paragraph","text":"К колдунье руки протянул"},{"type":"paragraph","text":"Для поцелуя и объятья…"},{"type":"paragraph","text":"Такой волшебной красоты"},{"type":"paragraph","text":"Он не видал, живя на свете,"},{"type":"paragraph","text":"И понял, как отец-старик"},{"type":"paragraph","text":"Попал в расставленные сети…"},{"type":"paragraph","text":"А тут холоп ещё пристал"},{"type":"paragraph","text":"И, подстрекаем силой вражьей,"},{"type":"paragraph","text":"« Неплохо водки, — говорит, —"},{"type":"paragraph","text":"Сперва попробовать нам, княже»!"},{"type":"paragraph","text":"Глядят — дубовый стол накрыт,"},{"type":"paragraph","text":"Кума вином гостей обносит"},{"type":"paragraph","text":"И хлебом-солью закусить"},{"type":"paragraph","text":"С поклоном, улыбаясь, просит…"},{"type":"paragraph","text":"« Холопы! Эй, ступайте прочь!"},{"type":"paragraph","text":"Я позову, когда мне надо…"},{"type":"paragraph","text":"А вот, красавица, тебе"},{"type":"paragraph","text":"За угощение награда»!.."},{"type":"paragraph","text":"И в чашу перстень дорогой"},{"type":"paragraph","text":"Он опускает с изумрудом…"},{"type":"paragraph","text":"Всё по желанию кумы"},{"type":"paragraph","text":"Переменилось, словно чудом…"},{"type":"paragraph","text":"Поутру, на условный свист,"},{"type":"paragraph","text":"Ещё задолго до рассвета,"},{"type":"paragraph","text":"Вошли холопы, а кума"},{"type":"paragraph","text":"Сидит, царицей разодета"},{"type":"paragraph","text":"В парчовый, шитый сарафан;"},{"type":"paragraph","text":"А князь, забыв позор отцовский"},{"type":"paragraph","text":"Целует хитрую куму,"},{"type":"paragraph","text":"Опутан силою бесовской…"},{"type":"paragraph","text":"V."},{"type":"paragraph","text":"Гуляет по двору весна…"},{"type":"paragraph","text":"Про новый грех гуляют слухи…"},{"type":"paragraph","text":"Княгиня целый день одна;"},{"type":"paragraph","text":"Она не плачет, очи сухи…"},{"type":"paragraph","text":"Был сын у ней, но и того"},{"type":"paragraph","text":"Колдунья злая погубила:"},{"type":"paragraph","text":"Ни муж. Ни сын не устоял…"},{"type":"paragraph","text":"И вот холопа для посыла"},{"type":"paragraph","text":"Княгиня кличет. Слух ходил,"},{"type":"paragraph","text":"Что за зелёными лесами,"},{"type":"paragraph","text":"На Кудьме, есть один старик"},{"type":"paragraph","text":"Колдун. Он знается с бесами,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Он ей из злых наборных трав"},{"type":"paragraph","text":"Сварит смертельную отраву,"},{"type":"paragraph","text":"Тогда с разлучницей-кумой"},{"type":"paragraph","text":"Она расправится на славу…"},{"type":"paragraph","text":"« Введи ко мне его»! Старик"},{"type":"paragraph","text":"Явился в полночь на свиданье…"},{"type":"paragraph","text":"Его к княгине провели,"},{"type":"paragraph","text":"И с нею тайное шептанье"},{"type":"paragraph","text":"Недолго длилось… « Вот тебе, —"},{"type":"paragraph","text":"Сказал он, — склянка, из неё ты"},{"type":"paragraph","text":"Куму в вине и угости;"},{"type":"paragraph","text":"Тут зелье не простой работы;"},{"type":"paragraph","text":"Оно и в склянке-то кипит,"},{"type":"paragraph","text":"А с виду цвета золотого…"},{"type":"paragraph","text":"Пять капель, если отольёшь"},{"type":"paragraph","text":"Да выпить дашь, — и всё готово…"},{"type":"paragraph","text":"Прощай»! Ушёл седой колдун…"},{"type":"paragraph","text":"Княгиня всё с себя снимает,"},{"type":"paragraph","text":"На место шёлка и парчи"},{"type":"paragraph","text":"Наряд черницы надевает,"},{"type":"paragraph","text":"И в ночь, когда все в доме спят,"},{"type":"paragraph","text":"Полна и страхом, и тревогой,"},{"type":"paragraph","text":"Она выходит и пешком"},{"type":"paragraph","text":"Идёт знакомою дорогой…"},{"type":"paragraph","text":"VI."},{"type":"paragraph","text":"Кума от пришлого не прочь,"},{"type":"paragraph","text":"Всех просит: милости пожалуй!"},{"type":"paragraph","text":"Богат ли, беден — всё во двор,"},{"type":"paragraph","text":"На то ведь он и постоялый…"},{"type":"paragraph","text":"Старуха-странница пришла,"},{"type":"paragraph","text":"И ей покой ведь то же надо…"},{"type":"paragraph","text":"« Иду я, милая, с Москвы,"},{"type":"paragraph","text":"Хочу пробраться до Царьграда…"},{"type":"paragraph","text":"Пусти, родимая, меня,"},{"type":"paragraph","text":"Я ночку здесь переночую»…"},{"type":"paragraph","text":"« Переночуй! Вот поедим"},{"type":"paragraph","text":"Да выпьем чарочку-другую…"},{"type":"paragraph","text":"Садись сюда… Ты пьёшь, аль нет»?.."},{"type":"paragraph","text":"« Когда не пить! Грешна»… « Постой-ка,"},{"type":"paragraph","text":"Хмельной я бражки принесу»!.."},{"type":"paragraph","text":"Несёт, и началась попойка…"},{"type":"paragraph","text":"Налиты чарки до краёв…"},{"type":"paragraph","text":"« Отпей-ка»!.. « Нет, уж ты сначала»…"},{"type":"paragraph","text":"Кума хлебнула раз, другой"},{"type":"paragraph","text":"И, покатившись, закричала:"},{"type":"paragraph","text":"« Змея! Меня ты извела,"},{"type":"paragraph","text":"Да про себя-то позабыла…"},{"type":"paragraph","text":"Недолго жить тебе! Смотри…"},{"type":"paragraph","text":"Одна у нас с тобой могила»!.."},{"type":"paragraph","text":"Едва сказала, старый князь"},{"type":"paragraph","text":"Вбежал, и не прошло минуты,"},{"type":"paragraph","text":"Как в горло белое жены"},{"type":"paragraph","text":"Впился он, словно коршун лютый,"},{"type":"paragraph","text":"И придушил… За ним вослед"},{"type":"paragraph","text":"Ворвался сын… Силён и молод,"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Боролся долго он с отцом"},{"type":"paragraph","text":"И рядом с матерью заколот…"},{"type":"paragraph","text":"« Тащите в реку их! Пускай"},{"type":"paragraph","text":"Несёт, куда захочет»… Тупо"},{"type":"paragraph","text":"Глядит на слуг безумный князь,"},{"type":"paragraph","text":"На охладевшие три трупа…"},{"type":"paragraph","text":"Тела оттащены в Оку,"},{"type":"paragraph","text":"Как вдруг над сыном и женою"},{"type":"paragraph","text":"Зажглись всё яркие огни,"},{"type":"paragraph","text":"Сверкая радугой цветною;"},{"type":"paragraph","text":"А над кумою на ветру"},{"type":"paragraph","text":"Заколебалось, словно знамя,"},{"type":"paragraph","text":"Кидая зарево кругом,"},{"type":"paragraph","text":"Нечистое и злое пламя…"},{"type":"paragraph","text":"Холопы вскрикнули и прочь;"},{"type":"paragraph","text":"Но князю страх совсем не ведом,"},{"type":"paragraph","text":"И кто-то шепчет всё ему:"},{"type":"paragraph","text":"« За ними, князь! За ними следом»!.."},{"type":"paragraph","text":"И вот, вдоль берега Оки,"},{"type":"paragraph","text":"Он мчится узкою тропою,"},{"type":"paragraph","text":"А позади за ним спешат"},{"type":"paragraph","text":"Холопы робкою толпою…"},{"type":"paragraph","text":"VII."},{"type":"paragraph","text":"До устья добрались тела,"},{"type":"paragraph","text":"Но вдруг на миг остановились"},{"type":"paragraph","text":"И, вверх по Волге повернув,"},{"type":"paragraph","text":"Огнями снова засветились…"},{"type":"paragraph","text":"Дивится князь, и в страхе он"},{"type":"paragraph","text":"Не в силах вымолвить ни слова;"},{"type":"paragraph","text":"Назад хотел бы повернуть"},{"type":"paragraph","text":"Аргамака он молодого,"},{"type":"paragraph","text":"Но тот, не слушая удил,"},{"type":"paragraph","text":"Храпит раздутыми ноздрями"},{"type":"paragraph","text":"И мчится, голову сломя,"},{"type":"paragraph","text":"Вдоль Волги, следом за огнями…"},{"type":"paragraph","text":"Перекреститься?! Но сложить"},{"type":"paragraph","text":"Не может он креста святого,"},{"type":"paragraph","text":"Себя не в силах оградить"},{"type":"paragraph","text":"Он наважденья духа злого;"},{"type":"paragraph","text":"О подорожные кусты"},{"type":"paragraph","text":"Князь рвёт богатую одежду,"},{"type":"paragraph","text":"Аргамака остановить"},{"type":"paragraph","text":"Он потерял уже надежду…"},{"type":"paragraph","text":"Конь мчится, гриву распустив,"},{"type":"paragraph","text":"И, полон бешеной отваги,"},{"type":"paragraph","text":"Песками, чащею лесной,"},{"type":"paragraph","text":"Не разбирая, где овраги,"},{"type":"paragraph","text":"Всё дальше мчится… Путь ночной"},{"type":"paragraph","text":"Грозит бедою неминучей,"},{"type":"paragraph","text":"И вдруг умаявшийся конь"},{"type":"paragraph","text":"Оборвался над самой кручей…"},{"type":"paragraph","text":"Огни погасли, а тела"},{"type":"paragraph","text":"Пошли на дно реки глубокой;"},{"type":"paragraph","text":"И слышит помертвевший князь"},{"type":"paragraph","text":"Глухой и будто издалёка"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Какой-то голос: « Ты злодей,"},{"type":"paragraph","text":"Сыноубийца, знай отныне,"},{"type":"paragraph","text":"Что близок твой последний час!.."},{"type":"paragraph","text":"Твоя могила здесь, в пучине…"},{"type":"paragraph","text":"Тебе пощады не дадут,"},{"type":"paragraph","text":"Умрёшь, как зверь, без покаянья,"},{"type":"paragraph","text":"И тело грешное твоё"},{"type":"paragraph","text":"Отдастся всем на поруганье»!"},{"type":"paragraph","text":"В лесу, направо от него,"},{"type":"paragraph","text":"Справляют чьи-то похороны,"},{"type":"paragraph","text":"Сменяют жалобный напев"},{"type":"paragraph","text":"Людские выкрики и стоны;"},{"type":"paragraph","text":"Протяжный раздаётся вой,"},{"type":"paragraph","text":"Зубовный скрежет, визг и хохот;"},{"type":"paragraph","text":"Сверкнула молния вдали,"},{"type":"paragraph","text":"И грома перекатный грохот"},{"type":"paragraph","text":"Всё ближе катится… Рекой"},{"type":"paragraph","text":"Несётся буря, вал вздымая,"},{"type":"paragraph","text":"И злобно мечется в лесу,"},{"type":"paragraph","text":"Дубы с корнями вырывая…"},{"type":"paragraph","text":"Крутятся листья на ветру,"},{"type":"paragraph","text":"Что снег зимой в большую заметь,"},{"type":"paragraph","text":"Ударил гром у самых ног,"},{"type":"paragraph","text":"И рухнул князь, теряя память…"},{"type":"paragraph","text":"Холопы в страхе за него,"},{"type":"paragraph","text":"Везут его в посёлок ближний,"},{"type":"paragraph","text":"А утром, бледный и больной,"},{"type":"paragraph","text":"Старик ворочается в Нижний…"},{"type":"paragraph","text":"VIII."},{"type":"paragraph","text":"Холопы верные молчат, —"},{"type":"paragraph","text":"У них и преданность холопья;"},{"type":"paragraph","text":"А если скажут, есть на них"},{"type":"paragraph","text":"Расправа: плети и ослопья (дубинки, палочье)…"},{"type":"paragraph","text":"Сам князь и верит им, и нет, —"},{"type":"paragraph","text":"То сыплет медными деньгами,"},{"type":"paragraph","text":"То, грозен, аки лютый лев,"},{"type":"paragraph","text":"Грозит плетьми и батогами…"},{"type":"paragraph","text":"Но дивно всем, что сын пропал"},{"type":"paragraph","text":"В ту ночь, как злилась непогода,"},{"type":"paragraph","text":"И где княгиня, где кума,"},{"type":"paragraph","text":"И что нахмурен воевода…"},{"type":"paragraph","text":"Ведь слухи исподволь в народ"},{"type":"paragraph","text":"Проникнут, поздно или рано;"},{"type":"paragraph","text":"Они из Нижнего в Москву"},{"type":"paragraph","text":"Пробрались до царя Ивана…"},{"type":"paragraph","text":"Царь гонит спешного гонца"},{"type":"paragraph","text":"С своею грамотою царской:"},{"type":"paragraph","text":"« Ответствуй, где жена твоя"},{"type":"paragraph","text":"И молодой сынок боярский»!.."},{"type":"paragraph","text":"Старик гонцу передаёт"},{"type":"paragraph","text":"Своё ответное посланье:"},{"type":"paragraph","text":"« Царь-государь! Жена моя"},{"type":"paragraph","text":"Ушла в далёкое скитанье"},{"type":"paragraph","text":"К святым местам. Вот ровно год"},{"type":"paragraph","text":"Никто не знает, что с ней сталось…"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"А сын охотился в лесу,"},{"type":"paragraph","text":"Да лихо с сыном повстречалось:"},{"type":"paragraph","text":"Медведь сломал»… Ответа нет…"},{"type":"paragraph","text":"Князь ждёт решения со страхом;"},{"type":"paragraph","text":"Как мученик, в своём дому"},{"type":"paragraph","text":"Живёт затворником, монахом…"},{"type":"paragraph","text":"Забыты прежние пиры,"},{"type":"paragraph","text":"Попойки, россказни, охота;"},{"type":"paragraph","text":"Грехам прощенье умолить, —"},{"type":"paragraph","text":"О том одна его забота…"},{"type":"paragraph","text":"Он нищим деньги раздаёт,"},{"type":"paragraph","text":"Захожим людям нет обиды,"},{"type":"paragraph","text":"В дому попы и чернецы"},{"type":"paragraph","text":"Поют по мёртвым панихиды…"},{"type":"paragraph","text":"А князь по городским церквам"},{"type":"paragraph","text":"Перед святыми образами"},{"type":"paragraph","text":"Возносит Господу мольбы"},{"type":"paragraph","text":"И плачет горькими слезами…"},{"type":"paragraph","text":"IX."},{"type":"paragraph","text":"Пришла зима… Воскресный день…"},{"type":"paragraph","text":"Князь у заутрени в соборе"},{"type":"paragraph","text":"Лежит на каменных плитах,"},{"type":"paragraph","text":"Своё оплакивая горе…"},{"type":"paragraph","text":"Сюда, в собор, пришла толпа"},{"type":"paragraph","text":"Искать покоя и отрады,"},{"type":"paragraph","text":"Под эти своды, где горят"},{"type":"paragraph","text":"Неугасимые лампады,"},{"type":"paragraph","text":"Где хор и причет в ранний час"},{"type":"paragraph","text":"Свершают стройное служенье"},{"type":"paragraph","text":"И к лику Господа несут"},{"type":"paragraph","text":"С толпой молитвы и куренья…"},{"type":"paragraph","text":"Вдруг слышно ржание коней"},{"type":"paragraph","text":"И конских ног зловещий топот…"},{"type":"paragraph","text":"Мелькнули всадники… Идут…"},{"type":"paragraph","text":"В толпе пронёсся тихий ропот…"},{"type":"paragraph","text":"От страха клир не в силах петь,"},{"type":"paragraph","text":"И, как волков голодных стая,"},{"type":"paragraph","text":"Толпа опричников вошла,"},{"type":"paragraph","text":"Кнутом дорогу расчищая,"},{"type":"paragraph","text":"И прямо к князю: « Царь велел"},{"type":"paragraph","text":"Схватить тебя без промедленья,"},{"type":"paragraph","text":"Из наших рук приемлешь ты"},{"type":"paragraph","text":"Себя достойные мученья…"},{"type":"paragraph","text":"Вставай»!.. Церковная толпа"},{"type":"paragraph","text":"Упала ниц, дрожа от страха;"},{"type":"paragraph","text":"Но воеводу не страшат"},{"type":"paragraph","text":"Ни место лобное, ни плаха:"},{"type":"paragraph","text":"« Несу вину свою царю"},{"type":"paragraph","text":"И лютой казни я не трушу!"},{"type":"paragraph","text":"Берите… Богу предаю"},{"type":"paragraph","text":"Стыдом истерзанную душу»!.."},{"type":"paragraph","text":"Одежды мигом сорваны,"},{"type":"paragraph","text":"И князя с гиком, на аркане,"},{"type":"paragraph","text":"Влекут из храма на мороз;"},{"type":"paragraph","text":"Связав, полунагого в сани"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"Бросают… Конная толпа"},{"type":"paragraph","text":"Летит вперёд с весёлым криком,"},{"type":"paragraph","text":"Разносит воеводский дом,"},{"type":"paragraph","text":"Холопов бьёт, в веселье диком"},{"type":"paragraph","text":"Пьянея, вышибает дно"},{"type":"paragraph","text":"И пьёт из воеводских бочек;"},{"type":"paragraph","text":"Несётся Нижним, по пути"},{"type":"paragraph","text":"Всех раздевая до сорочек,"},{"type":"paragraph","text":"И дальше, из городу вон,"},{"type":"paragraph","text":"Не смущена дорогой долгой,"},{"type":"paragraph","text":"Оку проехала и вот,"},{"type":"paragraph","text":"Сугробы разметая, Волгой"},{"type":"paragraph","text":"Летит… Захватывает дух"},{"type":"paragraph","text":"От этой бешеной погони…"},{"type":"paragraph","text":"У князя в жилах стынет кровь;"},{"type":"paragraph","text":"Вдруг слышит: « Стой»! — и стали кони…"},{"type":"paragraph","text":"« Что стали вы»?! « Коней поить»!"},{"type":"paragraph","text":"Глядит, а от него направо"},{"type":"paragraph","text":"Горят два радужных огня"},{"type":"paragraph","text":"И меду них один кровавый…"},{"type":"paragraph","text":"« Нет! Не коням ту воду пить,"},{"type":"paragraph","text":"А мне!.. Я жду желанной смерти,"},{"type":"paragraph","text":"И той же мерою, что я"},{"type":"paragraph","text":"Другим возмерил, мне возмерьте»!.."},{"type":"paragraph","text":"К саням опричник подошёл,"},{"type":"paragraph","text":"Взмахнул секирою широкой,"},{"type":"paragraph","text":"Ударил раз, — и голова"},{"type":"paragraph","text":"Слетела прямо в снег глубокий…"},{"type":"paragraph","text":"« Рубите прорубь»!.. На реке"},{"type":"paragraph","text":"Работа быстро закипела;"},{"type":"paragraph","text":"Под синим льдом нашло себе"},{"type":"paragraph","text":"Могилу княжеское тело…"},{"type":"paragraph","text":"Едва покончили они"},{"type":"paragraph","text":"С своею страшною расправой, —"},{"type":"paragraph","text":"Над трупом князя в тот же миг"},{"type":"paragraph","text":"Поднялся вдруг огонь кровавый…"},{"type":"paragraph","text":"Огни скрутились в два столба,"},{"type":"paragraph","text":"Столбы сплелись между собой,"},{"type":"paragraph","text":"И словно тешились они"},{"type":"paragraph","text":"Своей воздушною борьбой…"},{"type":"paragraph","text":"Всё разгораясь, те столбы"},{"type":"paragraph","text":"Кидались злобно друг на друга…"},{"type":"paragraph","text":"Толпа опричников стоит,"},{"type":"paragraph","text":"Глядит, бледнеет от испуга;"},{"type":"paragraph","text":"Садятся быстро на коней"},{"type":"paragraph","text":"И в страхе, не промолвив слова,"},{"type":"paragraph","text":"С добычей ценною своей"},{"type":"paragraph","text":"Спешат от места проклятого…"},{"type":"paragraph","text":"X."},{"type":"paragraph","text":"Москва… Народ со всех концов"},{"type":"paragraph","text":"Бежит. На городских раскатах"},{"type":"paragraph","text":"Гудят везде колокола,"},{"type":"paragraph","text":"Сзывая бедных и богатых…"},{"type":"paragraph","text":"Спешат на казнь… Сегодня день,"},{"type":"paragraph","text":"Когда получит воздаянье"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"Старик-боярин, бывший князь,"},{"type":"paragraph","text":"За небывалые деянья…"},{"type":"paragraph","text":"Докуку праздничного дня"},{"type":"paragraph","text":"Толпа вознаградит с избытком,"},{"type":"paragraph","text":"И хочет знать она, каким"},{"type":"paragraph","text":"Преступника подвергнут пыткам;"},{"type":"paragraph","text":"Не знает, суждено ль ему"},{"type":"paragraph","text":"На площади четвертованье,"},{"type":"paragraph","text":"Иль, может, смилуется царь"},{"type":"paragraph","text":"И переменит истязанье…"},{"type":"paragraph","text":"Вот показались бирючи,"},{"type":"paragraph","text":"Народ конями раздвигая"},{"type":"paragraph","text":"И громко отповедь свою"},{"type":"paragraph","text":"О лютой казни возвещая:"},{"type":"paragraph","text":"« Идите все смотреть сюда!"},{"type":"paragraph","text":"Глядите, как по правде царской"},{"type":"paragraph","text":"Казнён за разные вины"},{"type":"paragraph","text":"Убийца, выродок боярский!.."},{"type":"paragraph","text":"На перекрёстке по ночам"},{"type":"paragraph","text":"Он речи вёл с лукавым бесом!"},{"type":"paragraph","text":"Жена-красавица и сын"},{"type":"paragraph","text":"Погибли по его кудесам!.."},{"type":"paragraph","text":"Он принял мзду за все дела,"},{"type":"paragraph","text":"Что силой учинял бесовской,"},{"type":"paragraph","text":"И царь казнил его… Иди,"},{"type":"paragraph","text":"Смотри сюда, народ московский»!.."},{"type":"paragraph","text":"И над толпою высоко"},{"type":"paragraph","text":"Заколебалась вдруг на пике"},{"type":"paragraph","text":"В крови засохшей голова"},{"type":"paragraph","text":"Нижегородского владыки…"},{"type":"paragraph","text":"1882 г."},{"type":"paragraph","text":"Известный драматург И. В. Шпажинский на сюжет этой поэмы в 1884 г. написал трагедию « Чародейка», а позднее, в 1886 г., создал либретто для одноимённой оперы П. И. Чайковского."},{"type":"paragraph","text":"Источник текста: Садовников Д. Н. «Избранные произведения», Саратов, « Приволжское книжное издательство», 1989 г."}]}]}