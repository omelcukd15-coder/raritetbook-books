{"id":"mikhalovskiy-ferdinand-dranmor","slug":"mikhalovskiy-ferdinand-dranmor","title":"Фердинанд Дранмор","altTitles":[],"author":"Дмитрий Лаврентьевич Михаловский","authorShort":"Д. Л. Михаловский","authorSlug":"mikhalovskiy","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1896","editionYear":"1896","description":"Фердинанд Дранмор","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A4%D0%B5%D1%80%D0%B4%D0%B8%D0%BD%D0%B0%D0%BD%D0%B4_%D0%94%D1%80%D0%B0%D0%BD%D0%BC%D0%BE%D1%80_%28%D0%9C%D0%B8%D1%85%D0%B0%D0%BB%D0%BE%D0%B2%D1%81%D0%BA%D0%B8%D0%B9%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1896)","downloadAllowed":true,"fb2Url":"/archive/books/mikhalovskiy/mikhalovskiy-ferdinand-dranmor/original.fb2","coverUrl":"/archive/books/mikhalovskiy/mikhalovskiy-ferdinand-dranmor/cover.webp","stats":{"chaptersCount":2,"wordsCount":449,"charsCount":3130,"readingMinutes":3},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Фердинанд Дранмор"},{"type":"paragraph","text":"----------------------------------------------------------------------------"},{"type":"paragraph","text":"Поэты 1880—1890-х годов."},{"type":"paragraph","text":"Библиотека поэта. Большая серия. Второе издание"},{"type":"paragraph","text":"Л., «Советский писатель»."},{"type":"paragraph","text":"Составление, подготовка текста, биографические справки и примечания"},{"type":"paragraph","text":"Л. К. Долгополова и Л. А. Николаевой"},{"type":"paragraph","text":"----------------------------------------------------------------------------"},{"type":"paragraph","text":"Содержание"},{"type":"paragraph","text":"12-13."},{"type":"paragraph","text":"«Я не могу на колени…»"},{"type":"paragraph","text":"«В мрачном пространстве собора…»"},{"type":"paragraph","text":"12-13."},{"type":"paragraph","text":"Я не могу на колени"},{"type":"paragraph","text":"Падать и в прах повергаться"},{"type":"paragraph","text":"Пред этим образом скорбным:"},{"type":"paragraph","text":"Он не дает мне надежды,"},{"type":"paragraph","text":"В душу отрады не льет."},{"type":"paragraph","text":"Что мне до веры наивной,"},{"type":"paragraph","text":"Веры людей в искупленье,"},{"type":"paragraph","text":"Если мне внутренний голос"},{"type":"paragraph","text":"Шепчет, что «не был бог распят"},{"type":"paragraph","text":"И пригвожден ко кресту»?"},{"type":"paragraph","text":"О Иисус! Я не верю,"},{"type":"paragraph","text":"Что ты был бог, но я верую,"},{"type":"paragraph","text":"Что в твоем сердце горело"},{"type":"paragraph","text":"Пламя любви всеобъемлющей,"},{"type":"paragraph","text":"Божеской, вечной любви!"},{"type":"paragraph","text":"И глубоко пред тобою"},{"type":"paragraph","text":"В этот торжественный час"},{"type":"paragraph","text":"Я преклонился, Спаситель,"},{"type":"paragraph","text":"Как пред подвижником духа,"},{"type":"paragraph","text":"Плоть покорившим свою."},{"type":"paragraph","text":"Воздал хвалу я любви всепрощающей,"},{"type":"paragraph","text":"Силе духовной твоей, —"},{"type":"paragraph","text":"Я, истомленный и тающий"},{"type":"paragraph","text":"В пламени мелких страстей…"},{"type":"paragraph","text":"В мрачном пространстве собора"},{"type":"paragraph","text":"Место одно лишь светилось:"},{"type":"paragraph","text":"Там, где в терновом венце"},{"type":"paragraph","text":"Распятый мира Спаситель"},{"type":"paragraph","text":"Голову долу склонил;"},{"type":"paragraph","text":"Там, где страдальца великого"},{"type":"paragraph","text":"Патеры в женских одеждах,"},{"type":"paragraph","text":"Дети в дыму фимиама"},{"type":"paragraph","text":"Культом языческим чтут."},{"type":"paragraph","text":"Детские жертвы приносят,"},{"type":"paragraph","text":"Чтоб угодить небесам,"},{"type":"paragraph","text":"Помпой обряда земного"},{"type":"paragraph","text":"Сделав из дома Христова"},{"type":"paragraph","text":"Идоложертвенный храм."},{"type":"paragraph","text":"Музыка храм наполняла."},{"type":"paragraph","text":"Вслед за торжественно-грозным"},{"type":"paragraph","text":"Голосом труб раздавались,"},{"type":"paragraph","text":"С плачущих струн вылетая,"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"Гимны любви;"},{"type":"paragraph","text":"Арфы печальные звуки"},{"type":"paragraph","text":"Ввысь уносились под своды"},{"type":"paragraph","text":"К статуям ангелов светлых,"},{"type":"paragraph","text":"Сверху смотревшим с улыбкой"},{"type":"paragraph","text":"На распростертый народ;"},{"type":"paragraph","text":"Там замирали и снова"},{"type":"paragraph","text":"С неба на землю скользили,"},{"type":"paragraph","text":"Преображалися в слезы"},{"type":"paragraph","text":"И как бальзам драгоценный"},{"type":"paragraph","text":"Капля по капле вливались"},{"type":"paragraph","text":"В раны истерзанных душ."},{"type":"paragraph","text":"1875 (?)"},{"type":"paragraph","text":"ПРИМЕЧАНИЯ"},{"type":"paragraph","text":"СОКРАЩЕНИЯ, ПРИНЯТЫЕ В ПРИМЕЧАНИЯХ"},{"type":"paragraph","text":"BE — «Вестник Европы»."},{"type":"paragraph","text":"ВИ — «Всемирная иллюстрация»."},{"type":"paragraph","text":"ГПБ — Рукописный отдел Государственной публичной библиотеки им. М. Е."},{"type":"paragraph","text":"Салтыкова-Щедрина (Ленинград)."},{"type":"paragraph","text":"ЖдВ — «Журнал для всех»."},{"type":"paragraph","text":"ЖО — «Живописное обозрение»."},{"type":"paragraph","text":"КнНед — «Книжки „Недели“»."},{"type":"paragraph","text":"ЛБ — Рукописный отдел Государственной библиотеки СССР им. В. И. Ленина."},{"type":"paragraph","text":"ЛН — «Литературное наследство»."},{"type":"paragraph","text":"ЛПкН — «Ежемесячные литературные приложения к „Ниве“»."},{"type":"paragraph","text":"МБ — «Мир божий»."},{"type":"paragraph","text":"Набл. — «Наблюдатель»."},{"type":"paragraph","text":"НВ — «Новое время»."},{"type":"paragraph","text":"ОЗ — «Отечественные записки»."},{"type":"paragraph","text":"ПД — Рукописный отдел Института русской литературы (Пушкинский дом) АН"},{"type":"paragraph","text":"СССР."},{"type":"paragraph","text":"ПЖ — «Петербургская жизнь»."},{"type":"paragraph","text":"РБ — «Русское богатство»."},{"type":"paragraph","text":"РВ — «Русский вестник»."},{"type":"paragraph","text":"РМ — «Русская мысль»."},{"type":"paragraph","text":"РО — «Русское обозрение»."},{"type":"paragraph","text":"СВ — «Северный вестник»."},{"type":"paragraph","text":"СМ — «Современный мир»."},{"type":"paragraph","text":"Д. Л. Михаловский"},{"type":"paragraph","text":"ИПиОС — Иностранные поэты в переводах и оригинальные стихотворения Д."},{"type":"paragraph","text":"Л. Михаловского, тт. 1-2, СПб., 1896."},{"type":"paragraph","text":"Фердинанд Дранмор"},{"type":"paragraph","text":"12-13. ЛН., т. 51-52, М., 1949, с. 398. Автограф — в письме к Н. А."},{"type":"paragraph","text":"Некрасову от 15 августа 1875 г., в котором речь идет о поэме «Вальс демонов»"},{"type":"paragraph","text":"как «нецензурной, хотя по местам весьма поэтической» (ПД). Фердинанд Дранмор"},{"type":"paragraph","text":"— псевдоним швейцарского поэта Людвига Фердинанда фон Шмида (1823—1888),"},{"type":"paragraph","text":"писавшего на немецком языке. Михаловскому принадлежит большое количество"},{"type":"paragraph","text":"переводов его произведений."}]}]}