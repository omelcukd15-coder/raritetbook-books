{"id":"shuf-gibel-shemakhi","slug":"shuf-gibel-shemakhi","title":"Гибель Шемахи","altTitles":[],"author":"Владимир Александрович Шуф","authorShort":"В. А. Шуф","authorSlug":"shuf","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1902","editionYear":"1902","description":"Гибель Шемахи","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%93%D0%B8%D0%B1%D0%B5%D0%BB%D1%8C_%D0%A8%D0%B5%D0%BC%D0%B0%D1%85%D0%B8_%28%D0%A8%D1%83%D1%84%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1902)","downloadAllowed":true,"fb2Url":"/archive/books/shuf/shuf-gibel-shemakhi/original.fb2","coverUrl":"/archive/books/shuf/shuf-gibel-shemakhi/cover.webp","stats":{"chaptersCount":12,"wordsCount":2584,"charsCount":16162,"readingMinutes":14},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Гибель Шемахи"},{"type":"paragraph","text":"(Сальфа)"},{"type":"paragraph","text":"Поэма"},{"type":"paragraph","text":"Оригинал здесь — http://v-shuf.narod.ru/"},{"type":"paragraph","text":"ПОСВЯЩЕНЬЕ"},{"type":"paragraph","text":"Художнику"},{"type":"paragraph","text":"И. А. Владимирову."},{"type":"paragraph","text":"Товарищ в странствии далеком,"},{"type":"paragraph","text":"Мой спутник в горестном краю,"},{"type":"paragraph","text":"Постигнутом печальным роком!"},{"type":"paragraph","text":"Я для тебя теперь пою."},{"type":"paragraph","text":"Поэму выслушай мою…"},{"type":"paragraph","text":"Ряд пережитых впечатлений"},{"type":"paragraph","text":"Припомнишь ты и передашь"},{"type":"paragraph","text":"В минуты светлых вдохновений."},{"type":"paragraph","text":"Бери же кисть и карандаш,"},{"type":"paragraph","text":"Пиши картину разрушений,"},{"type":"paragraph","text":"Картину бед, — виденье зла,"},{"type":"paragraph","text":"Какой в те дни она была,"},{"type":"paragraph","text":"Когда тревожен и печален"},{"type":"paragraph","text":"Ты проходил среди развалин."},{"type":"paragraph","text":"Не могут передать стихи"},{"type":"paragraph","text":"Конец ужасный Шемахи…"},{"type":"paragraph","text":"Он был странней восточной сказки,"},{"type":"paragraph","text":"Мое перо бессильно тут, —"},{"type":"paragraph","text":"Лишь только живопись и краски"},{"type":"paragraph","text":"Картину зла передадут."},{"type":"paragraph","text":"Среди высот, где гор окрестных"},{"type":"paragraph","text":"Белеют снежные верхи,"},{"type":"paragraph","text":"Рассыпав рой в долинах тесных"},{"type":"paragraph","text":"Разнообразных и прелестных"},{"type":"paragraph","text":"Домов роскошной Шемахи."},{"type":"paragraph","text":"Меж тополей, благоухая,"},{"type":"paragraph","text":"Весенний персик там цветет,"},{"type":"paragraph","text":"В садах ликующего края,"},{"type":"paragraph","text":"В тени серебряных высот."},{"type":"paragraph","text":"От миpa снегом и туманом"},{"type":"paragraph","text":"Цветущий город огражден,"},{"type":"paragraph","text":"Но и в дали все служит он"},{"type":"paragraph","text":"Приманкой шумным караванам,"},{"type":"paragraph","text":"И за верблюдом вслед верблюд"},{"type":"paragraph","text":"К нему спешат, к нему идут,"},{"type":"paragraph","text":"Пестреют вьюки их цветные —"},{"type":"paragraph","text":"Товар из Пеpcии, России,"},{"type":"paragraph","text":"И Шемаха им шлет дары, —"},{"type":"paragraph","text":"Свои шелка, свои ковры."},{"type":"paragraph","text":"Здесь в котловине гор глубокой,"},{"type":"paragraph","text":"Лежит, ленива и тиха, —"},{"type":"paragraph","text":"Царица давняя Востока,"},{"type":"paragraph","text":"Родная персам Шемаха."},{"type":"paragraph","text":"Дома причудливые немы,"},{"type":"paragraph","text":"Объяты негою гаремы"},{"type":"paragraph","text":"С их заповедной красотой."},{"type":"paragraph","text":"Лишь солнце, выйдя в знойно блеске,"},{"type":"paragraph","text":"Бросает взор свой золотой"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"На расписные арабески,"},{"type":"paragraph","text":"В окно с решеткою витой"},{"type":"paragraph","text":"И на узорные балконы,"},{"type":"paragraph","text":"Где прихотливых персов жены"},{"type":"paragraph","text":"Среди забав, среди сластей"},{"type":"paragraph","text":"Скучают в праздности своей."},{"type":"paragraph","text":"К чему им роскошь их наряда,"},{"type":"paragraph","text":"Зачем им жемчуг, бирюза?"},{"type":"paragraph","text":"Им драгоценностей не надо, —"},{"type":"paragraph","text":"Ничьи не видят их глаза,"},{"type":"paragraph","text":"И лишь завистливо подруги"},{"type":"paragraph","text":"Их пересудят на досуге."},{"type":"paragraph","text":"Но звуки бубна и зурны"},{"type":"paragraph","text":"Несутся, трепета полны…"},{"type":"paragraph","text":"И шемаханок рой прекрасный"},{"type":"paragraph","text":"Танцует плавно и легко,"},{"type":"paragraph","text":"Короткий край чухи атласной"},{"type":"paragraph","text":"Откинув ножкою в трико*."},{"type":"paragraph","text":"Тюрбаны блещут, рдеют розы,"},{"type":"paragraph","text":"Восточной негой дышат позы"},{"type":"paragraph","text":"И кто бы не был увлечен"},{"type":"paragraph","text":"Красою шемаханских жен?"},{"type":"paragraph","text":"Где величавы и суровы"},{"type":"paragraph","text":"Гор ледяных горят оковы,"},{"type":"paragraph","text":"В ауле жил, влача свой век,"},{"type":"paragraph","text":"Татарин горский Али-бек."},{"type":"paragraph","text":"Али привык давно к пустыне"},{"type":"paragraph","text":"И полюбил ее красу,"},{"type":"paragraph","text":"Хотя родился он в Ак-Су,"},{"type":"paragraph","text":"В цветущей, радостной долине."},{"type":"paragraph","text":"Там край беспечный не суров,"},{"type":"paragraph","text":"Там в роще тутовых дерев,"},{"type":"paragraph","text":"Разлившись четырьмя ручьями,"},{"type":"paragraph","text":"Ак-Су бежит, — резва, дика,"},{"type":"paragraph","text":"Кавказа быстрая река,"},{"type":"paragraph","text":"В горах рожденная снегами, —"},{"type":"paragraph","text":"Бежит играя меж камней."},{"type":"paragraph","text":"Плетни и сакли жмутся к ней,"},{"type":"paragraph","text":"Шумит ветвями тополь старый,"},{"type":"paragraph","text":"И сад свой мирные татары,"},{"type":"paragraph","text":"Как предки их, по старине,"},{"type":"paragraph","text":"Растят и холят в тишине."},{"type":"paragraph","text":"Но чужд был сердцу Али-бека"},{"type":"paragraph","text":"Их скромный быт и мирный труд."},{"type":"paragraph","text":"Давно, давно его влекут"},{"type":"paragraph","text":"Наезды вольные абрека,"},{"type":"paragraph","text":"Опасный путь, кровавый бой, —"},{"type":"paragraph","text":"Игра отважная судьбой."},{"type":"paragraph","text":"Он редкий гость среди аула."},{"type":"paragraph","text":"Он на коне и в дождь, и в зной,"},{"type":"paragraph","text":"Под черной буркой блещет дуло"},{"type":"paragraph","text":"Его винтовки нарезной."},{"type":"paragraph","text":"Кинжал серебряный весь в черни,"},{"type":"paragraph","text":"В лохмотьях шелковый бешмет…"},{"type":"paragraph","text":"И каравану в час вечерний"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"При встрече с ним спасенья нет!"},{"type":"paragraph","text":"«Алла, Алла!»… блеснули шашки,"},{"type":"paragraph","text":"И выстрел грянул меж камней,"},{"type":"paragraph","text":"Где вьется путь, крутой и тяжкий,"},{"type":"paragraph","text":"Над синей бездной пропастей."},{"type":"paragraph","text":"Далеко конные чапары,"},{"type":"paragraph","text":"Их пост казачий задремал,"},{"type":"paragraph","text":"И в Закавказье, между скал,"},{"type":"paragraph","text":"Абрек хранить обычай старый, —"},{"type":"paragraph","text":"Разбой, засаду и наезд"},{"type":"paragraph","text":"Во тьме ночной, при блеске звезд."},{"type":"paragraph","text":"И робкий путник смотрит в страхе,"},{"type":"paragraph","text":"Встречая всадника в папахе."},{"type":"paragraph","text":"Но Али-бек теперь его"},{"type":"paragraph","text":"В ущелье горном не нагонит,"},{"type":"paragraph","text":"Его тоска в пустыню гонит."},{"type":"paragraph","text":"О, Сальфа, Сальфа! Для чего"},{"type":"paragraph","text":"Тебя джигит случайно встретил?"},{"type":"paragraph","text":"Встает, пленителен и светел,"},{"type":"paragraph","text":"Твой чудный образ перед ним…"},{"type":"paragraph","text":"Пренебрежен и нелюбим"},{"type":"paragraph","text":"Он персиянкой молодою."},{"type":"paragraph","text":"Он с ней на веки разделен"},{"type":"paragraph","text":"Шиитов старою враждою…"},{"type":"paragraph","text":"Она богата, — беден он!"},{"type":"paragraph","text":"Вдова прекрасная Зейнала"},{"type":"paragraph","text":"Его не видела, не знала;"},{"type":"paragraph","text":"Что значит горец ей простой,"},{"type":"paragraph","text":"Презренный персами татарин?"},{"type":"paragraph","text":"Но он был сердцем благодарен"},{"type":"paragraph","text":"Ей за единый ласки взгляд,"},{"type":"paragraph","text":"Когда, два месяца назад,"},{"type":"paragraph","text":"Ее и слуг в горах, над бездной"},{"type":"paragraph","text":"Он проводил, арбу храня…"},{"type":"paragraph","text":"Увы! Он с этого же дня"},{"type":"paragraph","text":"Томился страстью бесполезной."},{"type":"paragraph","text":"Как ясный луч, как отблеск звездный"},{"type":"paragraph","text":"Взгляд шемаханки молодой"},{"type":"paragraph","text":"Горел пред ним, грозя бедой."},{"type":"paragraph","text":"Ах, Сальфа нежная — прекрасна!"},{"type":"paragraph","text":"Роскошной прихоти дитя,"},{"type":"paragraph","text":"Она прошла пред ним, блестя"},{"type":"paragraph","text":"Своей одеждою атласной."},{"type":"paragraph","text":"Тюрбан в алмазах под чадрой"},{"type":"paragraph","text":"Сверкал причудливой игрой,"},{"type":"paragraph","text":"Мерцали серьги и запястья."},{"type":"paragraph","text":"Как светлый сон любви и счастья,"},{"type":"paragraph","text":"Как роза Персии, она"},{"type":"paragraph","text":"Была томна, была нежна…"},{"type":"paragraph","text":"Ее уста благоухали,"},{"type":"paragraph","text":"И тонкий шелк не Шемаха ли"},{"type":"paragraph","text":"Впряла в убор ее волос,"},{"type":"paragraph","text":"В тень шелковистых, черных кос?"},{"type":"paragraph","text":"У дома Сальфы, где коврами"},{"type":"paragraph","text":"Роскошно убран комнат ряд,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Бродил, бывало, вечерами"},{"type":"paragraph","text":"Али, надеясь встретить взгляд"},{"type":"paragraph","text":"Знакомый, нежный и глубокий,"},{"type":"paragraph","text":"Взгляд персиянки черноокой."},{"type":"paragraph","text":"Но он встречал, бродя вокруг,"},{"type":"paragraph","text":"Одни косые взгляды слуг."},{"type":"paragraph","text":"И он бежал в своей тревоге"},{"type":"paragraph","text":"Опять к вершинам снеговым,"},{"type":"paragraph","text":"Где гор уступы и пороги"},{"type":"paragraph","text":"Закрыты облаком седым,"},{"type":"paragraph","text":"Где изо льда в скале отвесной,"},{"type":"paragraph","text":"Какой-то силою чудесной,"},{"type":"paragraph","text":"Как страсть души его кипуч,"},{"type":"paragraph","text":"Дымясь, горячий падал ключ."},{"type":"paragraph","text":"Блуждал Али, отшельник новый,"},{"type":"paragraph","text":"В горах Осетии суровой,"},{"type":"paragraph","text":"Стараясь с диким кабаном"},{"type":"paragraph","text":"Забыться боем, точно сном."},{"type":"paragraph","text":"Но вот опять в неволе страстной"},{"type":"paragraph","text":"Али спустился в тихий дол…"},{"type":"paragraph","text":"С вершины гор летит орел"},{"type":"paragraph","text":"Из тучи хмурой и ненастной."},{"type":"paragraph","text":"Веселой Шемахи пред ним"},{"type":"paragraph","text":"Пестреют кровли и мечети,"},{"type":"paragraph","text":"Белея, вьется легкий дым,"},{"type":"paragraph","text":"Горит луна на минарете,"},{"type":"paragraph","text":"И древний храм Джума-Джами"},{"type":"paragraph","text":"Свой красный купол подымает"},{"type":"paragraph","text":"К лазури ясной, где витает"},{"type":"paragraph","text":"Аллах, царящий над людьми."},{"type":"paragraph","text":"В кофейне шумного базара,"},{"type":"paragraph","text":"Где хуржи, шерсть и шелк-сырец,"},{"type":"paragraph","text":"Али услышал сазандара, —"},{"type":"paragraph","text":"То, верно, пришлый был певец."},{"type":"paragraph","text":"В тюрбане черном, бил он хмуро"},{"type":"paragraph","text":"По струнам медного сантура."},{"type":"paragraph","text":"Звучала медь, и голос пел"},{"type":"paragraph","text":"Про дальний край, скорбей удел:"},{"type":"paragraph","text":"Спит род людской,"},{"type":"paragraph","text":"Утех рабы,"},{"type":"paragraph","text":"Но их покой"},{"type":"paragraph","text":"В руках судьбы!"},{"type":"paragraph","text":"Разрушен дом,"},{"type":"paragraph","text":"Очаг погас…"},{"type":"paragraph","text":"Ударит гром,"},{"type":"paragraph","text":"Настанет час!"},{"type":"paragraph","text":"Я видел край…"},{"type":"paragraph","text":"Богат был он."},{"type":"paragraph","text":"Цветущий рай"},{"type":"paragraph","text":"Опустошен."},{"type":"paragraph","text":"От городов"},{"type":"paragraph","text":"В нем нет следа,"},{"type":"paragraph","text":"Среди песков"},{"type":"paragraph","text":"Над ним вода."},{"type":"paragraph","text":"Был страха полн"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Его конец."},{"type":"paragraph","text":"Там мертвых волн"},{"type":"paragraph","text":"Блестит свинец."},{"type":"paragraph","text":"Там жизни нет,"},{"type":"paragraph","text":"Земля нага,"},{"type":"paragraph","text":"Кровавый свет"},{"type":"paragraph","text":"На берега"},{"type":"paragraph","text":"Лишь зори льют,"},{"type":"paragraph","text":"Горя огнем…"},{"type":"paragraph","text":"Рок злобный лют, —"},{"type":"paragraph","text":"Погибель в нем!"},{"type":"paragraph","text":"— «Постой, шаир! Напев хорош,"},{"type":"paragraph","text":"Но илляги** ты нам поешь!»"},{"type":"paragraph","text":"Али окликнул сазандара:"},{"type":"paragraph","text":"— «Вот золото. Потешив нас,"},{"type":"paragraph","text":"Спой про любовь и про Эльмаз!»"},{"type":"paragraph","text":"Певец его не принял дара,"},{"type":"paragraph","text":"Усмешкой злой ответил он"},{"type":"paragraph","text":"И в дверь, нагнувшись, вышел вон."},{"type":"paragraph","text":"Бродя по площади базара,"},{"type":"paragraph","text":"Али вдоль лавок проходил."},{"type":"paragraph","text":"Там всюду торг кипучий был."},{"type":"paragraph","text":"Поджавши ноги, персияне"},{"type":"paragraph","text":"Сидели, развернув ковер."},{"type":"paragraph","text":"Пестрели вышивки и ткани."},{"type":"paragraph","text":"Над сочной зеленью шатер"},{"type":"paragraph","text":"Навес раскинул полосатый."},{"type":"paragraph","text":"Набор оружия богатый"},{"type":"paragraph","text":"Грузин расхваливал, крича,"},{"type":"paragraph","text":"И брил цирюльник всех сплеча."},{"type":"paragraph","text":"Верблюды, шли, арбы скрипели…"},{"type":"paragraph","text":"И вдруг… да, точно, в самом деле,"},{"type":"paragraph","text":"Там Сальфу увидал Али."},{"type":"paragraph","text":"Минув смущенного абрека,"},{"type":"paragraph","text":"Толпою шемаханки шли"},{"type":"paragraph","text":"Вдоль улиц в бани Рустембека."},{"type":"paragraph","text":"Канун был Пятницы. Оне,"},{"type":"paragraph","text":"Храня завет по старине,"},{"type":"paragraph","text":"На омовение спешили."},{"type":"paragraph","text":"Но бани Рустембека были"},{"type":"paragraph","text":"Для них приманкою иной:"},{"type":"paragraph","text":"Шумя одеждою цветной,"},{"type":"paragraph","text":"В нарядах пышных, под чадрою,"},{"type":"paragraph","text":"Как в гости, шли они порою"},{"type":"paragraph","text":"Среди завистливых подруг"},{"type":"paragraph","text":"Блеснуть запястьем, ожерельем,"},{"type":"paragraph","text":"И шемаханок резвый круг"},{"type":"paragraph","text":"Сверкал там смехом и весельем."},{"type":"paragraph","text":"Улыбки, шепот, взгляд косой…"},{"type":"paragraph","text":"Краса прелестная, нагая"},{"type":"paragraph","text":"С нарядной спорила красой."},{"type":"paragraph","text":"И шли служанки, предлагая"},{"type":"paragraph","text":"Сластей и лакомств дастархан,"},{"type":"paragraph","text":"Душистый кофе и кальян."},{"type":"paragraph","text":"Среди увешенных коврами"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Глубоких ниш роскошных бань,"},{"type":"paragraph","text":"Под расписными куполами"},{"type":"paragraph","text":"Там отдавали кейфу дань."},{"type":"paragraph","text":"Сверкая, бил фонтан студеный,"},{"type":"paragraph","text":"Воды горячей брызгал ток,"},{"type":"paragraph","text":"И Шемахи живой цветок"},{"type":"paragraph","text":"Склонялся, влагой окропленный."},{"type":"paragraph","text":"И плеск, и смех… лукавый взор,"},{"type":"paragraph","text":"Движенья лени, неги томной,"},{"type":"paragraph","text":"И шемаханки разговор,"},{"type":"paragraph","text":"Подчас свободный и нескромный."},{"type":"paragraph","text":"Увидев Сальфу, тихо к ней"},{"type":"paragraph","text":"Али приблизился с поклоном."},{"type":"paragraph","text":"Он взором пылким и влюбленным"},{"type":"paragraph","text":"О страсти говорил своей."},{"type":"paragraph","text":"— «Чего желаешь ты?» — украдкой"},{"type":"paragraph","text":"Спросила шепотом она."},{"type":"paragraph","text":"— «Моя душа тобой полна! —"},{"type":"paragraph","text":"Ответил он. — Минутой краткой"},{"type":"paragraph","text":"Меня, как счастьем, подари!"},{"type":"paragraph","text":"Ты — розы цвет, ты — луч зари!"},{"type":"paragraph","text":"Ах, Сальфа, Сальфа, ты прекрасна!"},{"type":"paragraph","text":"Дай мне открыть перед тобой,"},{"type":"paragraph","text":"Как долго мучусь, как напрасно."},{"type":"paragraph","text":"Два слова лишь!..»"},{"type":"paragraph","text":"Его мольбой"},{"type":"paragraph","text":"Она, казалося, смутилась."},{"type":"paragraph","text":"В ней сердце гордое забилось…"},{"type":"paragraph","text":"Но говорить ей здесь нельзя."},{"type":"paragraph","text":"— «Сегодня пир в моем серале —"},{"type":"paragraph","text":"Она ответила, скользя. —"},{"type":"paragraph","text":"Поведать мне свои печали"},{"type":"paragraph","text":"Приди, пожалуй… Тесный круг"},{"type":"paragraph","text":"Моих сестер, моих подруг"},{"type":"paragraph","text":"Не выдаст краткой нашей встречи."},{"type":"paragraph","text":"Твои я выслушаю речи"},{"type":"paragraph","text":"Ко мне в сераль, лишь день зайдет,"},{"type":"paragraph","text":"Старуха гостя проведет!»"},{"type":"paragraph","text":"Она ушла, мелькнув чадрою."},{"type":"paragraph","text":"То было лаской ли, игрою"},{"type":"paragraph","text":"Причуды женской, но Али"},{"type":"paragraph","text":"Надежды страстные смутили."},{"type":"paragraph","text":"Они звали, они манили,"},{"type":"paragraph","text":"Они в душе его цвели"},{"type":"paragraph","text":"И рай пленительный сулили, —"},{"type":"paragraph","text":"Небесный сон в мечтах земли."},{"type":"paragraph","text":"Но скоро ль вечер? Время длится…"},{"type":"paragraph","text":"Чтоб ожиданье скоротать,"},{"type":"paragraph","text":"В горах Али, как ветер, мчится,"},{"type":"paragraph","text":"Спешит минуты перегнать."},{"type":"paragraph","text":"Вскочив на холм, летит опять…"},{"type":"paragraph","text":"Зачем же солнце не садится?"},{"type":"paragraph","text":"Зачем в горах не веет тьмой"},{"type":"paragraph","text":"И полдень, душный и немой,"},{"type":"paragraph","text":"Вечерней тенью не затмится?"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"День тих, застыл небес предел"},{"type":"paragraph","text":"Среди сияющей лазури, —"},{"type":"paragraph","text":"Как будто мир окаменел"},{"type":"paragraph","text":"В предчувствии беды и бури."},{"type":"paragraph","text":"В долине гор, ясна, тиха,"},{"type":"paragraph","text":"Беспечно дремлет Шемаха."},{"type":"paragraph","text":"Вдруг гром подземный прокатился,"},{"type":"paragraph","text":"Тревожно вздрогнула земля,"},{"type":"paragraph","text":"Вершины гор, холмы, поля…"},{"type":"paragraph","text":"Удар на миг остановился"},{"type":"paragraph","text":"И вновь потряс и пошатнул"},{"type":"paragraph","text":"Окрестность всю… Громовый гул"},{"type":"paragraph","text":"Летел с земли, не с небосвода."},{"type":"paragraph","text":"В припадке судорог природа"},{"type":"paragraph","text":"Дрожала, воздымая грудь,"},{"type":"paragraph","text":"Как волны, изгибался путь,"},{"type":"paragraph","text":"Ходила почва под ногами,"},{"type":"paragraph","text":"Тяжеловесными громами"},{"type":"paragraph","text":"Подземный молот ударял"},{"type":"paragraph","text":"В основы гор, в подножья скал,"},{"type":"paragraph","text":"И сотрясенные долины,"},{"type":"paragraph","text":"И горной цепи исполины"},{"type":"paragraph","text":"Качались, трепета полны."},{"type":"paragraph","text":"Могучий гром из глубины"},{"type":"paragraph","text":"Звучал, как злобные стенанья."},{"type":"paragraph","text":"Как в день начальный первозданья,"},{"type":"paragraph","text":"Земная грудь дрожала вся."},{"type":"paragraph","text":"Седой покров земли рвался,"},{"type":"paragraph","text":"И сотрясалася утроба."},{"type":"paragraph","text":"В неистовстве ликует злоба."},{"type":"paragraph","text":"Гранит и камень одолев,"},{"type":"paragraph","text":"Разверзнув трещины по скатам,"},{"type":"paragraph","text":"Грозить хаосом вечный гнев,"},{"type":"paragraph","text":"И в мире, ужасом объятом,"},{"type":"paragraph","text":"Грохочет гром подземных бурь…"},{"type":"paragraph","text":"Одна безоблачна лазурь,"},{"type":"paragraph","text":"Лишь голубое небо ясно,"},{"type":"paragraph","text":"И безмятежно, и бесстрастно"},{"type":"paragraph","text":"Тысячелетия назад,"},{"type":"paragraph","text":"В глубокой древности когда-то"},{"type":"paragraph","text":"Вокруг вершины Арарата,"},{"type":"paragraph","text":"По склонам каменных громад"},{"type":"paragraph","text":"Потопа волны колебались"},{"type":"paragraph","text":"И, в пене злобной клокоча,"},{"type":"paragraph","text":"Его гранитного плеча"},{"type":"paragraph","text":"Седыми гребнями касались."},{"type":"paragraph","text":"Отсюда, с закавказских гор,"},{"type":"paragraph","text":"Туманный очерк Арарата"},{"type":"paragraph","text":"В дали угадывает взор."},{"type":"paragraph","text":"Земля окрестная богата"},{"type":"paragraph","text":"Преданьями великих бед,"},{"type":"paragraph","text":"Храня несчастий давний след."},{"type":"paragraph","text":"И вот опять судьба над нею"},{"type":"paragraph","text":"Свой подняла грозящий перст."},{"type":"paragraph","text":"Подземный хаос вновь отверст,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"Стихией властвуя своею,"},{"type":"paragraph","text":"И мечет пламя и пары"},{"type":"paragraph","text":"Из черных язв земной коры."},{"type":"paragraph","text":"С утесов голых и отвесных,"},{"type":"paragraph","text":"Спрыгнув с коня, смотрел Али,"},{"type":"paragraph","text":"Как Шемаха меж гор окрестных"},{"type":"paragraph","text":"Исчезла в прахе и пыли"},{"type":"paragraph","text":"При тяжком трепете земли."},{"type":"paragraph","text":"Обвалы вкруг него ползли,"},{"type":"paragraph","text":"Каменья прыгали по склонам,"},{"type":"paragraph","text":"Но долго взором воспаленным"},{"type":"paragraph","text":"Следил он сквозь туман и дым,"},{"type":"paragraph","text":"Как город гиб, и счастье с ним."},{"type":"paragraph","text":"Надежды рушились, как зданья,"},{"type":"paragraph","text":"Мелькали тени, очертанья,"},{"type":"paragraph","text":"И исчезал былого след."},{"type":"paragraph","text":"Во мгле развалины сквозили,"},{"type":"paragraph","text":"И вдруг, над облаками пыли,"},{"type":"paragraph","text":"Мечети рухнул минарет."},{"type":"paragraph","text":"На крыльях мчась над вихрем праха,"},{"type":"paragraph","text":"Его злой Эблис бросил, смял,"},{"type":"paragraph","text":"Как бы над благостью Аллаха"},{"type":"paragraph","text":"Мятежный дух торжествовал."},{"type":"paragraph","text":"Смятенье, ужас… Пали груды"},{"type":"paragraph","text":"Каменьев, щебня и земли."},{"type":"paragraph","text":"Смешались люди и верблюды"},{"type":"paragraph","text":"И, ослепленные, в пыли,"},{"type":"paragraph","text":"Бегут по трупам, по обвалам,"},{"type":"paragraph","text":"Вдоль улиц, в страхе одичалом."},{"type":"paragraph","text":"Прижав к груди ребенка, мать"},{"type":"paragraph","text":"другого силится поймать,"},{"type":"paragraph","text":"Но с треском рухнул дом соседний"},{"type":"paragraph","text":"Во двор, и на глазах у ней"},{"type":"paragraph","text":"Малютка скрыт дождем камней."},{"type":"paragraph","text":"Еще надеждою последней"},{"type":"paragraph","text":"Пустая площадь всех манит."},{"type":"paragraph","text":"Сюда народ, толпясь, бежит"},{"type":"paragraph","text":"И, сбившись в кучу, полный страха,"},{"type":"paragraph","text":"Взывает к помощи Аллаха."},{"type":"paragraph","text":"Но он врата для бед отверз…"},{"type":"paragraph","text":"Все гибнет, — женщины и дети,"},{"type":"paragraph","text":"Былинки жизни в юном свете,"},{"type":"paragraph","text":"И на базаре жадный перс,"},{"type":"paragraph","text":"Спасавший золото и ткани."},{"type":"paragraph","text":"Повсюду воплей и рыданий"},{"type":"paragraph","text":"Над Шемахой поднялся стон, —"},{"type":"paragraph","text":"Предсмертный крик со всех сторон."},{"type":"paragraph","text":"Обломки кровель, балки зданий"},{"type":"paragraph","text":"Нагромоздились, и кругом"},{"type":"paragraph","text":"За домом падал новый дом."},{"type":"paragraph","text":"Где Шемаха, очей отрада,"},{"type":"paragraph","text":"Любви и роскоши приют?"},{"type":"paragraph","text":"Развалин каменных громада"},{"type":"paragraph","text":"Одна лежит во прахе тут."},{"type":"paragraph","text":"Над ней в безумии снуют"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"Тоской измученные люди,"},{"type":"paragraph","text":"Родных и близких в пыльной груде"},{"type":"paragraph","text":"Найти стараясь, к небесам"},{"type":"paragraph","text":"Напрасно руки подымая."},{"type":"paragraph","text":"Но безответна смерть немая"},{"type":"paragraph","text":"К призывным крикам, голосам…"},{"type":"paragraph","text":"И вдруг, в последнее мгновенье,"},{"type":"paragraph","text":"Среди тревоги разрушенья,"},{"type":"paragraph","text":"Подняв высоко пламень свой,"},{"type":"paragraph","text":"Столб колыхнулся огневой."},{"type":"paragraph","text":"Огнем мгновенного пожара"},{"type":"paragraph","text":"Объяты улицы базара,"},{"type":"paragraph","text":"И дым на площадь повалил,"},{"type":"paragraph","text":"Неся удушье, чад и пыл."},{"type":"paragraph","text":"О, Шемаха! Бедой твоею"},{"type":"paragraph","text":"Мир целый будет потрясен."},{"type":"paragraph","text":"Переживет в тревоге он"},{"type":"paragraph","text":"Твоих несчастий эпопею."},{"type":"paragraph","text":"Твой скорбный крик достиг сердец,"},{"type":"paragraph","text":"Твоя погибель, твой конец"},{"type":"paragraph","text":"Невольно слезы вызывают."},{"type":"paragraph","text":"Невзгоды смертного карают,"},{"type":"paragraph","text":"Но ты погибла без вины,"},{"type":"paragraph","text":"Твои несчастные сыны"},{"type":"paragraph","text":"Греха безмерного не знают."},{"type":"paragraph","text":"По воле рока входит зло,"},{"type":"paragraph","text":"Настал твой час, — оно пришло…"},{"type":"paragraph","text":"И мы когда-нибудь чредою"},{"type":"paragraph","text":"С такой же встретимся бедою,"},{"type":"paragraph","text":"И непонятной, и слепой…"},{"type":"paragraph","text":"Лишь благом скуден мир скупой."},{"type":"paragraph","text":"Но кто, тревожен и печален,"},{"type":"paragraph","text":"Сошел с коня среди развалин?"},{"type":"paragraph","text":"В безумном бешенстве Али"},{"type":"paragraph","text":"Кинжалом роет прах земли, —"},{"type":"paragraph","text":"Напрасный труд для человека!"},{"type":"paragraph","text":"Не здесь ли бани Рустембека,"},{"type":"paragraph","text":"Где сорока персидских жен"},{"type":"paragraph","text":"Живой цветник был погребен?"},{"type":"paragraph","text":"Быть может, Сальфу ищет он?"},{"type":"paragraph","text":"Но где она, его отрада?"},{"type":"paragraph","text":"Каменьев пыльная громада"},{"type":"paragraph","text":"Лежит гробницей перед ним:"},{"type":"paragraph","text":"Обломок арки, своды ниши,"},{"type":"paragraph","text":"Земля осыпавшейся крыши…"},{"type":"paragraph","text":"К провалам темным и глухим"},{"type":"paragraph","text":"Приник Али склоненным ухом."},{"type":"paragraph","text":"Он ловит стон тревожным слухом,"},{"type":"paragraph","text":"Но все молчит в могильной тьме."},{"type":"paragraph","text":"И вот огнем в его уме"},{"type":"paragraph","text":"Надежда вспыхнула живая."},{"type":"paragraph","text":"Он вспомнил: Сальфа, призывая,"},{"type":"paragraph","text":"Сказала про вечерний пир…"},{"type":"paragraph","text":"Пусть всюду смерть, пусть гибнет мир,"},{"type":"paragraph","text":"Она одна спаслась, быть может,"}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Вернувшись во время домой?"},{"type":"paragraph","text":"Печаль о ней его тревожит,"},{"type":"paragraph","text":"Даря мечты, пугая тьмой."},{"type":"paragraph","text":"Вот Сальфы дом… Ее в серале"},{"type":"paragraph","text":"Вокруг стола подруги ждали."},{"type":"paragraph","text":"Теперь обрушилась стена,"},{"type":"paragraph","text":"Ограды каменные пали,"},{"type":"paragraph","text":"И дома внутренность видна."},{"type":"paragraph","text":"Кругом разбитые кувшины,"},{"type":"paragraph","text":"Упали чаши на ковер…"},{"type":"paragraph","text":"Великолепные руины"},{"type":"paragraph","text":"Еще хранят былой убор."},{"type":"paragraph","text":"Цветные стекла, арабески"},{"type":"paragraph","text":"И купол темно-голубой, —"},{"type":"paragraph","text":"Все говорит о прежнем блеске,"},{"type":"paragraph","text":"Теперь разрушенном судьбой."},{"type":"paragraph","text":"Беспечность, нега расцветали"},{"type":"paragraph","text":"В очаровательном серале,"},{"type":"paragraph","text":"Но светлый пир прекрасных жен"},{"type":"paragraph","text":"Бедой нежданной был смущен."},{"type":"paragraph","text":"Внезапно рухнули стропила,"},{"type":"paragraph","text":"Шатаясь, покосился дом,"},{"type":"paragraph","text":"В его простенке расписном"},{"type":"paragraph","text":"Широко трещина сквозила…"},{"type":"paragraph","text":"Смотрел безумно Али-бек"},{"type":"paragraph","text":"На эту сцену разрушенья."},{"type":"paragraph","text":"Как годы, шли пред ним мгновенья,"},{"type":"paragraph","text":"Сплетаясь в скорбный, длинный век;"},{"type":"paragraph","text":"Переживал в нем человек"},{"type":"paragraph","text":"Все горе, что изжить возможно,"},{"type":"paragraph","text":"И сердце билося тревожно,"},{"type":"paragraph","text":"И грудь его, как грудь земли,"},{"type":"paragraph","text":"В порыве гневном колебалась."},{"type":"paragraph","text":"Чего желать еще осталось,"},{"type":"paragraph","text":"На что надеяться Али?"},{"type":"paragraph","text":"Объятый страхом, непокорный,"},{"type":"paragraph","text":"Узды не слыша и удил,"},{"type":"paragraph","text":"Привычный конь тропинкой горной"},{"type":"paragraph","text":"Али в ущелья уносил."},{"type":"paragraph","text":"В снегах торчал кустарник дикий,"},{"type":"paragraph","text":"Снег на кустарнике нагом,"},{"type":"paragraph","text":"И неподвижности великой"},{"type":"paragraph","text":"Немая тишь была кругом."},{"type":"paragraph","text":"В тумане сизом потонула"},{"type":"paragraph","text":"Скалистой бездны глубина…"},{"type":"paragraph","text":"Но вдруг, полна громов и гула,"},{"type":"paragraph","text":"Окрестность гор потрясена."},{"type":"paragraph","text":"Едва Али над горном склоном"},{"type":"paragraph","text":"Сдержал пугливого коня…"},{"type":"paragraph","text":"Пред ним, в провале опаленном,"},{"type":"paragraph","text":"Рвался столб дыма и огня."},{"type":"paragraph","text":"Глубоко трещина зияла,"},{"type":"paragraph","text":"И в пасти черного провала"},{"type":"paragraph","text":"Гремящий пламень клокотал,"},{"type":"paragraph","text":"И пар, клубясь, по гребням скал"}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"Тянулся облаком летучим"},{"type":"paragraph","text":"И уходил к нависшим тучам."},{"type":"paragraph","text":"И вот, пред дрогнувшим Али,"},{"type":"paragraph","text":"Громаден, страшен, беспределен,"},{"type":"paragraph","text":"Пылавший образ из земли"},{"type":"paragraph","text":"Поднялся в глубине расселин,"},{"type":"paragraph","text":"Пред ним все гибло, что жило…"},{"type":"paragraph","text":"Из отверзавшегося зева"},{"type":"paragraph","text":"Он встал, как ненависть, как зло***,"},{"type":"paragraph","text":"И пламя бешеного гнева"},{"type":"paragraph","text":"Палило грозное чело."},{"type":"paragraph","text":"Как медь, звучащего напева"},{"type":"paragraph","text":"Громовый голос услыхал"},{"type":"paragraph","text":"Али среди дрожавших скал."},{"type":"paragraph","text":"Спит род людской,"},{"type":"paragraph","text":"Утех рабы,"},{"type":"paragraph","text":"Но их покой"},{"type":"paragraph","text":"В руках судьбы."},{"type":"paragraph","text":"Разрушен дом,"},{"type":"paragraph","text":"Очаг погас,"},{"type":"paragraph","text":"Ударил гром,"},{"type":"paragraph","text":"Настал их час!"},{"type":"paragraph","text":"Глаза Али огнем сверкнули:"},{"type":"paragraph","text":"— «Постой, я узнаю тебя!"},{"type":"paragraph","text":"В моем краю, в родном ауле,"},{"type":"paragraph","text":"Предстал ты, радости губя."},{"type":"paragraph","text":"Ты — враг! Ты в мирную обитель"},{"type":"paragraph","text":"Принес несчастья и беду,"},{"type":"paragraph","text":"Но есть у Сальфы верный мститель…"},{"type":"paragraph","text":"Кто б ни был ты, тебя найду!» —"},{"type":"paragraph","text":"Сверкая шашкою грозящей, —"},{"type":"paragraph","text":"Суровый взор, безумный вид, —"},{"type":"paragraph","text":"На призрак пламенный летит"},{"type":"paragraph","text":"Али к расселине дымящей."},{"type":"paragraph","text":"Пред ним, клубясь, взвился огонь,"},{"type":"paragraph","text":"Пары багровой тучей встали…"},{"type":"paragraph","text":"И гибнет всадник, гибнет конь,"},{"type":"paragraph","text":"Пропав в зияющем провале."},{"type":"paragraph","text":"Лишь тяжкий гул по гребням скал"},{"type":"paragraph","text":"Летит к ущельям отдаленным…"},{"type":"paragraph","text":"Вулкан открывшийся пылал,"},{"type":"paragraph","text":"Гремя над краем потрясенным."},{"type":"paragraph","text":"Но злу и смерти не дано"},{"type":"paragraph","text":"Торжествовать над жизнью вечно."},{"type":"paragraph","text":"Погибшее — оживлено,"},{"type":"paragraph","text":"В земле росток дает зерно…"},{"type":"paragraph","text":"Опять свободно и беспечно"},{"type":"paragraph","text":"Среди развалин Шемахи"},{"type":"paragraph","text":"Кипит торговля, бродят люди,"},{"type":"paragraph","text":"Шатров раскинуты верхи"},{"type":"paragraph","text":"Среди камней, на пыльной груде."},{"type":"paragraph","text":"Пестреют вьюки на верблюде,"},{"type":"paragraph","text":"Горит костер, и вновь живет,"},{"type":"paragraph","text":"Хлопочет, лавки открывая,"},{"type":"paragraph","text":"Назад вернувшийся народ,"}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"И суета кипит живая"},{"type":"paragraph","text":"Над свежей насыпью могил."},{"type":"paragraph","text":"Воскреснет город, оживая,"},{"type":"paragraph","text":"Он будет там же, где и был."},{"type":"paragraph","text":"Но Сальфы милой образ нежный"},{"type":"paragraph","text":"Не воскресить… ее одной —"},{"type":"paragraph","text":"В краю, где персик белоснежный"},{"type":"paragraph","text":"Цветет душистою весной."},{"type":"paragraph","text":"______________"},{"type":"paragraph","text":"* Наряд современной персиянки в гареме."},{"type":"paragraph","text":"** Илляги — духовные песни магометан о суете мира. Шаир, сазандар — странствующие певцы."},{"type":"paragraph","text":"*** Мусульмане Шемахи пламя Маразинского вулкана приняли за огненное видение. Автор пользуется местной легендой."}]}]}