{"id":"parnakh-samum","slug":"parnakh-samum","title":"Самум","altTitles":[],"author":"Валентин Яковлевич Парнах","authorShort":"В. Я. Парнах","authorSlug":"parnakh","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1919","editionYear":"1919","description":"=== Валентин Парнах. Самум === Холод","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A1%D0%B0%D0%BC%D1%83%D0%BC_%28%D0%9F%D0%B0%D1%80%D0%BD%D0%B0%D1%85%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1919)","downloadAllowed":true,"fb2Url":"/archive/books/parnakh/parnakh-samum/original.fb2","coverUrl":"/archive/books/parnakh/parnakh-samum/cover.webp","stats":{"chaptersCount":12,"wordsCount":2862,"charsCount":18263,"readingMinutes":16},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"},{"id":"chapter-9","title":"Часть 9"},{"id":"chapter-10","title":"Часть 10"},{"id":"chapter-11","title":"Часть 11"},{"id":"chapter-12","title":"Часть 12"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Валентин Парнах. Самум Холод"},{"type":"paragraph","text":"Желанный холод гулких плит,"},{"type":"paragraph","text":"Зал, где шаги бьют, как удары,"},{"type":"paragraph","text":"Все тело дико веселит."},{"type":"paragraph","text":"Руки раскинуты и яры."},{"type":"paragraph","text":"Вот где не помнить, не дрожать!"},{"type":"paragraph","text":"Лишь быть с камнями жадно слитым"},{"type":"paragraph","text":"И сердце бережно прижать"},{"type":"paragraph","text":"К спасительно холодным плитам!"},{"type":"paragraph","text":"И мнится: путь непоправим,"},{"type":"paragraph","text":"И эта боль неудержима."},{"type":"paragraph","text":"И тело ждет — крестом живым"},{"type":"paragraph","text":"Упасть, простершись недвижимо."},{"type":"paragraph","text":"1912 г."},{"type":"paragraph","text":"Рестораны"},{"type":"paragraph","text":"Рестораны"},{"type":"paragraph","text":"О. Мандельштаму."},{"type":"paragraph","text":"Играют в этот век двадцатый"},{"type":"paragraph","text":"Все рестораны, как один."},{"type":"paragraph","text":"Единой музыки раскаты"},{"type":"paragraph","text":"Ласкают европейский сплин!"},{"type":"paragraph","text":"Гремят в столице и в деревне"},{"type":"paragraph","text":"Кафе, таверны и харчевни."},{"type":"paragraph","text":"Как будто лопнул струнный клок,"},{"type":"paragraph","text":"Треск резкий и смычков наскок!"},{"type":"paragraph","text":"Вот взрывы несуразных нот"},{"type":"paragraph","text":"И грубых труб водоворот,"},{"type":"paragraph","text":"Как барабанит ветер мелкий,"},{"type":"paragraph","text":"Как хлещут медные тарелки!"},{"type":"paragraph","text":"И дикой музыки поклонники,"},{"type":"paragraph","text":"Под оглушительным дождем,"},{"type":"paragraph","text":"Мы стука струн, потуг гармоники,"},{"type":"paragraph","text":"Как заколдованные, ждем!.."},{"type":"paragraph","text":"Взволнованные вихрем общим,"},{"type":"paragraph","text":"Мы мечемся и глухо ропщем."},{"type":"paragraph","text":"Восстаний дух-свободолюб"},{"type":"paragraph","text":"Страстней любви и ярых губ!.."},{"type":"paragraph","text":"Опять с веленьями монаршими"},{"type":"paragraph","text":"Придут бессмысленные беды."},{"type":"paragraph","text":"Как встарь, стремительными маршами"},{"type":"paragraph","text":"В полях прославятся победы…"},{"type":"paragraph","text":"И если душу успокоить"},{"type":"paragraph","text":"Мне запах розы, стих, роман, —"},{"type":"paragraph","text":"Все язвы, все смятенье вскроет"},{"type":"paragraph","text":"Многоязычный ресторан!"},{"type":"paragraph","text":"1914"},{"type":"paragraph","text":"O"},{"type":"paragraph","text":"Пальмам Палестины"},{"type":"paragraph","text":"I."},{"type":"paragraph","text":"Торжественный и безупречный стан"},{"type":"paragraph","text":"И пальмовые, вечные вершины"},{"type":"paragraph","text":"Напомнили красавиц новых стран,"},{"type":"paragraph","text":"Высоко дышащие плечи, спины."},{"type":"paragraph","text":"И присужденная мне роком страсть"},{"type":"paragraph","text":"Царила и цвела в далеких пальмах."}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"О перед ней мне будет дивно пасть,"},{"type":"paragraph","text":"Томясь вздыманьем плеч в зеленых тальмах!"},{"type":"paragraph","text":"1915"},{"type":"paragraph","text":"II."},{"type":"paragraph","text":"Как древний рай был этот небосклон."},{"type":"paragraph","text":"Прах роз пылал в дыму закатной лавы."},{"type":"paragraph","text":"Глухая меланхолия и трон"},{"type":"paragraph","text":"Высокой безнадежности и славы."},{"type":"paragraph","text":"И там, где тихо проходил феллах,"},{"type":"paragraph","text":"Где, мнилось, все вдали благоухало,"},{"type":"paragraph","text":"Покачивались мерно на стволах"},{"type":"paragraph","text":"Тяжёлые густые опахала."},{"type":"paragraph","text":"1915-1916"},{"type":"paragraph","text":"Псалм"},{"type":"paragraph","text":"Под ивой, у водного лона,"},{"type":"paragraph","text":"Арабы дышали широко."},{"type":"paragraph","text":"Как будто у рек Вавилона,"},{"type":"paragraph","text":"Сидел я, во власти зарока."},{"type":"paragraph","text":"«У рек Вавилонских…» всех песен"},{"type":"paragraph","text":"Страшнее великий псалом:"},{"type":"paragraph","text":"«На ивы киноры повесим,"},{"type":"paragraph","text":"О нет, мы врагам не поем!»"},{"type":"paragraph","text":"Но мне нет ни сна, ни расплаты,"},{"type":"paragraph","text":"Лишь пытка и траурный бред,"},{"type":"paragraph","text":"И подвиг, и жребий проклятый —"},{"type":"paragraph","text":"Я пел для врагов! Славы нет!"},{"type":"paragraph","text":"В веках, под звездой небосклона,"},{"type":"paragraph","text":"Нас сушит событий сирокко,"},{"type":"paragraph","text":"И будто у рек Вавилона,"},{"type":"paragraph","text":"Я брошен, предатель зарока!"},{"type":"paragraph","text":"Баальбек."},{"type":"paragraph","text":"1914-1915"},{"type":"paragraph","text":"Дорога у Антиливана"},{"type":"paragraph","text":"Иссушенные скалы Сирии —"},{"type":"paragraph","text":"Как меланхолии закал."},{"type":"paragraph","text":"С самим собою в перемирии,"},{"type":"paragraph","text":"Я лишь движения искал!"},{"type":"paragraph","text":"Вот в шляпе вихрь звенит соломой!"},{"type":"paragraph","text":"Я в ветер ринулся один."},{"type":"paragraph","text":"Вот со смятеньем незнакомый,"},{"type":"paragraph","text":"Победно скачет бедуин."},{"type":"paragraph","text":"Верблюжьих кож змея тугая,"},{"type":"paragraph","text":"На голове лежит агаль."},{"type":"paragraph","text":"И я, тугой, свой труд слагая,"},{"type":"paragraph","text":"Я движусь! мне судьбы не жаль!.."},{"type":"paragraph","text":"За Храмом Солнца, где в безлюдии"},{"type":"paragraph","text":"Копытный перебой звенел,"},{"type":"paragraph","text":"Я, музык и веков орудие,"},{"type":"paragraph","text":"Пред новой казнью дико пел!"},{"type":"paragraph","text":"1914."},{"type":"paragraph","text":"Мировой кафешантан"},{"type":"paragraph","text":"Прославлен музыкой всех стран"},{"type":"paragraph","text":"В лихом веселии притонов,"},{"type":"paragraph","text":"В изнеможенье труб и стонов,"},{"type":"paragraph","text":"Рок, низведенный в балаган!"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"Провинция! В кафешантане"},{"type":"paragraph","text":"Поет актриса в легкой ткани."},{"type":"paragraph","text":"Вот барабанов гулкий взрыв"},{"type":"paragraph","text":"И занавеса быстрый взвив,"},{"type":"paragraph","text":"И голос, — чёрт, вином согретый, —"},{"type":"paragraph","text":"Выпаливает враз куплеты…"},{"type":"paragraph","text":"И за городом петь и гикать"},{"type":"paragraph","text":"Привыкли томные цыганы,"},{"type":"paragraph","text":"Как бы стремясь беду накликать"},{"type":"paragraph","text":"И насылая ураганы."},{"type":"paragraph","text":"И оглашают южный мрак"},{"type":"paragraph","text":"Оркестры проклятого пира,"},{"type":"paragraph","text":"Когда сияет порт и сад,"},{"type":"paragraph","text":"И средь восторженных клоак,"},{"type":"paragraph","text":"В ночи Стамбула и Каира,"},{"type":"paragraph","text":"Непоправимое забыть я рад!"},{"type":"paragraph","text":"Так в «Мариэттах» непристойных,"},{"type":"paragraph","text":"В налетах Танго и Фурлан,"},{"type":"paragraph","text":"В напевах легких и разбойных"},{"type":"paragraph","text":"Вдруг слышен рок и ураган!"},{"type":"paragraph","text":"1915"},{"type":"paragraph","text":"Восточной песней душу одурманивать,"},{"type":"paragraph","text":"В тот миг не помнить ничего другого,"},{"type":"paragraph","text":"В ночную музыку себя заманивать"},{"type":"paragraph","text":"И радостно ловить гортанный говор!"},{"type":"paragraph","text":"Через века, цвета все те же знойные"},{"type":"paragraph","text":"И томный круг — блистательные зубы,"},{"type":"paragraph","text":"Вздыманья рук все те же беспокойные,"},{"type":"paragraph","text":"Профиль царей, рот яростный и грубый."},{"type":"paragraph","text":"О с бубенцами, цитрами, цимбалами"},{"type":"paragraph","text":"Как мечутся и цокают цыганы,"},{"type":"paragraph","text":"Ббах! с гулами унывными, удалыми"},{"type":"paragraph","text":"Грохочут в Петербурге барабаны!"},{"type":"paragraph","text":"Как прерывают стоном в нос и систрами"},{"type":"paragraph","text":"Свои напевы женщины Дамаска,"},{"type":"paragraph","text":"Обрушивают вихрь зурнами быстрыми,"},{"type":"paragraph","text":"И бьется живота тугая пляска!"},{"type":"paragraph","text":"Протяжный клик, волшебное раздолие!"},{"type":"paragraph","text":"Дрожи, запястье! развевайтесь, шали!"},{"type":"paragraph","text":"Цыганок и арабов меланхолия,"},{"type":"paragraph","text":"О, Саломея, мы тобой дышали!"},{"type":"paragraph","text":"1915"},{"type":"paragraph","text":"Открой ворота, Ливан"},{"type":"paragraph","text":"Пророк Захария, гл. XI."},{"type":"paragraph","text":"Открой ворота, Ливан!"},{"type":"paragraph","text":"Пусть кедры пожрет огонь."},{"type":"paragraph","text":"Рыдай, кипарис — Славы нет!"},{"type":"paragraph","text":"Рыдайте, Вассанские дебри!"},{"type":"paragraph","text":"Ты слышишь: пастух вопит."},{"type":"paragraph","text":"Цвет диких кочевий погиб."},{"type":"paragraph","text":"Вот рыкает лев, юный лев!"},{"type":"paragraph","text":"Конец красоте Иордана!"},{"type":"paragraph","text":"Баальбек, 1914 г."},{"type":"paragraph","text":"Таганрог"},{"type":"paragraph","text":"Мой сон — закаты, гавань Таганрога,"}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Дух корабельных смол,"},{"type":"paragraph","text":"Холмы, маяк, веселая дорога"},{"type":"paragraph","text":"И одинокий мол."},{"type":"paragraph","text":"О пароходы греков и фелуки,"},{"type":"paragraph","text":"И старых бухт приют,"},{"type":"paragraph","text":"Где враз сирены портовой разлуки,"},{"type":"paragraph","text":"Как вопли строф, поют!"},{"type":"paragraph","text":"Часы среди друзей, прогулки в лодке,"},{"type":"paragraph","text":"Сады, прохладный дом —"},{"type":"paragraph","text":"Лишь отдых неожиданный, короткий"},{"type":"paragraph","text":"В безумии моем."},{"type":"paragraph","text":"1914 г."},{"type":"paragraph","text":"В. Мейерхольду"},{"type":"paragraph","text":"Кафе, театры, цирки, трубы"},{"type":"paragraph","text":"Мне были хуже пытки яростной,"},{"type":"paragraph","text":"И взлет смычков блаженно-грубый"},{"type":"paragraph","text":"Меня пьянил, как ветер парусный!"},{"type":"paragraph","text":"Рок! твой губительный приказ"},{"type":"paragraph","text":"Был «невозможно» и «на место»,"},{"type":"paragraph","text":"Но я собой был каждый раз,"},{"type":"paragraph","text":"Как слушал ужасы оркестра!"},{"type":"paragraph","text":"О, пусть ход действия поруган,"},{"type":"paragraph","text":"Пусть тягостно веков наследие, —"},{"type":"paragraph","text":"Присуждено мне по заслугам"},{"type":"paragraph","text":"Великолепие Трагедии."},{"type":"paragraph","text":"Я с детства, трубы, слышал весть"},{"type":"paragraph","text":"Всех пыток, роковую славу,"},{"type":"paragraph","text":"И все готовый перенесть,"},{"type":"paragraph","text":"Я силы получил по праву,"},{"type":"paragraph","text":"1915 г."},{"type":"paragraph","text":"Перед оркестром Hyde Park, London."},{"type":"paragraph","text":"Аравитянки иль индуски"},{"type":"paragraph","text":"О смуглые цвета,"},{"type":"paragraph","text":"Лица родимый очерк узкий"},{"type":"paragraph","text":"И дикие уста!"},{"type":"paragraph","text":"Легчайших кружев плеск, белея,"},{"type":"paragraph","text":"К её руке приник."},{"type":"paragraph","text":"Ей нежно открывает шею"},{"type":"paragraph","text":"Кастильский воротник."},{"type":"paragraph","text":"Вот ночью черной и веселой,"},{"type":"paragraph","text":"На вековом молу"},{"type":"paragraph","text":"Она стоит перед гондолой,"},{"type":"paragraph","text":"Чтоб долго плыть во мглу."},{"type":"paragraph","text":"Венеция и бред Востока,"},{"type":"paragraph","text":"И музык древний час"},{"type":"paragraph","text":"Исторгли жадно и жестоко"},{"type":"paragraph","text":"Мой стон по Вас!"},{"type":"paragraph","text":"Цирк"},{"type":"paragraph","text":"В. Н. Клепининой"},{"type":"paragraph","text":"Прищелкивает гулкий бич."},{"type":"paragraph","text":"Мелькает клоунский салоп."},{"type":"paragraph","text":"Директор! пусть хрипит твой клич:"},{"type":"paragraph","text":"Allez! poussez! ввух! гоп!"},{"type":"paragraph","text":"И на седле неся наездницу,"},{"type":"paragraph","text":"Врывается в ограду лошадь,"}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"И через скамьи, через лестницу,"},{"type":"paragraph","text":"Как мяч, перелетает ноша."},{"type":"paragraph","text":"— Ах, поднимая плечи статные,"},{"type":"paragraph","text":"Танцует с шалями креолка,"},{"type":"paragraph","text":"Являя радости развратные"},{"type":"paragraph","text":"И стройность ног под сенью шелка."},{"type":"paragraph","text":"— Трапеция ждет. Зов трубы!"},{"type":"paragraph","text":"Канат скрипуч, упруг, непрочен."},{"type":"paragraph","text":"Лошадь! взвейся на дыбы!"},{"type":"paragraph","text":"Довольно клоунских пощечин."},{"type":"paragraph","text":"— Все тело выгибать и скрючивать"},{"type":"paragraph","text":"Змеей, пружиною, веревкой,"},{"type":"paragraph","text":"И бешеный полет разучивать"},{"type":"paragraph","text":"Под жесточайшей дрессировкой."},{"type":"paragraph","text":"— Так, вам, невольники проклятые,"},{"type":"paragraph","text":"Уроды, хамы и тираны,"},{"type":"paragraph","text":"Готовить жалкою расплатою"},{"type":"paragraph","text":"Смертельных, ярых строф тараны!"},{"type":"paragraph","text":"Поэзия, как пытка, ждет."},{"type":"paragraph","text":"Стих начинен, пьян и отточен."},{"type":"paragraph","text":"Марши! бейте бурный лёт!"},{"type":"paragraph","text":"Довольно рока и пощечин!"},{"type":"paragraph","text":"Презревший вас, смиренье, плач,"},{"type":"paragraph","text":"Под казнью, днями и ночами,"},{"type":"paragraph","text":"Я, окруженный палачами, —"},{"type":"paragraph","text":"И сам себе палач."},{"type":"paragraph","text":"Пьяней от пыток и задач,"},{"type":"paragraph","text":"Пой, оглушай себя, как бич,"},{"type":"paragraph","text":"Ринь сонмы инфернальных стоп!"},{"type":"paragraph","text":"Носитель страсти и палач!"},{"type":"paragraph","text":"О нет, себя мне не постичь!.."},{"type":"paragraph","text":"Allez, poussez, ввух, гоп!"},{"type":"paragraph","text":"1915 г."},{"type":"paragraph","text":"Дифирамб"},{"type":"paragraph","text":"Музыка разверзлась величаво,"},{"type":"paragraph","text":"Полная, как целостный орган."},{"type":"paragraph","text":"Лава,"},{"type":"paragraph","text":"Катись! Океан, Океан!"},{"type":"paragraph","text":"Смычки вступили в новый строй."},{"type":"paragraph","text":"Восторг безумного наскока —"},{"type":"paragraph","text":"И стон. И явлен, как герой,"},{"type":"paragraph","text":"Оркестр Трагического Рока."},{"type":"paragraph","text":"И дикий сонм неслыханных гармоний"},{"type":"paragraph","text":"Бил страстию невероятных нот,"},{"type":"paragraph","text":"Являя мне средь казней, беззаконий,"},{"type":"paragraph","text":"Дух Музыки, единственный оплот."},{"type":"paragraph","text":"Ты отвечал напрасному прибою,"},{"type":"paragraph","text":"Гром напряженный в бешеной трубе."},{"type":"paragraph","text":"О музыка, я заглушу тобою"},{"type":"paragraph","text":"Смертельное презрение к себе!"},{"type":"paragraph","text":"Кинжал не вырван из ножон."},{"type":"paragraph","text":"Страсть далека, волненье ложно."},{"type":"paragraph","text":"Мой подвиг, ты несовершен."},{"type":"paragraph","text":"Великолепье невозможно !"},{"type":"paragraph","text":"Музыка разверзлась величаво,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"Полная, как целостный орган."},{"type":"paragraph","text":"Слава"},{"type":"paragraph","text":"Тебе, Океан, Океан!"},{"type":"paragraph","text":"1916 г."},{"type":"paragraph","text":"Рассказ подвергнутого гипнозу"},{"type":"paragraph","text":"Не выхвачу я, собственный палач,"},{"type":"paragraph","text":"Проклятых дум, как острия заноз."},{"type":"paragraph","text":"Меня лечить берется старый врач."},{"type":"paragraph","text":"И я хочу, чтоб победил гипноз!"},{"type":"paragraph","text":"Мои усилья знать племен и лет пути,"},{"type":"paragraph","text":"Презрение к бесстыдству государств,"},{"type":"paragraph","text":"Алканье славного — смогу ль свести"},{"type":"paragraph","text":"К леченью мозга и его мытарств?"},{"type":"paragraph","text":"Я в медный шар вперяю мертвый взгляд."},{"type":"paragraph","text":"Деревенеют веки тяжких глаз."},{"type":"paragraph","text":"Я стыну, я не обернусь назад."},{"type":"paragraph","text":"И вот над ухом раздается бас!"},{"type":"paragraph","text":"Жду. По глазам проводит мне рукой"},{"type":"paragraph","text":"И говорит торжественный поляк."},{"type":"paragraph","text":"Слова внушения «апломб», «спокой»"},{"type":"paragraph","text":"Меня смешат и сотрясают мрак."},{"type":"paragraph","text":"Ах, больше я не случаю его."},{"type":"paragraph","text":"Глухую речь ирония казнит."},{"type":"paragraph","text":"Вот Слову, Форме снова торжество."},{"type":"paragraph","text":"Внушение — забавно! Врач забыт!"},{"type":"paragraph","text":"1914 г."},{"type":"paragraph","text":"Детство в Балаклаве"},{"type":"paragraph","text":"М. Ларионову"},{"type":"paragraph","text":"Туда приехал я в ночи, в июле."},{"type":"paragraph","text":"Пять лет я помнил бухт уклон."},{"type":"paragraph","text":"Морские ветры между гор не дули,"},{"type":"paragraph","text":"Когда я вышел на балкон."},{"type":"paragraph","text":"Слепящий фосфор волн и берег плоский."},{"type":"paragraph","text":"Кометы в небе молодом,"},{"type":"paragraph","text":"И длинный свет молочный с миноноски"},{"type":"paragraph","text":"Вливался в этот белый дом."},{"type":"paragraph","text":"Соленый дух живил острей, чем росы,"},{"type":"paragraph","text":"Чем аромат магнольных чаш,"},{"type":"paragraph","text":"И радостно на пристани матросы"},{"type":"paragraph","text":"Трубили мой любимый марш!"},{"type":"paragraph","text":"1913 г."},{"type":"paragraph","text":"Мой гроб ночной, моя бессонница!"},{"type":"paragraph","text":"Меня потряс цимбал удар,"},{"type":"paragraph","text":"И грянула за ставней конница"},{"type":"paragraph","text":"Громокипящий марш фанфар!"},{"type":"paragraph","text":"Загубленный удел мой, бренный"},{"type":"paragraph","text":"Путем химер шел в вечный бой."},{"type":"paragraph","text":"Пытал строй музыки военной"},{"type":"paragraph","text":"Алканьем славы неземной."},{"type":"paragraph","text":"Труб пасти глухо обличали,"},{"type":"paragraph","text":"И поднимались к небесам"},{"type":"paragraph","text":"Тысячелетние печали."},{"type":"paragraph","text":"И погребенный где то там"},{"type":"paragraph","text":"Лежал распластанный, отравленный,"},{"type":"paragraph","text":"Сухая мумия во льне,"}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"И безнадежно замуравленный"},{"type":"paragraph","text":"В этой стене!"},{"type":"paragraph","text":"1915-1918 гг."},{"type":"paragraph","text":"Неаполитанская набережная"},{"type":"paragraph","text":"Разбег вдоль моря, стройный мол,"},{"type":"paragraph","text":"О лет и плеск, и пальм победный ствол!"},{"type":"paragraph","text":"Пред вечером открылась дверь балкона."},{"type":"paragraph","text":"Соль напитала пирный ток прохлад."},{"type":"paragraph","text":"Обманчивый, на миг блаженный лад"},{"type":"paragraph","text":"Лелеял здесь береговое лоно."},{"type":"paragraph","text":"Морские камни были горячи."},{"type":"paragraph","text":"И лошади, пьянея, буйно ржали,"},{"type":"paragraph","text":"И шарфы развевались и дрожали."},{"type":"paragraph","text":"И бешеные щелкали бичи!"},{"type":"paragraph","text":"Плавно катились нежные коляски…"},{"type":"paragraph","text":"Краб, оранжад, кокосовый орех"},{"type":"paragraph","text":"Цвели в возке, желтевшем пышно. Пляски"},{"type":"paragraph","text":"Готовил заводной рояль. И смех —"},{"type":"paragraph","text":"На крейсере, на бале — дальней донны"},{"type":"paragraph","text":"Венчал тот вечер странный и лимонный!"},{"type":"paragraph","text":"1918 г."},{"type":"paragraph","text":"Валы морей, валы органа, вал"},{"type":"paragraph","text":"Огромного и стройного хорала"},{"type":"paragraph","text":"Гармониями стон свой покрывал,"},{"type":"paragraph","text":"Но новая волна их пожирала."},{"type":"paragraph","text":"И море, заключенное в орган,"},{"type":"paragraph","text":"Непримиримо напрягая гулы,"},{"type":"paragraph","text":"Уничтожало, с яростью акулы,"},{"type":"paragraph","text":"Свой собственный великий ураган."},{"type":"paragraph","text":"И строй оркестра, воплощаясь в тело"},{"type":"paragraph","text":"Стихоносителя, глухо губя,"},{"type":"paragraph","text":"Являл безумие его удела:"},{"type":"paragraph","text":"Живой противник самого себя!"},{"type":"paragraph","text":"1917 г."},{"type":"paragraph","text":"Парадоксальное стихотворение"},{"type":"paragraph","text":"Однообразие и душ, и тел!"},{"type":"paragraph","text":"Сцепленья и соблазны, и движенья."},{"type":"paragraph","text":"Пусть победитель ты, как захотел,"},{"type":"paragraph","text":"Взял все, что в нас язвит воображенье, —"},{"type":"paragraph","text":"Ах, те же радости из рода в род,"},{"type":"paragraph","text":"Все той же властью дорожат здесь люди."},{"type":"paragraph","text":"Сжимают стан, целуют шеи, груди"},{"type":"paragraph","text":"И обнажают дерзостно живот."},{"type":"paragraph","text":"Ночь страстная — того, кто бы погиб,"},{"type":"paragraph","text":"Спасает от терзающего бреда,"},{"type":"paragraph","text":"Объятия, какой-нибудь изгиб,"},{"type":"paragraph","text":"Еще одно бесстыдство — и победа."},{"type":"paragraph","text":"И каждому придет черед дрожать"},{"type":"paragraph","text":"И страсть преследовать во сне, в рассказе."},{"type":"paragraph","text":"Но все тебя лишь будут продолжать,"},{"type":"paragraph","text":"Одно из вековых однообразий!"},{"type":"paragraph","text":"1915 г."},{"type":"paragraph","text":"Потерянная музыка"},{"type":"paragraph","text":"Где музыка блаженств и похорон,"},{"type":"paragraph","text":"Победы глас, служений строй священный,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"Томленье лун и ужас тайн вселенной,"},{"type":"paragraph","text":"Где ваш напев, Египет, Вавилон?"},{"type":"paragraph","text":"Трагедии высокой гордый стон"},{"type":"paragraph","text":"Исторг движенье строф. Где хоров ноты,"},{"type":"paragraph","text":"Потрясшие Афинский небосклон ?"},{"type":"paragraph","text":"Что можем мы почуять? Повороты,"},{"type":"paragraph","text":"Узор гармоний, многосложный ход,"},{"type":"paragraph","text":"Победу творческой, святой заботы."},{"type":"paragraph","text":"И слышу я за тканью слов размеренной"},{"type":"paragraph","text":"Сопровождение погибших нот,"},{"type":"paragraph","text":"Дыханье музыки давно потерянной."},{"type":"paragraph","text":"Где ваш оплот, разлеты строф, гимн ярый?"},{"type":"paragraph","text":"Умолкли спутники широких од,"},{"type":"paragraph","text":"Лады и доли, флейты и кифары."},{"type":"paragraph","text":"Стих рыцарей! где лютни перебор?"},{"type":"paragraph","text":"Где мавританский строй, гортанный, чарый,"},{"type":"paragraph","text":"Щемящий, как Абенсерага взор?"},{"type":"paragraph","text":"Но невозвратной музыки узор,"},{"type":"paragraph","text":"Но тайна неизведанных гармоний,"},{"type":"paragraph","text":"За жизнию, как память благовоний,"},{"type":"paragraph","text":"Живет земной судьбе наперекор!"},{"type":"paragraph","text":"1918 г."},{"type":"paragraph","text":"Палермо"},{"type":"paragraph","text":"Сицилианцы в бархатных костюмах,"},{"type":"paragraph","text":"Сицилианки в мусульманских шалях,"},{"type":"paragraph","text":"Монахи-греки в тенях риз угрюмых,"},{"type":"paragraph","text":"Корабль на парусах в закатных далях!"},{"type":"paragraph","text":"Сменяясь, все молились здесь в мечети,"},{"type":"paragraph","text":"Арабы и отцы-иеремиты,"},{"type":"paragraph","text":"В горячем воздухе, в надменном свете"},{"type":"paragraph","text":"Боролись племена и были слиты."},{"type":"paragraph","text":"Да, я родной Тирренским славным водам"},{"type":"paragraph","text":"И фиолетовым палящим скалам,"},{"type":"paragraph","text":"Владыкам пальм, арабам-мореходам"},{"type":"paragraph","text":"И этим старцам гордым и усталым!"},{"type":"paragraph","text":"Мазурские болота"},{"type":"paragraph","text":"В однообразии жестоком сел"},{"type":"paragraph","text":"Метался полк, насилуя и грабя."},{"type":"paragraph","text":"И в дебри непомерные забрел."},{"type":"paragraph","text":"И дрогнули, разверзлись эти хляби…"},{"type":"paragraph","text":"О как внезапно первый шаг увяз!"},{"type":"paragraph","text":"Рванулись. — Глубже! — Вновь. — И нет опоры!"},{"type":"paragraph","text":"Себя губили сами. Каждый час"},{"type":"paragraph","text":"И каждый шаг им были приговоры."},{"type":"paragraph","text":"Есть ужас: вдруг почуять глубину!"},{"type":"paragraph","text":"Что ж! посланные роковым приказом"},{"type":"paragraph","text":"Монарха-идиота на войну,"},{"type":"paragraph","text":"Вы предавались ядрам и заразам!"},{"type":"paragraph","text":"А ныне отходили вы ко сну"},{"type":"paragraph","text":"Так медленно в тяжелые болота."},{"type":"paragraph","text":"И нагло-равнодушная зевота"},{"type":"paragraph","text":"Вас пожирала. Струнно мошкара"},{"type":"paragraph","text":"Над вами пела. С музыкою рота"},{"type":"paragraph","text":"Прошла вдали. И снова вечера."},{"type":"paragraph","text":"Здесь забывались отпуски и даты…"}]},{"id":"chapter-9","title":"Часть 9","content":[{"type":"paragraph","text":"И бешено барахтались солдаты."},{"type":"paragraph","text":"С немолчным воплем руки простирал"},{"type":"paragraph","text":"Их сонм. Но дико стыл простор косматый."},{"type":"paragraph","text":"И стонов необузданный хорал"},{"type":"paragraph","text":"Он заглушал и медленно карал!"},{"type":"paragraph","text":"И если простодушный шел на зов,"},{"type":"paragraph","text":"На многодневный гул в лесах единый, —"},{"type":"paragraph","text":"Спасать товарищей он был готов."},{"type":"paragraph","text":"Цеплявшихся тянул он из трясины."},{"type":"paragraph","text":"Но сам? Уже скользит его нога."},{"type":"paragraph","text":"Он оттолкнет ударом сапога…"},{"type":"paragraph","text":"Так отбиваться в этот час звериный"},{"type":"paragraph","text":"От бреда, прокажённого, врага,"},{"type":"paragraph","text":"И каждое движенье было промах!"},{"type":"paragraph","text":"Спасаемый вернее погибал."},{"type":"paragraph","text":"И бился тяжело невольный бал,"},{"type":"paragraph","text":"Собранье несуразных насекомых!"},{"type":"paragraph","text":"1918 г."},{"type":"paragraph","text":"Пальма и павлины"},{"type":"paragraph","text":"(К византийско-арабской мозаике дворца Zisa, близ Палермо)"},{"type":"paragraph","text":"Павлины распустили веера."},{"type":"paragraph","text":"Из рыжей тьмы мерцали два павлина,"},{"type":"paragraph","text":"Лиловороссыпи, медь, вечера."},{"type":"paragraph","text":"Пальмы меж них вознесся ствол. Вершина"},{"type":"paragraph","text":"Открылась им. Зеленая звезда,"},{"type":"paragraph","text":"Цвел семилистник матово-усталый."},{"type":"paragraph","text":"Мерцания бряцали, как цимбалы,"},{"type":"paragraph","text":"Но, Тахозэр, ты не сошла сюда!"},{"type":"paragraph","text":"1918"},{"type":"paragraph","text":"Смерчи и Самумы"},{"type":"paragraph","text":"Так, Юга всепобедные бичи —"},{"type":"paragraph","text":"Ужаснее бурь Севера и льда."},{"type":"paragraph","text":"В избытке полдня, в огненной ночи,"},{"type":"paragraph","text":"Вы равны славе Солнца навсегда."},{"type":"paragraph","text":"Смерчи морей, сирокко и самумы,"},{"type":"paragraph","text":"О музыка крушения, орган"},{"type":"paragraph","text":"Величия, гул непостижной думы!"},{"type":"paragraph","text":"У Лиссабона прянет Океан,"},{"type":"paragraph","text":"Кавказ и Индию покроют чумы."},{"type":"paragraph","text":"И яро разверзается вулкан —"},{"type":"paragraph","text":"И бьется хрип подземного безумия,"},{"type":"paragraph","text":"Восторг и клокотание Везувия!"},{"type":"paragraph","text":"Пальм меланхолия, полет напевный"},{"type":"paragraph","text":"Птиц и ночей!.. Один удар бича —"},{"type":"paragraph","text":"И сменится вся нега страстью гневной,"},{"type":"paragraph","text":"И мир замрет, свой дух едва влача."},{"type":"paragraph","text":"Так бей, Хамсин пятидесятидневный."},{"type":"paragraph","text":"И пожирай Египет, саранча!"},{"type":"paragraph","text":"Но есть могучее и дивней пир, —"},{"type":"paragraph","text":"Поэзия, твой беспощадный ад,"},{"type":"paragraph","text":"В котором я лелею детство лир,"},{"type":"paragraph","text":"Улыбку уст, восторженный закат!"},{"type":"paragraph","text":"1918"},{"type":"paragraph","text":"Иов"},{"type":"paragraph","text":"I."}]},{"id":"chapter-10","title":"Часть 10","content":[{"type":"paragraph","text":"Во все дни свои мучит себя"},{"type":"paragraph","text":"Нечестивый. Звук ужасов —"},{"type":"paragraph","text":"В ушах его. Среди мира"},{"type":"paragraph","text":"Идет на него губитель."},{"type":"paragraph","text":"Он спастись не надеется."},{"type":"paragraph","text":"Видит Перед собою во мраке меч!"},{"type":"paragraph","text":"II."},{"type":"paragraph","text":"Я был спокоен, но Он"},{"type":"paragraph","text":"Потряс меня, жег меня, взял меня"},{"type":"paragraph","text":"Целью себе. Рассекает."},{"type":"paragraph","text":"Желчь мою пролил, пролом"},{"type":"paragraph","text":"Пробил во мне, бежит,"},{"type":"paragraph","text":"Бежит на меня Ратоборец."},{"type":"paragraph","text":"III."},{"type":"paragraph","text":"О если б ты, человек,"},{"type":"paragraph","text":"Мог иметь состязание с Богом,"},{"type":"paragraph","text":"Как сын человеческий с ближним своим!"},{"type":"paragraph","text":"IV."},{"type":"paragraph","text":"Преисподняя — дом мой."},{"type":"paragraph","text":"Во тьме Ложе мое постелю я. Гробу"},{"type":"paragraph","text":"Скажу: Ты отец мой, мой гроб!"},{"type":"paragraph","text":"V."},{"type":"paragraph","text":"Ярость гнева Его одождит"},{"type":"paragraph","text":"На тебя болезни. Все мрачное"},{"type":"paragraph","text":"Скрыто внутри тебя. Огнь,"},{"type":"paragraph","text":"Нераздуваем никем, пожирает твой разум!"},{"type":"paragraph","text":"1918."},{"type":"paragraph","text":"Веселый мим"},{"type":"paragraph","text":"Алкать движений не устану,"},{"type":"paragraph","text":"Мим прирожденный, лад и пляс."},{"type":"paragraph","text":"Волшебному кафешантану"},{"type":"paragraph","text":"Я предаюсь. Меня потряс"},{"type":"paragraph","text":"Причудливый One Step! Я пряну!"},{"type":"paragraph","text":"Веселия нежданный час!"},{"type":"paragraph","text":"Как стройно пальцами я щелкаю."},{"type":"paragraph","text":"Щелк нот меня заколебал."},{"type":"paragraph","text":"Я изогнусь иглою колкою."},{"type":"paragraph","text":"Я сам — оркестр и дрожь цимбал."},{"type":"paragraph","text":"И в теле, полном вожделенья"},{"type":"paragraph","text":"И пирной легкости пантер,"},{"type":"paragraph","text":"Душа под медленным давленьем"},{"type":"paragraph","text":"Невероятных атмосфер!"},{"type":"paragraph","text":"1915-1918"},{"type":"paragraph","text":"Внезапный танец"},{"type":"paragraph","text":"A Madeline Winstel"},{"type":"paragraph","text":"Темница радостных стихий,"},{"type":"paragraph","text":"Мое движенье! я ликую,"},{"type":"paragraph","text":"Я, как факир — змею лихую,"},{"type":"paragraph","text":"Взял нежно биллиардный кий."},{"type":"paragraph","text":"И мерой вкрадчивой, тугою"},{"type":"paragraph","text":"Шаг Танго начал вить узлом."},{"type":"paragraph","text":"Вращаю плавною дугою"},{"type":"paragraph","text":"Кий и — пленительный излом —"},{"type":"paragraph","text":"Под ногу провожу. Морские"},{"type":"paragraph","text":"Качанья, шага перебор!"}]},{"id":"chapter-11","title":"Часть 11","content":[{"type":"paragraph","text":"Преображен заклятьем кия,"},{"type":"paragraph","text":"Я вдруг нашел тройной узор,"},{"type":"paragraph","text":"Ночным веселиям подмостки"},{"type":"paragraph","text":"Открылись — биллиардный зал."},{"type":"paragraph","text":"Беспечный, невесомый, хлесткий,"},{"type":"paragraph","text":"Я перед смертию плясал!"},{"type":"paragraph","text":"Estranho primor"},{"type":"paragraph","text":"Н. С. Гончаровой."},{"type":"paragraph","text":"Смуглый твой лик в оправе тьмы и зноя."},{"type":"paragraph","text":"Бровь буквой «нун» легла над сонью ока."},{"type":"paragraph","text":"Лады вступления застыли, ноя."},{"type":"paragraph","text":"И музыка спит горько и глубоко."},{"type":"paragraph","text":"Бич цирковой, хлестаний лет тугой,"},{"type":"paragraph","text":"Мелькания и скрежеты навах —"},{"type":"paragraph","text":"Замкнул твой стан и укротил твой строй."},{"type":"paragraph","text":"И роза страстно стиснута в зубах."},{"type":"paragraph","text":"Исторгнута арабскими бряцаньями,"},{"type":"paragraph","text":"Чернь кружева, ты вышла из пучин."},{"type":"paragraph","text":"Заколка в волосах цветет мерцаньями."},{"type":"paragraph","text":"Атласов блеск — слепящий апельсин."},{"type":"paragraph","text":"Точеная, как пирная гондола,"},{"type":"paragraph","text":"Ты шею матовую опускала,"},{"type":"paragraph","text":"Ты шаль гвоздикой острой заколола,"},{"type":"paragraph","text":"Ты стройно распустила опахало."},{"type":"paragraph","text":"Двадцатый век и европейский бал"},{"type":"paragraph","text":"Явил тебя в восторге тьмы и таяньи"},{"type":"paragraph","text":"Парчи и шарфа. Важный плеск цимбал"},{"type":"paragraph","text":"И трепет арф обворожал отчаянье."},{"type":"paragraph","text":"И вырванный из ада стихофор,"},{"type":"paragraph","text":"Как ввергнутый в гармонию и сон,"},{"type":"paragraph","text":"В нее вперяет безнадежный взор."},{"type":"paragraph","text":"Весь разум, все лицо — единый стон."},{"type":"paragraph","text":"Ах, если я позор, Ваше обличье,"},{"type":"paragraph","text":"О странная, блистательная Донья,"},{"type":"paragraph","text":"Да будет мне бесспорное величье"},{"type":"paragraph","text":"И музыка, и мрак, и благовонье!"},{"type":"paragraph","text":"1918"},{"type":"paragraph","text":"Знак музыкантам"},{"type":"paragraph","text":"Бесстрастно я вошел в собрание,"},{"type":"paragraph","text":"Ночной самум и боль тая,"},{"type":"paragraph","text":"Но я торжествовал заранее"},{"type":"paragraph","text":"Близ вас, оркестры, казнь моя!"},{"type":"paragraph","text":"Изнемогая, страстно стыну."},{"type":"paragraph","text":"И музыкантам-палачам,"},{"type":"paragraph","text":"Смычкам, томительным бичам,"},{"type":"paragraph","text":"Всему оркестру-исполину"},{"type":"paragraph","text":"Знак роковой начать я дам!"},{"type":"paragraph","text":"1918"},{"type":"paragraph","text":"Александру Блоку"},{"type":"paragraph","text":"Избыток горечи вверг меня в сон."},{"type":"paragraph","text":"(На Средиземном море порт военный Стыл."},{"type":"paragraph","text":"Разум жгло похмелье похорон)."},{"type":"paragraph","text":"Днем родина приснилась мне геенной:"},{"type":"paragraph","text":"В темницу прежнюю я заточен."},{"type":"paragraph","text":"Средь виселиц вновь и навек я пленный."}]},{"id":"chapter-12","title":"Часть 12","content":[{"type":"paragraph","text":"И равны Африки и зною жаль"},{"type":"paragraph","text":"Мразы России и чамра вселенной!"},{"type":"paragraph","text":"Как будто кровь грузно течет из жил."},{"type":"paragraph","text":"И вечна скорбь, которой я бежал."},{"type":"paragraph","text":"И, малодушный, я не обнажил"},{"type":"paragraph","text":"С проклятием секера мой кинжал!"},{"type":"paragraph","text":"Но вечер, вздох, — и пробужденье. Лоно"},{"type":"paragraph","text":"Спасенья! Было странно: вновь я жил."},{"type":"paragraph","text":"Я вышел из дому, как из притона"},{"type":"paragraph","text":"Пыток. Дыхание мне сон обжег."},{"type":"paragraph","text":"Веки в огне загробного циклона."},{"type":"paragraph","text":"Но тем нежней строй пальмовых дорог."},{"type":"paragraph","text":"Но тем блаженней странность небосклона."},{"type":"paragraph","text":"Поклонник пальм, близ вас дышать я мог!"},{"type":"paragraph","text":"Палермо"},{"type":"paragraph","text":"Наталии Гончаровой."},{"type":"paragraph","text":"Под сводами огромного собора,"},{"type":"paragraph","text":"В темнице драгоценного органа,"},{"type":"paragraph","text":"Хор голосов протяжно пел хвалы."},{"type":"paragraph","text":"И бури полнозвучного напора"},{"type":"paragraph","text":"Приподнимали гулкие валы."},{"type":"paragraph","text":"И разверзались недра океана."},{"type":"paragraph","text":"Пять суток огневых вихрь от Сахар"},{"type":"paragraph","text":"Вторгался, опалял песчаной сушью"},{"type":"paragraph","text":"И оглушал, и предавал удушью,"},{"type":"paragraph","text":"Внезапным холодом сменяя жар!"},{"type":"paragraph","text":"Колючих скал и кактусов громада,"},{"type":"paragraph","text":"Блистательных Семитов падший трон,"},{"type":"paragraph","text":"Суровый, крайний Юг!.. Но ты, отрада,"},{"type":"paragraph","text":"Провеяла! Благоухал лимон."},{"type":"paragraph","text":"И ехали в колясках, полулежа,"},{"type":"paragraph","text":"Из улиц к морю, медленно, в закат,"},{"type":"paragraph","text":"Графини истомлённые, тревожа"},{"type":"paragraph","text":"Бред меланхолии. Восточный лад,"},{"type":"paragraph","text":"Глаз сарацинский! Древние загары"},{"type":"paragraph","text":"На пире смугло-матовом цвели."},{"type":"paragraph","text":"И море им открылось после кары,"},{"type":"paragraph","text":"И величаво стыли корабли…"},{"type":"paragraph","text":"Но горько преданный одной химере,"},{"type":"paragraph","text":"Я нес себе безжалостный закон."},{"type":"paragraph","text":"И было здесь отчаянье потери"},{"type":"paragraph","text":"Прав на гармонию. Тюремный сон!"},{"type":"paragraph","text":"Благоуханий и крушений слава,"},{"type":"paragraph","text":"Великолепья древняя основа,"},{"type":"paragraph","text":"Павлины мозаик и пальм сады!"},{"type":"paragraph","text":"Я весь был ярость грозного устава,"},{"type":"paragraph","text":"Я дал обет молчанья и вражды."},{"type":"paragraph","text":"И жгло, душило, как сирокко, Слово!"},{"type":"paragraph","text":"1918."},{"type":"paragraph","text":"Источник текста: Самум. Стихи. 3 рис. Наталии Гончаровой / Валентин Парнах. — Париж: impr. polyglotte N.L. Danzig, 1919. — 43 с., 3 л. ил.; 23 см."}]}]}