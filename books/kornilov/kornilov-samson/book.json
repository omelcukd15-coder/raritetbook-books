{"id":"kornilov-samson","slug":"kornilov-samson","title":"Самсон","altTitles":[],"author":"Борис Петрович Корнилов","authorShort":"Б. П. Корнилов","authorSlug":"kornilov","authorYears":"","translator":null,"language":"ru","category":"russian-classics","writtenYear":"1936","editionYear":"1936","description":"Библиотека Поэта. Большая серия. Второе издание","historicalNote":"Источник архива: az.lib.ru.","sourceUrl":"https://ru.wikisource.org/wiki/%D0%A1%D0%B0%D0%BC%D1%81%D0%BE%D0%BD_%28%D0%9A%D0%BE%D1%80%D0%BD%D0%B8%D0%BB%D0%BE%D0%B2%29","legalStatus":"Общественное достояние (ст. 1281, 1282 ГК РФ; PD-old; 1936)","downloadAllowed":true,"fb2Url":"/archive/books/kornilov/kornilov-samson/original.fb2","coverUrl":"/archive/books/kornilov/kornilov-samson/cover.webp","stats":{"chaptersCount":8,"wordsCount":1453,"charsCount":9235,"readingMinutes":8},"toc":[{"id":"chapter-1","title":"Часть 1"},{"id":"chapter-2","title":"Часть 2"},{"id":"chapter-3","title":"Часть 3"},{"id":"chapter-4","title":"Часть 4"},{"id":"chapter-5","title":"Часть 5"},{"id":"chapter-6","title":"Часть 6"},{"id":"chapter-7","title":"Часть 7"},{"id":"chapter-8","title":"Часть 8"}],"chapters":[{"id":"chapter-1","title":"Часть 1","content":[{"type":"paragraph","text":"Библиотека Поэта. Большая серия. Второе издание"},{"type":"paragraph","text":"М. —Л., «Советский писатель», 1966"},{"type":"paragraph","text":"150. САМСОН Мой герой поэмы этой, здравствуй!"},{"type":"paragraph","text":"По-татарски мрачен и скулат,"},{"type":"paragraph","text":"и широкоплеч,"},{"type":"paragraph","text":"и коренастый,"},{"type":"paragraph","text":"бескозырка,"},{"type":"paragraph","text":"брюки клеш,"},{"type":"paragraph","text":"бушлат."},{"type":"paragraph","text":"Выправкой красуясь образцовой,"},{"type":"paragraph","text":"молод,"},{"type":"paragraph","text":"неприветлив"},{"type":"paragraph","text":"и тяжел,"},{"type":"paragraph","text":"он по набережной"},{"type":"paragraph","text":"по Дворцовой"},{"type":"paragraph","text":"шатко, как по палубе, прошел."},{"type":"paragraph","text":"Этой белой ночью,"},{"type":"paragraph","text":"мимолетной,"},{"type":"paragraph","text":"летнею,"},{"type":"paragraph","text":"идет навстречу мне,"},{"type":"paragraph","text":"лентой опоясан пулеметной,"},{"type":"paragraph","text":"маузер,"},{"type":"paragraph","text":"гранаты на ремне."},{"type":"paragraph","text":"И глядит с особенным фасоном"},{"type":"paragraph","text":"глазом золотым"},{"type":"paragraph","text":"и полусонным,"},{"type":"paragraph","text":"как ему —"},{"type":"paragraph","text":"удобно на земле."},{"type":"paragraph","text":"Все его товарищи"},{"type":"paragraph","text":"Самсоном"},{"type":"paragraph","text":"звали на линейном корабле."},{"type":"paragraph","text":"Сколько дней голодных,"},{"type":"paragraph","text":"несчастливых,"},{"type":"paragraph","text":"сколько силы отдано труду…"},{"type":"paragraph","text":"И во флот"},{"type":"paragraph","text":"из волжских водоливов"},{"type":"paragraph","text":"он пришел в пятнадцатом году."},{"type":"paragraph","text":"Балтика —"},{"type":"paragraph","text":"она одна на свете"},{"type":"paragraph","text":"так же молчалива и сера,"},{"type":"paragraph","text":"как ее возлюбленные дети —"},{"type":"paragraph","text":"бронированные крейсера."},{"type":"paragraph","text":"Корабли"},{"type":"paragraph","text":"империи на благо,"},{"type":"paragraph","text":"верноподданные сторожа,"},{"type":"paragraph","text":"и кресты андреевского флага"},{"type":"paragraph","text":"пролетали, по ветру дрожа."},{"type":"paragraph","text":"Шла война дорогою прямою —"},{"type":"paragraph","text":"по смертоубийственным делам,"},{"type":"paragraph","text":"крейсера ходили"},{"type":"paragraph","text":"вдоль по морю,"},{"type":"paragraph","text":"разрезая воду пополам."},{"type":"paragraph","text":"И орудья поднимали жерла…"},{"type":"paragraph","text":"Шла война — всеобщая грызня.. \""},{"type":"paragraph","text":"В кубриках и мучилась и мерла"}]},{"id":"chapter-2","title":"Часть 2","content":[{"type":"paragraph","text":"вся в холщовой робе матросня;"},{"type":"paragraph","text":"в кочегарках запекалось горло,"},{"type":"paragraph","text":"никому не сладко на войне, —"},{"type":"paragraph","text":"так, что называется, приперло,"},{"type":"paragraph","text":"что приперло здорово к стене."},{"type":"paragraph","text":"Не солдату говорить про негу,"},{"type":"paragraph","text":"он привыкнет ко всему:"},{"type":"paragraph","text":"к огню,"},{"type":"paragraph","text":"на дожде, на холоде ночлегу"},{"type":"paragraph","text":"и к неприхотливому меню."},{"type":"paragraph","text":"Щи пустые,"},{"type":"paragraph","text":"ячневая каша,"},{"type":"paragraph","text":"это тоже надо понимать —"},{"type":"paragraph","text":"родина заботливая наша,"},{"type":"paragraph","text":"почему ты мачеха, не мать?"},{"type":"paragraph","text":"И страдали, умирая рядом,"},{"type":"paragraph","text":"разрешая тягостный вопрос,"},{"type":"paragraph","text":"ополченец третьего разряда,"},{"type":"paragraph","text":"доброволец,"},{"type":"paragraph","text":"кадровый,"},{"type":"paragraph","text":"матрос."},{"type":"paragraph","text":"И когда сказали: «Не желаем,"},{"type":"paragraph","text":"в двадцать лет себя не отдадим,"},{"type":"paragraph","text":"пусть Вильгельм воюет с Николаем,"},{"type":"paragraph","text":"чтобы так —"},{"type":"paragraph","text":"один и на один, —"},{"type":"paragraph","text":"рухнула империи опора;"},{"type":"paragraph","text":"нам война такая не резон…»"},{"type":"paragraph","text":"И назад ударила «Аврора»,"},{"type":"paragraph","text":"и Самсона с Балтики, минера,"},{"type":"paragraph","text":"называли попросту Самсон."},{"type":"paragraph","text":"Он узнал,"},{"type":"paragraph","text":"за что такое дрался;"},{"type":"paragraph","text":"он по палубе прошел, суров,"},{"type":"paragraph","text":"наконец-то все-таки добрался"},{"type":"paragraph","text":"до своих морских офицеров."},{"type":"paragraph","text":"И за мордобитье,"},{"type":"paragraph","text":"и за горе,"},{"type":"paragraph","text":"также за военные суды"},{"type":"paragraph","text":"и офицера хлебнули в море"},{"type":"paragraph","text":"той смертельной гадины-воды."},{"type":"paragraph","text":"Так ушли офицера на место."},{"type":"paragraph","text":"А Самсон припомнил про свое —"},{"type":"paragraph","text":"что на Волге у него невеста"},{"type":"paragraph","text":"и коса по пояс у нее,"},{"type":"paragraph","text":"ждет она."},{"type":"paragraph","text":"У белокурой Иры"},{"type":"paragraph","text":"и любви хватает и тоски,"},{"type":"paragraph","text":"письма шлет ему"},{"type":"paragraph","text":"и сувениры,"},{"type":"paragraph","text":"шлет махорку,"},{"type":"paragraph","text":"теплые носки…"},{"type":"paragraph","text":"Повидаться надобно с Ириной,"},{"type":"paragraph","text":"погулять пушистою травой —"},{"type":"paragraph","text":"милый,"}]},{"id":"chapter-3","title":"Часть 3","content":[{"type":"paragraph","text":"дорогой,"},{"type":"paragraph","text":"неповторимый"},{"type":"paragraph","text":"Волги левый берег,"},{"type":"paragraph","text":"луговой."},{"type":"paragraph","text":"Свадьба замечательная,"},{"type":"paragraph","text":"с плясом,"},{"type":"paragraph","text":"самогонки будет без конца…"},{"type":"paragraph","text":"Будут дети."},{"type":"paragraph","text":"Первенца Тарасом"},{"type":"paragraph","text":"назовут, в честь родного отца."},{"type":"paragraph","text":"Хорошо, товарищи, до дому,"},{"type":"paragraph","text":"прямо на домашние хлеба,"},{"type":"paragraph","text":"но судьба судила по-иному,"},{"type":"paragraph","text":"как любая темная судьба."},{"type":"paragraph","text":"Комиссар в защитном рваном френче,"},{"type":"paragraph","text":"умная,"},{"type":"paragraph","text":"большая голова,"},{"type":"paragraph","text":"говорил матросам о Юдениче, —"},{"type":"paragraph","text":"вот его дословные слова:"},{"type":"paragraph","text":"«Наступает царское отродье,"},{"type":"paragraph","text":"вашество,"},{"type":"paragraph","text":"высокоблагородье,"},{"type":"paragraph","text":"сила, гад…"},{"type":"paragraph","text":"Короче говоря,"},{"type":"paragraph","text":"коль не император будет —"},{"type":"paragraph","text":"вроде"},{"type":"paragraph","text":"этого российского царя."},{"type":"paragraph","text":"Вот когда настанет нам расплата,"},{"type":"paragraph","text":"уверяю вас,"},{"type":"paragraph","text":"на этот раз"},{"type":"paragraph","text":"он заместо нашего бушлата"},{"type":"paragraph","text":"снимет шкуру с каждого из нас."},{"type":"paragraph","text":"Нет уж…"},{"type":"paragraph","text":"что бы там ни говорили,"},{"type":"paragraph","text":"снова начинается война…"},{"type":"paragraph","text":"Браты,"},{"type":"paragraph","text":"если кашу заварили,"},{"type":"paragraph","text":"так пускай доварится она…»"},{"type":"paragraph","text":"Ничего на это не сказали"},{"type":"paragraph","text":"моряки."},{"type":"paragraph","text":"Вздохнули тяжело."},{"type":"paragraph","text":"Через час грузили на вокзале"},{"type":"paragraph","text":"боевой матросский эшелон."},{"type":"paragraph","text":"Повинуясь боевым приказам,"},{"type":"paragraph","text":"на перроне черная стена —"},{"type":"paragraph","text":"то матросы выстроились разом,"},{"type":"paragraph","text":"в дудки засвистели боцмана…"},{"type":"paragraph","text":"И под небом, сумрачным и голым,"},{"type":"paragraph","text":"с корабля,"},{"type":"paragraph","text":"пожалуй, через день"},{"type":"paragraph","text":"и Самсон"},{"type":"paragraph","text":"пошел правофланговым, —"},{"type":"paragraph","text":"бескозырка сбита набекрень,"},{"type":"paragraph","text":"вьются ленты черные с надрезом,"},{"type":"paragraph","text":"кораблей на лентах имена."}]},{"id":"chapter-4","title":"Часть 4","content":[{"type":"paragraph","text":"Шел Самсон Тарасович, —"},{"type":"paragraph","text":"железом"},{"type":"paragraph","text":"опоясала его война."},{"type":"paragraph","text":"А кругом братаны:"},{"type":"paragraph","text":"с «Ростислава»,"},{"type":"paragraph","text":"с «Князя Игоря»,"},{"type":"paragraph","text":"кругом бои,"},{"type":"paragraph","text":"и над каждым простирала слава"},{"type":"paragraph","text":"руки незабвенные свои."},{"type":"paragraph","text":"На привале в хуторе зеленом"},{"type":"paragraph","text":"их кормили жирным творогом,"},{"type":"paragraph","text":"их поили молоком топленым"},{"type":"paragraph","text":"и пеклись о госте дорогом."},{"type":"paragraph","text":"Тяжко было Ганнам и Аленам"},{"type":"paragraph","text":"вспоминать товарищей уход,"},{"type":"paragraph","text":"перешептывания под кленом,"},{"type":"paragraph","text":"девятьсот двадцатый этот год."},{"type":"paragraph","text":"Их видали люди в Первой Конной,"},{"type":"paragraph","text":"как они, в мерцанье и в пыли,"},{"type":"paragraph","text":"сомкнутой,"},{"type":"paragraph","text":"передовой колонной"},{"type":"paragraph","text":"в город занимаемый вошли."},{"type":"paragraph","text":"Их видали люди в поле чистом,"},{"type":"paragraph","text":"как летели, шашками звеня,"},{"type":"paragraph","text":"каждый был из них кавалеристом,"},{"type":"paragraph","text":"только с моря —"},{"type":"paragraph","text":"прямо на коня."},{"type":"paragraph","text":"Их погибло много."},{"type":"paragraph","text":"Я тоскую"},{"type":"paragraph","text":"о погибших в яростном бою"},{"type":"paragraph","text":"и ничем, пожалуй, не рискую,"},{"type":"paragraph","text":"если о погибели спою."},{"type":"paragraph","text":"Нарисуй мне большое слово,"},{"type":"paragraph","text":"как, опутанный со всех сторон,"},{"type":"paragraph","text":"окружен,"},{"type":"paragraph","text":"у города Ростова"},{"type":"paragraph","text":"в плен попался третий эскадрон."},{"type":"paragraph","text":"Все патроны были на исходе, —"},{"type":"paragraph","text":"ну, земля,"},{"type":"paragraph","text":"сынов благослови!"},{"type":"paragraph","text":"Только клеши,"},{"type":"paragraph","text":"по тогдашней моде"},{"type":"paragraph","text":"в пол-аршина шириной,"},{"type":"paragraph","text":"в крови."},{"type":"paragraph","text":"Белые…"},{"type":"paragraph","text":"В спасенье не поверив,"},{"type":"paragraph","text":"все бойцы прощаются любя,"},{"type":"paragraph","text":"и последней пулей Мишка Зверев"},{"type":"paragraph","text":"убивает самого себя."},{"type":"paragraph","text":"Милые…"},{"type":"paragraph","text":"Увидимся? Едва ли…"},{"type":"paragraph","text":"Но красиво прожили свой век,"},{"type":"paragraph","text":"отгуляли"},{"type":"paragraph","text":"и отвоевали…"},{"type":"paragraph","text":"В плен попало десять человек."}]},{"id":"chapter-5","title":"Часть 5","content":[{"type":"paragraph","text":"Двух из них прикончили."},{"type":"paragraph","text":"Расправа"},{"type":"paragraph","text":"штыковая…"},{"type":"paragraph","text":"На душе мороз."},{"type":"paragraph","text":"Остальных оставили:"},{"type":"paragraph","text":"— Направо,"},{"type":"paragraph","text":"шагом марш!.."},{"type":"paragraph","text":"В штабную, на допрос."},{"type":"paragraph","text":"А в штабной,"},{"type":"paragraph","text":"в большом поповском доме,"},{"type":"paragraph","text":"генерал угрюмый и седой,"},{"type":"paragraph","text":"адъютанты собрались в истоме"},{"type":"paragraph","text":"около поповны молодой."},{"type":"paragraph","text":"Песню пели голосом веселым"},{"type":"paragraph","text":"про «Аллаверды» и про бои,"},{"type":"paragraph","text":"огуречным вымыты рассолом"},{"type":"paragraph","text":"руки у дебелой попадьи."},{"type":"paragraph","text":"Местные помещики,"},{"type":"paragraph","text":"их жены,"},{"type":"paragraph","text":"жирно угощает попадья —"},{"type":"paragraph","text":"на столе"},{"type":"paragraph","text":"грибы и корнишоны,"},{"type":"paragraph","text":"самогона целая бадья."},{"type":"paragraph","text":"Выпьют"},{"type":"paragraph","text":"и закусывают снова"},{"type":"paragraph","text":"тельцем поросенка заливного"},{"type":"paragraph","text":"(на закуску всякая еда!),"},{"type":"paragraph","text":"и молоками,"},{"type":"paragraph","text":"и карасями,"},{"type":"paragraph","text":"жареными теплыми гусями,"},{"type":"paragraph","text":"квашеной капустою со льда…"},{"type":"paragraph","text":"Ходят за поповной молодою,"},{"type":"paragraph","text":"весело на пиршестве таком"},{"type":"paragraph","text":"пьют"},{"type":"paragraph","text":"и насыщаются едою,"},{"type":"paragraph","text":"руки моют ключевой водою,"},{"type":"paragraph","text":"губы утирают рушником."},{"type":"paragraph","text":"И когда всё съедено, допито,"},{"type":"paragraph","text":"чашка в честь хозяюшки разбита,"},{"type":"paragraph","text":"унесен последний каравай,"},{"type":"paragraph","text":"стол свободен,"},{"type":"paragraph","text":"генерал сердито"},{"type":"paragraph","text":"говорит:"},{"type":"paragraph","text":"«Конвойные, давай!.."},{"type":"paragraph","text":"Подавайте каждого матроса!..»"},{"type":"paragraph","text":"От еды обильной клонит в сон,"},{"type":"paragraph","text":"и ведут матросов для допроса,"},{"type":"paragraph","text":"впереди всей партии — Самсон."},{"type":"paragraph","text":"Он встает"},{"type":"paragraph","text":"и начинает сразу:"},{"type":"paragraph","text":"«Мы тебя, такую-то заразу,"},{"type":"paragraph","text":"вот увидишь, душу с тебя вон!"},{"type":"paragraph","text":"Мы умрем,"},{"type":"paragraph","text":"придут другие снова,"},{"type":"paragraph","text":"это — заключительное слово,"}]},{"id":"chapter-6","title":"Часть 6","content":[{"type":"paragraph","text":"род гадючий…»"},{"type":"paragraph","text":"И молчит Самсон."},{"type":"paragraph","text":"И стоит, дымясь и вырастая,"},{"type":"paragraph","text":"молодой и злобный, впереди,"},{"type":"paragraph","text":"по лицу струится кровь густая,"},{"type":"paragraph","text":"рваная тельняшка на груди, —"},{"type":"paragraph","text":"тут не до мольбы и не до пряток."},{"type":"paragraph","text":"Генерал поднялся голубой,"},{"type":"paragraph","text":"приговор и яростен и краток:"},{"type":"paragraph","text":"«Шомполами…"},{"type":"paragraph","text":"Сволочь…"},{"type":"paragraph","text":"На убой…»"},{"type":"paragraph","text":"Фонаря мерцающее пламя,"},{"type":"paragraph","text":"дух амбарный,"},{"type":"paragraph","text":"на дворе мороз,"},{"type":"paragraph","text":"и матросов били шомполами,"},{"type":"paragraph","text":"клочья мяса падали в навоз…"},{"type":"paragraph","text":"Этой ночью было наступленье"},{"type":"paragraph","text":"Красной Армии."},{"type":"paragraph","text":"И не совру,"},{"type":"paragraph","text":"коль скажу, что все-таки селенье"},{"type":"paragraph","text":"было всё очищено к утру."},{"type":"paragraph","text":"Выносили трупы из амбара,"},{"type":"paragraph","text":"трупы, связанные по рукам, —"},{"type":"paragraph","text":"два красноармейских комиссара"},{"type":"paragraph","text":"приложили руки к козырькам."},{"type":"paragraph","text":"На сырую землю положили,"},{"type":"paragraph","text":"встали, молчаливые, вокруг,"},{"type":"paragraph","text":"видели разорванные жилы,"},{"type":"paragraph","text":"но Самсон пошевелился вдруг,"},{"type":"paragraph","text":"застонал."},{"type":"paragraph","text":"Еще одно движенье —"},{"type":"paragraph","text":"поскрипел зубами, чуть дыша,"},{"type":"paragraph","text":"видимо, недаром при рожденье"},{"type":"paragraph","text":"назвали Самсоном малыша."},{"type":"paragraph","text":"В лазарете чистые палаты,"},{"type":"paragraph","text":"слышен птичий щебет со двора,"},{"type":"paragraph","text":"на сиделках белые халаты,"},{"type":"paragraph","text":"на осмотр приходят доктора."},{"type":"paragraph","text":"Их больные стонами встречают,"},{"type":"paragraph","text":"доктора смеются: «Ты живой…»"},{"type":"paragraph","text":"Подойдут к Самсону,"},{"type":"paragraph","text":"покачают,"},{"type":"paragraph","text":"каждый покачает головой."},{"type":"paragraph","text":"Но проходит всё на этом свете,"},{"type":"paragraph","text":"всё проходит, задушевный мой,"},{"type":"paragraph","text":"и Самсон полгода в лазарете"},{"type":"paragraph","text":"пролежал"},{"type":"paragraph","text":"и выписан домой…"},{"type":"paragraph","text":"Вот она,"},{"type":"paragraph","text":"река моя родная,"},{"type":"paragraph","text":"величава, широка она…"},{"type":"paragraph","text":"Правая — гористая,"},{"type":"paragraph","text":"лесная —"},{"type":"paragraph","text":"левая на Волге сторона."}]},{"id":"chapter-7","title":"Часть 7","content":[{"type":"paragraph","text":"До села еще версты четыре,"},{"type":"paragraph","text":"где Ирина,"},{"type":"paragraph","text":"дом его отца…"},{"type":"paragraph","text":"Хорошо идти на этом мире"},{"type":"paragraph","text":"только до какого-то конца."},{"type":"paragraph","text":"Только той знакомою дорогой,"},{"type":"paragraph","text":"радуясь, волнуясь и любя,"},{"type":"paragraph","text":"думая о той,"},{"type":"paragraph","text":"о босоногой,"},{"type":"paragraph","text":"что всего дороже для тебя."},{"type":"paragraph","text":"Как обнимет,"},{"type":"paragraph","text":"сразу приголубит…"},{"type":"paragraph","text":"Что ж — ромашку по пути сорвать,"},{"type":"paragraph","text":"погадать,"},{"type":"paragraph","text":"не любит или любит,"},{"type":"paragraph","text":"поцелует или наплевать?"},{"type":"paragraph","text":"Сколько всё же размышлений лишних!"},{"type":"paragraph","text":"Вот и дом,"},{"type":"paragraph","text":"и постучал Самсон"},{"type":"paragraph","text":"в столь знакомый"},{"type":"paragraph","text":"голубой наличник"},{"type":"paragraph","text":"и прогнал хозяйки теплый сон."},{"type":"paragraph","text":"Выглянула, ахнула —"},{"type":"paragraph","text":"тоскою"},{"type":"paragraph","text":"всё лицо"},{"type":"paragraph","text":"и горестью горит,"},{"type":"paragraph","text":"замахала теплою рукою:"},{"type":"paragraph","text":"«Ах, скорей, уйдите! — говорит. —"},{"type":"paragraph","text":"Ах, уйдите, — говорит, от окон, —"},{"type":"paragraph","text":"оглянулась:"},{"type":"paragraph","text":"в дометишина. —"},{"type":"paragraph","text":"Я теперь уже не одинока,"},{"type":"paragraph","text":"я теперь замужняя жена»."},{"type":"paragraph","text":"И пропала."},{"type":"paragraph","text":"Это всё знакомо —"},{"type":"paragraph","text":"бьется сердце,"},{"type":"paragraph","text":"застывает кровь,"},{"type":"paragraph","text":"если ты потерянный у дома,"},{"type":"paragraph","text":"где была огромная любовь."},{"type":"paragraph","text":"Много лет прошло."},{"type":"paragraph","text":"Уже стареем,"},{"type":"paragraph","text":"смотрим прямо и по сторонам,"},{"type":"paragraph","text":"бороды свои большие бреем,"},{"type":"paragraph","text":"чтоб казаться помоложе нам."},{"type":"paragraph","text":"Утро наступает золотое,"},{"type":"paragraph","text":"мы ему не говорим: «Уйди»,"},{"type":"paragraph","text":"вспоминая всё пережитое,"},{"type":"paragraph","text":"всё, что остается позади."},{"type":"paragraph","text":"Я проснулся."},{"type":"paragraph","text":"Дел сегодня разных"},{"type":"paragraph","text":"короба, пожалуй, полтора;"},{"type":"paragraph","text":"первое —"},{"type":"paragraph","text":"у нас сегодня праздник,"},{"type":"paragraph","text":"праздник начинается с утра."},{"type":"paragraph","text":"Сердце замирающее радо,"}]},{"id":"chapter-8","title":"Часть 8","content":[{"type":"paragraph","text":"кровью молодою зажжено —"},{"type":"paragraph","text":"гордость первомайского парада"},{"type":"paragraph","text":"чувствует заранее оно."},{"type":"paragraph","text":"Как несутся танки броневые,"},{"type":"paragraph","text":"самолеты в небесах гудят,"},{"type":"paragraph","text":"и знамена, как цветы живые,"},{"type":"paragraph","text":"на просторе пахнут и шумят."},{"type":"paragraph","text":"Гордость первомайского парада"},{"type":"paragraph","text":"радостной улыбкою цветет,"},{"type":"paragraph","text":"и кавалерийская бригада"},{"type":"paragraph","text":"на галопе площадью пройдет."},{"type":"paragraph","text":"Поздним вечером,"},{"type":"paragraph","text":"совсем бессонным"},{"type":"paragraph","text":"(в эту ночь, конечно, не до сна),"},{"type":"paragraph","text":"я нежданно встретился с Самсоном."},{"type":"paragraph","text":"Радость…"},{"type":"paragraph","text":"Удивление…"},{"type":"paragraph","text":"Весна…"},{"type":"paragraph","text":"Всё такой же, молодой и плотный, —"},{"type":"paragraph","text":"тела человечьего стена,"},{"type":"paragraph","text":"в голубой, красивой форме летной,"},{"type":"paragraph","text":"на груди сверкают ордена."},{"type":"paragraph","text":"Пели дети,"},{"type":"paragraph","text":"мы запели с ними,"},{"type":"paragraph","text":"и пошли, толкаясь и шутя…"},{"type":"paragraph","text":"«Истребителями скоростными"},{"type":"paragraph","text":"управляю я теперь, дитя»."},{"type":"paragraph","text":"И припомнил я года глухие"},{"type":"paragraph","text":"и подумал:"},{"type":"paragraph","text":"«Да, его не тронь, —"},{"type":"paragraph","text":"человек,"},{"type":"paragraph","text":"прошедший все стихии:"},{"type":"paragraph","text":"воду,"},{"type":"paragraph","text":"землю,"},{"type":"paragraph","text":"воздух"},{"type":"paragraph","text":"и огонь…»"},{"type":"paragraph","text":"Пили чай, смеялись и курили,"},{"type":"paragraph","text":"и тепло расплескано в крови."},{"type":"paragraph","text":"Обо всем в ту ночь мы говорили,"},{"type":"paragraph","text":"но не говорили"},{"type":"paragraph","text":"о любви."},{"type":"paragraph","text":"1936"},{"type":"paragraph","text":"Москва"},{"type":"paragraph","text":"ПРИМЕЧАНИЯ 150. «Смена», 1936, 30 июня. Печ. по журналу «Новый мир», 1936, № 7, с. 140."}]}]}